{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "git-submodules": {
    "enabled": true
  },

  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",

  "packageRules": [
    {
      "description": "rhoto-router is ours: no cooldown, mirroring client/pnpm-workspace.yaml",
      "matchPackageNames": ["rhoto-router"],
      "minimumReleaseAge": null
    }
  ]
}
