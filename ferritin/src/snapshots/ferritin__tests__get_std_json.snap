                          {
                            "text": " (specifically, only ",
                            "style": "Plain"
                          },
                          {
                            "text": "Box<T, Global>",
                            "style": "InlineCode"
                          },
                          {
                            "text": "), and",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "NonNull<T>",
                            "style": "InlineCode"
                          },
                          {
                            "text": " are all ABI-compatible with each other for all ",
                            "style": "Plain"
                          },
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": ". They are also ABI-compatible",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "with each other for ",
                            "style": "Plain"
                          },
