              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let bytes: [u8; 3] = [1, 0, 2];\nassert_eq!(1, u16::from_le_bytes(<[u8; 2]>::try_from(&bytes[0..2]).unwrap()));\nassert_eq!(512, u16::from_le_bytes(bytes[1..3].try_into().unwrap()));"
              },
