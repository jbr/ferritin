                            "text": " (Propagating, Reacting)",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The ",
                            "style": "Plain"
                          },
                          {
                            "text": "Error",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/error/index.html?search=core%3A%3Aerror%3A%3AError"
                          },
                          {
                            "text": " trait (Reporting)",
