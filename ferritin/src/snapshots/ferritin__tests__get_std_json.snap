                  {
                    "text": "once()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/iter/sources/once/fn.once.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
