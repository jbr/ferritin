                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "User defined types (Constructing / Representing)",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "match",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Ematch"
                          },
