                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This is useful any time that the compiler can't determine that some code is unreachable. For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example:",
                    "style": "Plain"
