                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// Pin something inside a `ManuallyDrop`. This is fine on its own.\nlet mut pin: Pin<Box<ManuallyDrop<Type>>> = Box::pin(ManuallyDrop::new(Type));\n\n// However, creating a pinning mutable reference to the type *inside*\n// the `ManuallyDrop` is not!\nlet inner: Pin<&mut Type> = unsafe {\n    Pin::map_unchecked_mut(pin.as_mut(), |x| &mut **x)\n};"
              },
