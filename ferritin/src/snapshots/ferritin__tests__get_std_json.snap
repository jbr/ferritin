                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If ",
                            "style": "Plain"
                          },
                          {
                            "text": "T1",
                            "style": "InlineCode"
                          },
                          {
                            "text": " and ",
