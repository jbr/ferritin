      {
        "path": "rc",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/alloc/rc/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Single-threaded reference-counting pointers. 'Rc' stands for 'Reference",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Counted'.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The type ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc<T>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " provides shared ownership of a value of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "allocated in the heap. Invoking ",
                    "style": "Plain"
                  },
                  {
                    "text": "clone",
                    "style": "InlineCode",
                    "url": "https://docs.rs/Clone/latest/Clone/index.html?search=Clone%3A%3Aclone"
                  },
                  {
                    "text": " on ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " produces a new",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointer to the same allocation in the heap. When the last ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " pointer to a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "given allocation is destroyed, the value stored in that allocation (often",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "referred to as \"inner value\") is also dropped.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Shared references in Rust disallow mutation by default, and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is no exception: you cannot generally obtain a mutable reference to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "something inside an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": ". If you need mutability, put a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Cell",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/cell/index.html?search=core%3A%3Acell%3A%3ACell"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "or ",
                    "style": "Plain"
                  },
                  {
                    "text": "RefCell",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/cell/index.html?search=core%3A%3Acell%3A%3ARefCell"
                  },
                  {
                    "text": " inside the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": "; see ",
                    "style": "Plain"
                  },
                  {
                    "text": "an example of mutability",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Acell"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Acell"
                  },
                  {
                    "text": "inside an ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Acell"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Acell"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " uses non-atomic reference counting. This means that overhead is very",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "low, but an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " cannot be sent between threads, and consequently ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "does not implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "Send",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/marker/index.html?search=core%3A%3Amarker%3A%3ASend"
                  },
                  {
                    "text": ". As a result, the Rust compiler",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "will check ",
                    "style": "Plain"
                  },
                  {
                    "text": "at compile time",
                    "style": "Emphasis"
                  },
                  {
                    "text": " that you are not sending ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/rc/struct.Rc.html"
                  },
                  {
                    "text": "s between",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "threads. If you need multi-threaded, atomic reference counting, use",
                    "style": "Plain"
