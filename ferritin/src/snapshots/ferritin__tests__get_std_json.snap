                    "text": "RangeFrom",
                    "style": "InlineCode"
                  },
                  {
                    "text": " types in a future edition.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use core::range::{Range, RangeFrom, RangeInclusive, RangeToInclusive};\n\nlet arr = [0, 1, 2, 3, 4];\nassert_eq!(arr[                        ..   ], [0, 1, 2, 3, 4]);\nassert_eq!(arr[                        .. 3 ], [0, 1, 2      ]);\nassert_eq!(arr[RangeToInclusive::from( ..=3)], [0, 1, 2, 3   ]);\nassert_eq!(arr[       RangeFrom::from(1..  )], [   1, 2, 3, 4]);\nassert_eq!(arr[           Range::from(1..3 )], [   1, 2      ]);\nassert_eq!(arr[  RangeInclusive::from(1..=3)], [   1, 2, 3   ]);"
              }
            ],
            "level": "SingleLine"
          }
        ]
