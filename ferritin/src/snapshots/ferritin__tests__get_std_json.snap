                            "url": "http://docs.rust-lang.org/nightly/std/thread/join_handle/struct.JoinHandle.html"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "By requesting the current thread, using the ",
