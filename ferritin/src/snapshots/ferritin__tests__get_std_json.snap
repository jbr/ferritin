              "text": "page for the module",
              "style": "Plain",
              "path": "core::char"
            },
            {
              "text": " ",
              "style": "Plain",
              "path": "core::char"
            },
            {
              "text": "std::char",
              "style": "InlineCode",
              "path": "core::char"
            },
            {
              "text": " that documents iterator and error types created by these methods",
