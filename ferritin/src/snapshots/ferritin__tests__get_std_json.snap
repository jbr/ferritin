              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn divide_by_three(x: u32) -> u32 { // one of the poorest implementations of x/3\n    for i in 0.. {\n        if 3*i < i { panic!(\"u32 overflow\"); }\n        if x < 3*i { return i-1; }\n    }\n    unreachable!(\"The loop should always return\");\n}"
              }
