      {
        "path": "vec",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A contiguous growable array type with heap-allocated contents, written",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Vectors have ",
                    "style": "Plain"
                  },
                  {
                    "text": "O",
                    "style": "Emphasis"
                  },
                  {
                    "text": "(1) indexing, amortized ",
                    "style": "Plain"
                  },
                  {
                    "text": "O",
                    "style": "Emphasis"
                  },
                  {
                    "text": "(1) push (to the end) and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "O",
                    "style": "Emphasis"
                  },
                  {
                    "text": "(1) pop (from the end).",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Vectors ensure they never allocate more than ",
                    "style": "Plain"
                  },
                  {
                    "text": "isize::MAX",
                    "style": "InlineCode"
                  },
                  {
                    "text": " bytes.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You can explicitly create a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html"
                  },
                  {
                    "text": " with ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec::new",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.new"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v: Vec<i32> = Vec::new();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "...or by using the ",
                    "style": "Plain"
                  },
                  {
                    "text": "vec!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/macro.vec.html"
                  },
                  {
                    "text": " macro:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v: Vec<i32> = vec![];\n\nlet v = vec![1, 2, 3, 4, 5];\n\nlet v = vec![0; 10]; // ten zeroes"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You can ",
                    "style": "Plain"
                  },
                  {
                    "text": "push",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.push"
                  },
                  {
                    "text": " values onto the end of a vector (which will grow the vector",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as needed):",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut v = vec![1, 2];\n\nv.push(3);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Popping values works in much the same way:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut v = vec![1, 2];\n\nlet two = v.pop();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Vectors also support indexing (through the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Index",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ops/index/index.html?search=core%3A%3Aops%3A%3Aindex%3A%3AIndex"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "IndexMut",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ops/index/index.html?search=core%3A%3Aops%3A%3Aindex%3A%3AIndexMut"
                  },
                  {
                    "text": " traits):",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut v = vec![1, 2, 3];\nlet three = v[2];\nv[1] = v[1] + 5;"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Memory layout",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When the type is non-zero-sized and the capacity is nonzero, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html"
                  },
                  {
                    "text": " uses the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Global",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/alloc/struct.Global.html"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "allocator for its allocation. It is valid to convert both ways between such a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html"
                  },
                  {
                    "text": " and a raw",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointer allocated with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Global",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/alloc/struct.Global.html"
                  },
                  {
                    "text": " allocator, provided that the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Layout",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/alloc/layout/index.html?search=core%3A%3Aalloc%3A%3Alayout%3A%3ALayout"
                  },
                  {
                    "text": " used with the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "allocator is correct for a sequence of ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "InlineCode"
                  },
                  {
                    "text": " elements of the type, and the first ",
                    "style": "Plain"
                  },
                  {
                    "text": "len",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "values pointed to by the raw pointer are valid. More precisely, a ",
                    "style": "Plain"
                  },
                  {
                    "text": "ptr: *mut T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " that has been",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "allocated with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Global",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/alloc/struct.Global.html"
                  },
                  {
                    "text": " allocator with ",
                    "style": "Plain"
                  },
                  {
                    "text": "Layout::array::<T>(capacity)",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/alloc/Layout/index.html?search=alloc%3A%3Aalloc%3A%3ALayout%3A%3Aarray"
                  },
                  {
                    "text": " may",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be converted into a vec using",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec::<T>::from_raw_parts(ptr, len, capacity)",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.from_raw_parts"
                  },
                  {
                    "text": ". Conversely, the memory",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "backing a ",
                    "style": "Plain"
                  },
                  {
                    "text": "value: *mut T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " obtained from ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec::<T>::as_mut_ptr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.as_mut_ptr"
                  },
                  {
                    "text": " may be deallocated using the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Global",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/alloc/struct.Global.html"
                  },
                  {
                    "text": " allocator with the same layout.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For zero-sized types (ZSTs), or when the capacity is zero, the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " pointer must be non-null",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and sufficiently aligned. The recommended way to build a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " of ZSTs if ",
                    "style": "Plain"
                  },
                  {
                    "text": "vec!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/macro.vec.html"
                  },
                  {
                    "text": " cannot be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "used is to use ",
                    "style": "Plain"
                  },
                  {
                    "text": "ptr::NonNull::dangling",
                    "style": "InlineCode",
                    "url": "https://docs.rs/NonNull/latest/NonNull/index.html?search=NonNull%3A%3Adangling"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
