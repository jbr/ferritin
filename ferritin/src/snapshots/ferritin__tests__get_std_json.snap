      {
        "path": "write",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.write.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Writes formatted data into a buffer.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro accepts a 'writer', a format string, and a list of arguments. Arguments will be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "formatted according to the specified format string and the result will be passed to the writer.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The writer may be any value with a ",
                    "style": "Plain"
                  },
                  {
                    "text": "write_fmt",
                    "style": "InlineCode"
                  },
                  {
                    "text": " method; generally this comes from an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implementation of either the ",
                    "style": "Plain"
                  },
                  {
                    "text": "fmt::Write",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/fmt/trait.Write.html"
                  },
                  {
                    "text": " or the ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::Write",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2Fstd%2Fio%2Ftrait%2EWrite"
                  },
                  {
                    "text": " trait. The macro",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "returns whatever the ",
                    "style": "Plain"
                  },
                  {
                    "text": "write_fmt",
                    "style": "InlineCode"
                  },
                  {
                    "text": " method returns; commonly a ",
                    "style": "Plain"
                  },
                  {
                    "text": "fmt::Result",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/fmt/type.Result.html"
                  },
                  {
                    "text": ", or an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::Result",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2Fstd%2Fio%2Ftype%2EResult"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::fmt",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/../std/index.html?search=core%3A%3A%2E%2E%3A%3Astd%3A%3Afmt"
                  },
                  {
                    "text": " for more information on the format string syntax.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::io::Write;\n\nfn main() -> std::io::Result<()> {\n    let mut w = Vec::new();\n    write!(&mut w, \"test\")?;\n    write!(&mut w, \"formatted {}\", \"arguments\")?;\n\n    assert_eq!(w, b\"testformatted arguments\");\n    Ok(())\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A module can import both ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::fmt::Write",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::io::Write",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and call ",
                    "style": "Plain"
                  },
                  {
                    "text": "write!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on objects",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implementing either, as objects do not typically implement both. However, the module must",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "avoid conflict between the trait names, such as by importing them as ",
                    "style": "Plain"
                  },
                  {
                    "text": "_",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or otherwise renaming",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "them:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fmt::Write as _;\nuse std::io::Write as _;\n\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    let mut s = String::new();\n    let mut v = Vec::new();\n\n    write!(&mut s, \"{} {}\", \"abc\", 123)?; // uses fmt::Write::write_fmt\n    write!(&mut v, \"s = {:?}\", s)?; // uses io::Write::write_fmt\n    assert_eq!(v, b\"s = \\\"abc 123\\\"\");\n    Ok(())\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If you also need the trait names themselves, such as to implement one or both on your types,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "import the containing module and then name them with a prefix:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fmt::{self, Write as _};\nuse std::io::{self, Write as _};\n\nstruct Example;\n\nimpl fmt::Write for Example {\n    fn write_str(&mut self, _s: &str) -> core::fmt::Result {\n         unimplemented!();\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note: This macro can be used in ",
                    "style": "Plain"
                  },
                  {
                    "text": "no_std",
                    "style": "InlineCode"
                  },
                  {
                    "text": " setups as well.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "In a ",
                    "style": "Plain"
                  },
                  {
                    "text": "no_std",
                    "style": "InlineCode"
                  },
                  {
                    "text": " setup you are responsible for the implementation details of the components.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use core::fmt::Write;\n\nstruct Example;\n\nimpl Write for Example {\n    fn write_str(&mut self, _s: &str) -> core::fmt::Result {\n         unimplemented!();\n    }\n}\n\nlet mut m = Example{};\nwrite!(&mut m, \"Hello World\").expect(\"Not written\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "writeln",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.writeln.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Writes formatted data into a buffer, with a newline appended.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On all platforms, the newline is the LINE FEED character (",
                    "style": "Plain"
                  },
                  {
                    "text": "\\n",
                    "style": "InlineCode"
                  },
                  {
                    "text": "/",
                    "style": "Plain"
                  },
                  {
                    "text": "U+000A",
                    "style": "InlineCode"
                  },
                  {
                    "text": ") alone",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(no additional CARRIAGE RETURN (",
                    "style": "Plain"
                  },
                  {
                    "text": "\\r",
                    "style": "InlineCode"
                  },
                  {
                    "text": "/",
                    "style": "Plain"
                  },
                  {
                    "text": "U+000D",
                    "style": "InlineCode"
                  },
                  {
                    "text": ").",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For more information, see ",
                    "style": "Plain"
                  },
                  {
                    "text": "write!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.write.html"
                  },
                  {
                    "text": ". For information on the format string syntax, see",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::fmt",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/../std/index.html?search=core%3A%3A%2E%2E%3A%3Astd%3A%3Afmt"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::io::{Write, Result};\n\nfn main() -> Result<()> {\n    let mut w = Vec::new();\n    writeln!(&mut w)?;\n    writeln!(&mut w, \"test\")?;\n    writeln!(&mut w, \"formatted {}\", \"arguments\")?;\n\n    assert_eq!(&w[..], \"\\ntest\\nformatted arguments\\n\".as_bytes());\n    Ok(())\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "assert_matches",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macros/macro.assert_matches.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Asserts that an expression matches the provided pattern.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro is generally preferable to ",
                    "style": "Plain"
                  },
                  {
                    "text": "assert!(matches!(value, pattern))",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", because it can print",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the debug representation of the actual value shape that did not meet expectations. In contrast,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "using ",
                    "style": "Plain"
                  },
                  {
                    "text": "assert!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.assert.html"
                  },
                  {
                    "text": " will only print that expectations were not met, but not why.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The pattern syntax is exactly the same as found in a match arm and the ",
                    "style": "Plain"
                  },
                  {
                    "text": "matches!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro. The",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "optional if guard can be used to add additional checks that must be true for the matched value,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "otherwise this macro will panic.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Assertions are always checked in both debug and release builds, and cannot",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be disabled. See ",
                    "style": "Plain"
                  },
                  {
                    "text": "debug_assert_matches!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macros/macro.debug_assert_matches.html"
                  },
                  {
                    "text": " for assertions that are disabled in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "release builds by default.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On panic, this macro will print the value of the expression with its debug representation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Like ",
                    "style": "Plain"
                  },
                  {
                    "text": "assert!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.assert.html"
                  },
                  {
                    "text": ", this macro has a second form, where a custom panic message can be provided.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::assert_matches;\n\nlet a = Some(345);\nlet b = Some(56);\nassert_matches!(a, Some(_));\nassert_matches!(b, Some(_));\n\nassert_matches!(a, Some(345));\nassert_matches!(a, Some(345) | None);\n\n// assert_matches!(a, None); // panics\n// assert_matches!(b, Some(345)); // panics\n// assert_matches!(b, Some(345) | None); // panics\n\nassert_matches!(a, Some(x) if x > 100);\n// assert_matches!(a, Some(x) if x < 100); // panics"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
