      {
        "path": "never",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.never.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type, also called \"never\".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " represents the type of computations which never resolve to any value at all. For example,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the ",
                    "style": "Plain"
                  },
                  {
                    "text": "exit",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Fprocess%2Ffn%2Eexit"
                  },
                  {
                    "text": " function ",
                    "style": "Plain"
                  },
                  {
                    "text": "fn exit(code: i32) -> !",
                    "style": "InlineCode"
                  },
                  {
                    "text": " exits the process without ever returning, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "so returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "break",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "continue",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "return",
                    "style": "InlineCode"
                  },
                  {
                    "text": " expressions also have type ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". For example we are allowed to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "write:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(never_type)]\nlet x: ! = {\n    return 123\n};"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Although the ",
                    "style": "Plain"
                  },
                  {
                    "text": "let",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is pointless here, it illustrates the meaning of ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Since ",
                    "style": "Plain"
                  },
                  {
                    "text": "x",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is never",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "assigned a value (because ",
                    "style": "Plain"
                  },
                  {
                    "text": "return",
                    "style": "InlineCode"
                  },
                  {
                    "text": " returns from the entire function), ",
                    "style": "Plain"
                  },
                  {
                    "text": "x",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can be given type",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". We could also replace ",
                    "style": "Plain"
                  },
                  {
                    "text": "return 123",
                    "style": "InlineCode"
                  },
                  {
                    "text": " with a ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or a never-ending ",
                    "style": "Plain"
                  },
                  {
                    "text": "loop",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and this code",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "would still be valid.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A more realistic usage of ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is in this code:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let num: u32 = match get_a_number() {\n    Some(num) => num,\n    None => break,\n};"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Both match arms must produce values of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "u32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.u32.html"
                  },
                  {
                    "text": ", but since ",
                    "style": "Plain"
                  },
                  {
                    "text": "break",
                    "style": "InlineCode"
                  },
                  {
                    "text": " never produces a value",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "at all we know it can never produce a value which isn't a ",
                    "style": "Plain"
                  },
                  {
                    "text": "u32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.u32.html"
                  },
                  {
                    "text": ". This illustrates another",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "behavior of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type - expressions with type ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will coerce into any other type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and generics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Infallible errors",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The main place you'll see ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " used explicitly is in generic code. Consider the ",
                    "style": "Plain"
                  },
                  {
                    "text": "FromStr",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/str/traits/index.html?search=core%3A%3Astr%3A%3Atraits%3A%3AFromStr"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "trait:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "trait FromStr: Sized {\n    type Err;\n    fn from_str(s: &str) -> Result<Self, Self::Err>;\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When implementing this trait for ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Fstring%2Fstruct%2EString"
                  },
                  {
                    "text": " we need to pick a type for ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/Result/index.html?search=core%3A%3Aresult%3A%3AResult%3A%3AErr"
                  },
                  {
                    "text": ". And since",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "converting a string into a string will never result in an error, the appropriate type is ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(Currently the type actually used is an enum with no variants, though this is only because ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "was added to Rust at a later date and it may change in the future.) With an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/Result/index.html?search=core%3A%3Aresult%3A%3AResult%3A%3AErr"
                  },
                  {
                    "text": " type of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", if we have to call ",
                    "style": "Plain"
                  },
                  {
                    "text": "String::from_str",
                    "style": "InlineCode",
                    "url": "https://docs.rs/str/latest/str/FromStr/index.html?search=str%3A%3AFromStr%3A%3Afrom%5Fstr"
                  },
                  {
                    "text": " for some reason the result will be a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<String, !>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                  },
                  {
                    "text": " which we can unpack like this:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::str::FromStr;\nlet Ok(s) = String::from_str(\"hello\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Since the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/Result/index.html?search=core%3A%3Aresult%3A%3AResult%3A%3AErr"
                  },
                  {
                    "text": " variant contains a ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", it can never occur. This means we can exhaustively",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "match on ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<T, !>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                  },
                  {
                    "text": " by just taking the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/Result/index.html?search=core%3A%3Aresult%3A%3AResult%3A%3AOk"
                  },
                  {
                    "text": " variant. This illustrates another behavior",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " - it can be used to \"delete\" certain enum variants from generic types like ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Infinite loops",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "While ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<T, !>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                  },
                  {
                    "text": " is very useful for removing errors, ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can also be used to remove",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "successes as well. If we think of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<T, !>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                  },
                  {
                    "text": " as \"if this function returns, it has not",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "errored,\" we get a very intuitive idea of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<!, E>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                  },
                  {
                    "text": " as well: if the function returns, it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "has",
                    "style": "Emphasis"
                  },
                  {
                    "text": " errored.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For example, consider the case of a simple web server, which can be simplified to:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "ignore (hypothetical-example)",
                "code": "loop {\n    let (client, request) = get_request().expect(\"disconnected\");\n    let response = request.process();\n    response.send(client);\n}\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Currently, this isn't ideal, because we simply panic whenever we fail to get a new connection.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Instead, we'd like to keep track of this error, like this:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "ignore (hypothetical-example)",
                "code": "loop {\n    match get_request() {\n        Err(err) => break err,\n        Ok((client, request)) => {\n            let response = request.process();\n            response.send(client);\n        },\n    }\n}\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Now, when the server disconnects, we exit the loop with an error instead of panicking. While it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "might be intuitive to simply return the error, we might want to wrap it in a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<!, E>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "instead:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "ignore (hypothetical-example)",
                "code": "fn server_loop() -> Result<!, ConnectionError> {\n    loop {\n        let (client, request) = get_request()?;\n        let response = request.process();\n        response.send(client);\n    }\n}\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Now, we can use ",
                    "style": "Plain"
                  },
                  {
                    "text": "?",
                    "style": "InlineCode"
                  },
                  {
                    "text": " instead of ",
                    "style": "Plain"
                  },
                  {
                    "text": "match",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and the return type makes a lot more sense: if the loop",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ever stops, it means that an error occurred. We don't even have to wrap the loop in an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "because ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " coerces to ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result<!, ConnectionError>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " automatically.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and traits",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When writing your own traits, ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " should have an ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl",
                    "style": "InlineCode"
                  },
                  {
                    "text": " whenever there is an obvious ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which doesn't ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The reason is that functions returning an ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl Trait",
                    "style": "InlineCode"
                  },
                  {
                    "text": " where ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "does not have an ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl",
                    "style": "InlineCode"
                  },
                  {
                    "text": " of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Trait",
                    "style": "InlineCode"
                  },
                  {
                    "text": " cannot diverge as their only possible code path. In other",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "words, they can't return ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " from every code path. As an example, this code doesn't compile:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::ops::Add;\n\nfn foo() -> impl Add<u32> {\n    unimplemented!()\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "But this code does:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::ops::Add;\n\nfn foo() -> impl Add<u32> {\n    if true {\n        unimplemented!()\n    } else {\n        0\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The reason is that, in the first example, there are many possible types that ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " could coerce",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to, because many types implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "Add<u32>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". However, in the second example,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the ",
                    "style": "Plain"
                  },
                  {
                    "text": "else",
                    "style": "InlineCode"
                  },
                  {
                    "text": " branch returns a ",
                    "style": "Plain"
                  },
                  {
                    "text": "0",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", which the compiler infers from the return type to be of type",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "u32",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Since ",
                    "style": "Plain"
                  },
                  {
                    "text": "u32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is a concrete type, ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can and will be coerced to it. See issue ",
                    "style": "Plain"
                  },
                  {
                    "text": "#36375",
                    "style": "Plain",
                    "url": "https://github.com/rust-lang/rust/issues/36375"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for more information on this quirk of ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As it turns out, though, most traits can have an ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Take ",
                    "style": "Plain"
                  },
                  {
                    "text": "Debug",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/fmt/index.html?search=core%3A%3Afmt%3A%3ADebug"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for example:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(never_type)]\nimpl Debug for ! {\n    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n        *self\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Once again we're using ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s ability to coerce into any other type, in this case",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "fmt::Result",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/fmt/index.html?search=core%3A%3Afmt%3A%3AResult"
                  },
                  {
                    "text": ". Since this method takes a ",
                    "style": "Plain"
                  },
                  {
                    "text": "&!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " as an argument we know that it can never be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "called (because there is no value of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for it to be called with). Writing ",
                    "style": "Plain"
                  },
                  {
                    "text": "*self",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "essentially tells the compiler \"We know that this code can never be run, so just treat the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "entire function body as having type ",
                    "style": "Plain"
                  },
                  {
                    "text": "fmt::Result",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/fmt/index.html?search=core%3A%3Afmt%3A%3AResult"
                  },
                  {
                    "text": "\". This pattern can be used a lot when",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implementing traits for ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Generally, any trait which only has methods which take a ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "parameter should have such an impl.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On the other hand, one trait which would not be appropriate to implement is ",
                    "style": "Plain"
                  },
                  {
                    "text": "Default",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/default/index.html?search=core%3A%3Adefault%3A%3ADefault"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "trait Default {\n    fn default() -> Self;\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Since ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " has no values, it has no default value either. It's true that we could write an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for this which simply panics, but the same is true for any type (we could ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl Default",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for (eg.) ",
                    "style": "Plain"
                  },
                  {
                    "text": "File",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Ffs%2Fstruct%2EFile"
                  },
                  {
                    "text": " by just making ",
                    "style": "Plain"
                  },
                  {
                    "text": "default()",
                    "style": "InlineCode",
                    "url": "https://docs.rs/Default/latest/Default/index.html?search=Default%3A%3Adefault"
                  },
                  {
                    "text": " panic.)",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Never type fallback",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When the compiler sees a value of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in a ",
                    "style": "Plain"
                  },
                  {
                    "text": "coercion site",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/reference/type-coercions.html#coercion-sites"
                  },
                  {
                    "text": ", it implicitly inserts a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "coercion to allow the type checker to infer any type:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// this\nlet x: u8 = panic!();\n\n// is (essentially) turned by the compiler into\nlet x: u8 = absurd(panic!());\n\n// where absurd is a function with the following signature\n// (it's sound, because `!` always marks unreachable code):\nfn absurd<T>(_: !) -> T { ... }"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This can lead to compilation errors if the type cannot be inferred:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// this\n{ panic!() };\n\n// gets turned into this\n{ absurd(panic!()) }; // error: can't infer the type of `absurd`"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "To prevent such errors, the compiler remembers where it inserted ",
                    "style": "Plain"
                  },
                  {
                    "text": "absurd",
                    "style": "InlineCode"
                  },
                  {
                    "text": " calls, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "if it can't infer the type, it uses the fallback type instead:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "type Fallback = /* An arbitrarily selected type! */;\n{ absurd::<Fallback>(panic!()) }"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This is what is known as \"never type fallback\".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Historically, the fallback type was ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.unit.html"
                  },
                  {
                    "text": ", causing confusing behavior where ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " spontaneously",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "coerced to ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", even when it would not infer ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " without the fallback. The fallback was changed",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to ",
                    "style": "Plain"
                  },
                  {
                    "text": "!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in the ",
                    "style": "Plain"
                  },
                  {
                    "text": "2024 edition",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/edition-guide/rust-2024/never-type-fallback.html"
                  },
                  {
                    "text": ", and will be changed in all editions at a later date.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
