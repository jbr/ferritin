      {
        "path": "str",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.str.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "String slices.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the ",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Astr"
                  },
                  {
                    "text": "std::str",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Astr"
                  },
                  {
                    "text": " module",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Astr"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type, also called a 'string slice', is the most primitive string",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "type. It is usually seen in its borrowed form, ",
                    "style": "Plain"
                  },
                  {
                    "text": "&str",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". It is also the type",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of string literals, ",
                    "style": "Plain"
                  },
                  {
                    "text": "&'static str",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Basic Usage",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "String literals are string slices:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let hello_world = \"Hello, World!\";"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Here we have declared a string slice initialized with a string literal.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "String literals have a static lifetime, which means the string ",
                    "style": "Plain"
                  },
                  {
                    "text": "hello_world",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is guaranteed to be valid for the duration of the entire program.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "We can explicitly specify ",
                    "style": "Plain"
                  },
                  {
                    "text": "hello_world",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s lifetime as well:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let hello_world: &'static str = \"Hello, world!\";"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Representation",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A ",
                    "style": "Plain"
                  },
                  {
                    "text": "&str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is made up of two components: a pointer to some bytes, and a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "length. You can look at these with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "as_ptr",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "len",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " methods:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::slice;\nuse std::str;\n\nlet story = \"Once upon a time...\";\n\nlet ptr = story.as_ptr();\nlet len = story.len();\n\n// story has nineteen bytes\nassert_eq!(19, len);\n\n// We can re-build a str out of ptr and len. This is all unsafe because\n// we are responsible for making sure the two components are valid:\nlet s = unsafe {\n    // First, we build a &[u8]...\n    let slice = slice::from_raw_parts(ptr, len);\n\n    // ... and then convert that slice into a string slice\n    str::from_utf8(slice)\n};\n\nassert_eq!(s, Ok(story));"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note: This example shows the internals of ",
                    "style": "Plain"
                  },
                  {
                    "text": "&str",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " should not be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "used to get a string slice under normal circumstances. Use ",
                    "style": "Plain"
                  },
                  {
                    "text": "as_str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Invariant",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rust libraries may assume that string slices are always valid UTF-8.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Constructing a non-UTF-8 string slice is not immediate undefined behavior, but any function",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "called on a string slice may assume that it is valid UTF-8, which means that a non-UTF-8 string",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "slice can lead to undefined behavior down the road.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "tuple",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.tuple.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A finite heterogeneous sequence, ",
                    "style": "Plain"
                  },
                  {
                    "text": "(T, U, ..)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Let's cover each of those in turn:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tuples are ",
                    "style": "Plain"
                  },
                  {
                    "text": "finite",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". In other words, a tuple has a length. Here's a tuple",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of length ",
                    "style": "Plain"
                  },
                  {
                    "text": "3",
                    "style": "InlineCode"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "(\"hello\", 5, 'c');"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "'Length' is also sometimes called 'arity' here; each tuple of a different",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "length is a different, distinct type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tuples are ",
                    "style": "Plain"
                  },
                  {
                    "text": "heterogeneous",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". This means that each element of the tuple can",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "have a different type. In that tuple above, it has the type:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "(&'static str, i32, char)"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tuples are a ",
                    "style": "Plain"
                  },
                  {
                    "text": "sequence",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". This means that they can be accessed by position;",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "this is called 'tuple indexing', and it looks like this:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let tuple = (\"hello\", 5, 'c');\n\nassert_eq!(tuple.0, \"hello\");\nassert_eq!(tuple.1, 5);\nassert_eq!(tuple.2, 'c');"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The sequential nature of the tuple applies to its implementations of various",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "traits. For example, in ",
                    "style": "Plain"
                  },
                  {
                    "text": "PartialOrd",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3APartialOrd"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ord",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AOrd"
                  },
                  {
                    "text": ", the elements are compared",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "sequentially until the first non-equal set is found.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For more about tuples, see ",
                    "style": "Plain"
                  },
                  {
                    "text": "the book",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fbook%2Fch03%2D02%2Ddata%2Dtypes"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Trait implementations",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In this documentation the shorthand ",
                    "style": "Plain"
                  },
                  {
                    "text": "(T₁, T₂, …, Tₙ)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is used to represent tuples of varying",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "length. When that is used, any trait bound expressed on ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " applies to each element of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "tuple independently. Note that this is a convenience notation to avoid repetitive",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "documentation, not valid Rust syntax.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Due to a temporary restriction in Rust’s type system, the following traits are only",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implemented on tuples of arity 12 or less. In the future, this may change:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "PartialEq",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3APartialEq"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Eq",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AEq"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "PartialOrd",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3APartialOrd"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Ord",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AOrd"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Debug",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/fmt/index.html?search=core%3A%3Afmt%3A%3ADebug"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Default",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/default/index.html?search=core%3A%3Adefault%3A%3ADefault"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Hash",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/hash/index.html?search=core%3A%3Ahash%3A%3AHash"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "From<[T; N]>",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/convert/index.html?search=core%3A%3Aconvert%3A%3AFrom"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The following traits are implemented for tuples of any length. These traits have",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implementations that are automatically generated by the compiler, so are not limited by",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "missing language features.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
