                            "style": "InlineCode"
                          },
                          {
                            "text": " is",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "ABI-compatible with the ",
                            "style": "Plain"
                          },
                          {
                            "text": "iN",
                            "style": "InlineCode"
                          },
                          {
                            "text": " integer type of the same size.",
