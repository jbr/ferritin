            },
            {
              "text": " trait.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Data may be shared by placing it in a reference-counted box or the ",
              "style": "Plain"
            },
            {
              "text": "Rc",
              "style": "InlineCode",
              "url": "https://doc.rust-lang.org/nightly/alloc/rc/index.html?search=alloc%3A%3Arc%3A%3ARc"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "type, and if further contained in a ",
              "style": "Plain"
            },
            {
              "text": "Cell",
              "style": "InlineCode",
              "url": "https://doc.rust-lang.org/nightly/core/cell/index.html?search=core%3A%3Acell%3A%3ACell"
            },
            {
              "text": " or ",
              "style": "Plain"
            },
            {
              "text": "RefCell",
              "style": "InlineCode",
              "url": "https://doc.rust-lang.org/nightly/core/cell/index.html?search=core%3A%3Acell%3A%3ARefCell"
            },
            {
              "text": ", may be mutated",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "as well as shared. Likewise, in a concurrent setting it is common to pair an",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "atomically-reference-counted box, ",
              "style": "Plain"
            },
            {
              "text": "Arc",
              "style": "InlineCode",
              "url": "https://doc.rust-lang.org/nightly/alloc/sync/index.html?search=alloc%3A%3Async%3A%3AArc"
            },
            {
              "text": ", with a ",
