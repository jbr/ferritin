                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If you're creating a collection, implementing ",
                            "style": "Plain"
                          },
                          {
                            "text": "IntoIterator",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/core/iter/traits/collect/trait.IntoIterator.html"
                          },
