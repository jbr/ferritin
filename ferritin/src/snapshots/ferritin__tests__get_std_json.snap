                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aptr"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Working with raw pointers in Rust is uncommon, typically limited to a few patterns. Raw pointers",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "can be out-of-bounds, unaligned, or ",
                    "style": "Plain"
                  },
                  {
                    "text": "null",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ptr/index.html?search=core%3A%3Aptr%3A%3Anull"
                  },
                  {
                    "text": ". However, when loading from or storing to a raw",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointer, it must be ",
                    "style": "Plain"
                  },
                  {
                    "text": "valid",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aptr"
                  },
                  {
                    "text": " for the given access and aligned. When using a field expression,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "tuple index expression, or array/slice index expression on a raw pointer, it follows the rules",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of ",
                    "style": "Plain"
                  },
                  {
                    "text": "in-bounds pointer arithmetic",
                    "style": "Plain",
                    "url": "https://docs.rs/pointer/latest/pointer/index.html?search=pointer%3A%3Aoffset"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Storing through a raw pointer using ",
                    "style": "Plain"
                  },
                  {
                    "text": "*ptr = data",
                    "style": "InlineCode"
                  },
                  {
                    "text": " calls ",
                    "style": "Plain"
                  },
                  {
                    "text": "drop",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on the old value, so",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
