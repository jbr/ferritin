                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Loops that dynamically terminate.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Iterators that dynamically terminate.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the determination that the code is unreachable proves incorrect, the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "program immediately terminates with a ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.panic.html"
