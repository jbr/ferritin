          }
        ]
      },
      {
        "path": "any",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/core/any/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Utilities for dynamic typing or type reflection.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "TypeId",
                    "style": "InlineCode"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": " itself can be used to get a ",
                    "style": "Plain"
                  },
                  {
                    "text": "TypeId",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and has more features when used",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as a trait object. As ",
                    "style": "Plain"
                  },
                  {
                    "text": "&dyn Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": " (a borrowed trait object), it has the ",
                    "style": "Plain"
                  },
                  {
                    "text": "is",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and ",
                    "style": "Plain"
                  },
                  {
                    "text": "downcast_ref",
                    "style": "InlineCode"
                  },
                  {
                    "text": " methods, to test if the contained value is of a given type,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and to get a reference to the inner value as a type. As ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut dyn Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", there",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is also the ",
                    "style": "Plain"
                  },
                  {
                    "text": "downcast_mut",
                    "style": "InlineCode"
                  },
                  {
                    "text": " method, for getting a mutable reference to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "inner value. ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<dyn Any>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " adds the ",
                    "style": "Plain"
                  },
                  {
                    "text": "downcast",
                    "style": "InlineCode"
                  },
                  {
                    "text": " method, which attempts to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "convert to a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". See the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fboxed%2Fstruct%2EBox"
                  },
                  {
                    "text": " documentation for the full details.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that ",
                    "style": "Plain"
                  },
                  {
                    "text": "&dyn Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is limited to testing whether a value is of a specified",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "concrete type, and cannot be used to test whether a type implements a trait.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Smart pointers and ",
                    "style": "Plain"
                  },
                  {
                    "text": "dyn Any",
                    "style": "InlineCode"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "One piece of behavior to keep in mind when using ",
                    "style": "Plain"
                  },
                  {
                    "text": "Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": " as a trait object,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "especially with types like ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<dyn Any>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Arc<dyn Any>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", is that simply",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "calling ",
                    "style": "Plain"
                  },
                  {
                    "text": ".type_id()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on the value will produce the ",
                    "style": "Plain"
                  },
                  {
                    "text": "TypeId",
                    "style": "InlineCode"
                  },
                  {
                    "text": " of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "container",
                    "style": "Emphasis"
                  },
                  {
                    "text": ", not the underlying trait object. This can be avoided by",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "converting the smart pointer into a ",
                    "style": "Plain"
                  },
                  {
                    "text": "&dyn Any",
                    "style": "InlineCode"
                  },
                  {
                    "text": " instead, which will return",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the object's ",
                    "style": "Plain"
                  },
                  {
                    "text": "TypeId",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". For example:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::any::{Any, TypeId};\n\nlet boxed: Box<dyn Any> = Box::new(3_i32);\n\n// You're more likely to want this:\nlet actual_id = (&*boxed).type_id();\n// ... than this:\nlet boxed_id = boxed.type_id();\n\nassert_eq!(actual_id, TypeId::of::<i32>());\nassert_eq!(boxed_id, TypeId::of::<Box<dyn Any>>());"
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Consider a situation where we want to log a value passed to a function.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "We know the value we're working on implements ",
                    "style": "Plain"
                  },
                  {
                    "text": "Debug",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", but we don't know its",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "concrete type. We want to give special treatment to certain types: in this",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "case printing out the length of ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values prior to their value.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "We don't know the concrete type of our value at compile time, so we need to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "use runtime reflection instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fmt::Debug;\nuse std::any::Any;\n\n// Logger function for any type that implements `Debug`.\nfn log<T: Any + Debug>(value: &T) {\n    let value_any = value as &dyn Any;\n\n    // Try to convert our value to a `String`. If successful, we want to\n    // output the `String`'s length as well as its value. If not, it's a\n    // different type: just print it out unadorned.\n    match value_any.downcast_ref::<String>() {\n        Some(as_string) => {\n            println!(\"String ({}): {}\", as_string.len(), as_string);\n        }\n        None => {\n            println!(\"{value:?}\");\n        }\n    }\n}\n\n// This function wants to log its parameter out prior to doing work with it.\nfn do_work<T: Any + Debug>(value: &T) {\n    log(value);\n    // ...do some other work\n}\n\nfn main() {\n    let my_string = \"Hello World\".to_string();\n    do_work(&my_string);\n\n    let my_i8: i8 = 100;\n    do_work(&my_i8);\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "array",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/core/array/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Utilities for the array primitive type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the array primitive type",
                    "style": "Emphasis",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.array.html"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
