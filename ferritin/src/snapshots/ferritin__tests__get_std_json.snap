              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fs::File;\nuse std::io::prelude::*;\n\nlet mut file = File::create(\"valuable_data.txt\").unwrap();\nfile.write_all(b\"important message\").expect(\"failed to write message\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You might also simply assert success:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "assert!(file.write_all(b\"important message\").is_ok());"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Or propagate the error up the call stack with ",
                    "style": "Plain"
                  },
                  {
                    "text": "?",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/ops/try_trait/trait.Try.html"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn write_message() -> io::Result<()> {\n    let mut file = File::create(\"valuable_data.txt\")?;\n    file.write_all(b\"important message\")?;\n    Ok(())\n}"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "The question mark operator, ",
                    "style": "Plain"
                  },
                  {
                    "text": "?",
                    "style": "InlineCode"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When writing code that calls many functions that return the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/result/enum.Result.html"
                  },
                  {
                    "text": " type, the error handling can be tedious. The question mark",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "operator, ",
                    "style": "Plain"
                  },
                  {
                    "text": "?",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/ops/try_trait/trait.Try.html"
                  },
                  {
                    "text": ", hides some of the boilerplate of propagating errors",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "up the call stack.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It replaces this:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fs::File;\nuse std::io::prelude::*;\nuse std::io;\n\nstruct Info {\n    name: String,\n    age: i32,\n    rating: i32,\n}\n\nfn write_info(info: &Info) -> io::Result<()> {\n    // Early return on error\n    let mut file = match File::create(\"my_best_friends.txt\") {\n           Err(e) => return Err(e),\n           Ok(f) => f,\n    };\n    if let Err(e) = file.write_all(format!(\"name: {}\\n\", info.name).as_bytes()) {\n        return Err(e)\n    }\n    if let Err(e) = file.write_all(format!(\"age: {}\\n\", info.age).as_bytes()) {\n        return Err(e)\n    }\n    if let Err(e) = file.write_all(format!(\"rating: {}\\n\", info.rating).as_bytes()) {\n        return Err(e)\n    }\n    Ok(())\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "With this:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fs::File;\nuse std::io::prelude::*;\nuse std::io;\n\nstruct Info {\n    name: String,\n    age: i32,\n    rating: i32,\n}\n\nfn write_info(info: &Info) -> io::Result<()> {\n    let mut file = File::create(\"my_best_friends.txt\")?;\n    // Early return on error\n    file.write_all(format!(\"name: {}\\n\", info.name).as_bytes())?;\n    file.write_all(format!(\"age: {}\\n\", info.age).as_bytes())?;\n    file.write_all(format!(\"rating: {}\\n\", info.rating).as_bytes())?;\n    Ok(())\n}"
              },
