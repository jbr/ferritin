                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "For types that implement ",
                            "style": "Plain"
                          },
                          {
                            "text": "Default",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/core/default/trait.Default.html"
                          },
                          {
