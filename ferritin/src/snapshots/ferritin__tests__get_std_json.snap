                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Further methods that return iterators are ",
                            "style": "Plain"
                          },
                          {
                            "text": ".split",
                            "style": "InlineCode",
                            "url": "https://docs.rs/slice/latest/slice/index.html?search=slice%3A%3Asplit"
