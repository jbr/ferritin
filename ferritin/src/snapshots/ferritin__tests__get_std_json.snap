                    "style": "Plain"
                  },
                  {
                    "text": "requirement.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Trait implementations",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In this documentation the shorthand ",
                    "style": "Plain"
                  },
                  {
                    "text": "fn(T₁, T₂, …, Tₙ)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is used to represent non-variadic",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "function pointers of varying length. Note that this is a convenience notation to avoid",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "repetitive documentation, not valid Rust syntax.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The following traits are implemented for function pointers with any number of arguments and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "any ABI.",
                    "style": "Plain"
