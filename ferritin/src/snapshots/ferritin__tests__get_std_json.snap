              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Result<T, E>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/result/enum.Result.html"
                  },
                  {
                    "text": " is the type used for returning and propagating",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "errors. It is an enum with the variants, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok(T)",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ", representing",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "success and containing a value, and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err(E)",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ", representing error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and containing an error value.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "enum Result<T, E> {\n   Ok(T),\n   Err(E),\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Functions return ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/result/enum.Result.html"
                  },
                  {
                    "text": " whenever errors are expected and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
