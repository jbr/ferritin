              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You might instead, if you don't want to handle the error, simply",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "assert success with ",
                    "style": "Plain"
                  },
                  {
                    "text": "expect",
