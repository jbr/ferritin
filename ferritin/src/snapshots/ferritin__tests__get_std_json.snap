                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Unpin.html"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The vast majority of Rust types have no address-sensitive states. These types",
                    "style": "Plain"
