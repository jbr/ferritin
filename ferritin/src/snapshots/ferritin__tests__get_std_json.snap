                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "even if such a type is a 1-ZST or ",
                    "style": "Plain"
                  },
                  {
                    "text": "repr(transparent)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " right now, this might change with any",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "library version bump.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the declared signature and the signature of the function pointer are ABI-compatible, then the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "function call behaves as if every argument was ",
                    "style": "Plain"
                  },
                  {
                    "text": "transmute",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/intrinsics/index.html?search=core%3A%3Aintrinsics%3A%3Atransmute"
                  },
                  {
                    "text": "d",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/intrinsics/index.html?search=core%3A%3Aintrinsics%3A%3Atransmute"
                  },
                  {
                    "text": " from the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "type in the function pointer to the type at the function declaration, and the return value is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "transmute",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/intrinsics/index.html?search=core%3A%3Aintrinsics%3A%3Atransmute"
