              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The idea of this trait is to alleviate the reduced ergonomics of APIs that require the use",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of ",
