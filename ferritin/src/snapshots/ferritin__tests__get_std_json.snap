      {
        "path": "eprintln",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/std/macro.eprintln.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
