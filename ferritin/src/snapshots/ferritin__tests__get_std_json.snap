          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Check out the Rust contribution guidelines ",
              "style": "Plain"
            },
            {
              "text": "here",
              "style": "Plain",
              "url": "https://rustc-dev-guide.rust-lang.org/contributing.html#writing-documentation"
