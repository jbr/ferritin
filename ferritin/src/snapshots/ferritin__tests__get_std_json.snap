                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = [Err(\"error!\"), Ok(1), Ok(2), Ok(3), Err(\"foo\")];\nlet res: Result<i32, &str> = v.into_iter().sum();\nassert_eq!(res, Err(\"error!\"));\nlet v = [Ok(1), Ok(2), Ok(21)];\nlet res: Result<i32, &str> = v.into_iter().product();\nassert_eq!(res, Ok(42));"
