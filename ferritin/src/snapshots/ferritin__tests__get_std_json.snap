                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The unsafe counterpart of this macro is the ",
                    "style": "Plain"
                  },
                  {
                    "text": "unreachable_unchecked",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/hint/fn.unreachable_unchecked.html"
                  },
                  {
                    "text": " function, which",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "will cause undefined behavior if the code is reached.",
                    "style": "Plain"
                  }
                ]
              },
