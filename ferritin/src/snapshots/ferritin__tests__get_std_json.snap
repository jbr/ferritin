              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = [Ok(2), Ok(4), Err(\"err!\"), Ok(8)];\nlet res: Result<Vec<_>, &str> = v.into_iter().collect();\nassert_eq!(res, Err(\"err!\"));\nlet v = [Ok(2), Ok(4), Ok(8)];\nlet res: Result<Vec<_>, &str> = v.into_iter().collect();\nassert_eq!(res, Ok(vec![2, 4, 8]));"
