                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "stdout",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.stdout"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "stdin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.stdin"
                  },
                  {
                    "text": ", and ",
                    "style": "Plain"
                  },
                  {
                    "text": "stderr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.stderr"
                  },
                  {
                    "text": " of a child process can be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "configured by passing an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Stdio",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Stdio.html"
                  },
                  {
                    "text": " to the corresponding method on",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Command",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html"
                  },
                  {
                    "text": ". Once spawned, they can be accessed from the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Child",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Child.html"
                  },
                  {
                    "text": ". For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example, piping output from one command into another command can be done",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "like so:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::process::{Command, Stdio};\n\n// stdout must be configured with `Stdio::piped` in order to use\n// `echo_child.stdout`\nlet echo_child = Command::new(\"echo\")\n    .arg(\"Oh no, a tpyo!\")\n    .stdout(Stdio::piped())\n    .spawn()\n    .expect(\"Failed to start echo process\");\n\n// Note that `echo_child` is moved here, but we won't be needing\n// `echo_child` anymore\nlet echo_out = echo_child.stdout.expect(\"Failed to open echo stdout\");\n\nlet mut sed_child = Command::new(\"sed\")\n    .arg(\"s/tpyo/typo/\")\n    .stdin(Stdio::from(echo_out))\n    .stdout(Stdio::piped())\n    .spawn()\n    .expect(\"Failed to start sed process\");\n\nlet output = sed_child.wait_with_output().expect(\"Failed to wait on sed\");\nassert_eq!(b\"Oh no, a typo!\\n\", output.stdout.as_slice());"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that ",
                    "style": "Plain"
                  },
                  {
                    "text": "ChildStderr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.ChildStderr.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "ChildStdout",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.ChildStdout.html"
                  },
                  {
                    "text": " implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "Read",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/io/trait.Read.html"
                  },
                  {
                    "text": " and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ChildStdin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.ChildStdin.html"
                  },
                  {
                    "text": " implements ",
                    "style": "Plain"
                  },
                  {
                    "text": "Write",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/io/trait.Write.html"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::process::{Command, Stdio};\nuse std::io::Write;\n\nlet mut child = Command::new(\"/bin/cat\")\n    .stdin(Stdio::piped())\n    .stdout(Stdio::piped())\n    .spawn()\n    .expect(\"failed to execute child\");\n\n// If the child process fills its stdout buffer, it may end up\n// waiting until the parent reads the stdout, and not be able to\n// read stdin in the meantime, causing a deadlock.\n// Writing from another thread ensures that stdout is being read\n// at the same time, avoiding the problem.\nlet mut stdin = child.stdin.take().expect(\"failed to get stdin\");\nstd::thread::spawn(move || {\n    stdin.write_all(b\"test\").expect(\"failed to write to stdin\");\n});\n\nlet output = child\n    .wait_with_output()\n    .expect(\"failed to wait on child\");\n\nassert_eq!(b\"test\", output.stdout.as_slice());"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Windows argument splitting",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On Unix systems arguments are passed to a new process as an array of strings,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "but on Windows arguments are passed as a single commandline string and it is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "up to the child process to parse it into an array. Therefore the parent and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "child processes must agree on how the commandline string is encoded.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Most programs use the standard C run-time ",
                    "style": "Plain"
                  },
                  {
                    "text": "argv",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", which in practice results",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in consistent argument handling. However, some programs have their own way of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "parsing the commandline string. In these cases using ",
                    "style": "Plain"
                  },
                  {
                    "text": "arg",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.arg"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "args",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.args"
                  },
                  {
                    "text": " may",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "result in the child process seeing a different array of arguments than the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "parent process intended.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Two ways of mitigating this are:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Validate untrusted input so that only a safe subset is allowed.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Use ",
                            "style": "Plain"
                          },
                          {
                            "text": "raw_arg",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/std/"
                          },
                          {
                            "text": " to build a custom commandline. This bypasses the escaping",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "rules used by ",
                            "style": "Plain"
                          },
                          {
                            "text": "arg",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.arg"
                          },
                          {
                            "text": " so should be used with due caution.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "cmd.exe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": ".bat",
                    "style": "InlineCode"
                  },
                  {
                    "text": " files use non-standard argument parsing and are especially",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "vulnerable to malicious input as they may be used to run arbitrary shell",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "commands. Untrusted arguments should be restricted as much as possible.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "For examples on handling this see ",
                    "style": "Plain"
                  },
                  {
                    "text": "raw_arg",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Batch file special handling",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On Windows, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Command",
                    "style": "InlineCode"
                  },
                  {
                    "text": " uses the Windows API function ",
                    "style": "Plain"
                  },
                  {
                    "text": "CreateProcessW",
                    "style": "InlineCode",
                    "url": "https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-createprocessw"
                  },
                  {
                    "text": " to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "spawn new processes. An undocumented feature of this function is that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "when given a ",
                    "style": "Plain"
                  },
                  {
                    "text": ".bat",
                    "style": "InlineCode"
                  },
                  {
                    "text": " file as the application to run, it will automatically",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "convert that into running ",
                    "style": "Plain"
                  },
                  {
                    "text": "cmd.exe /c",
                    "style": "InlineCode"
                  },
                  {
                    "text": " with the batch file as the next argument.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For historical reasons Rust currently preserves this behavior when using",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Command::new",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/process/struct.Command.html#method.new"
                  },
                  {
                    "text": ", and escapes the arguments according to ",
                    "style": "Plain"
                  },
                  {
                    "text": "cmd.exe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " rules.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Due to the complexity of ",
                    "style": "Plain"
                  },
                  {
                    "text": "cmd.exe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " argument handling, it might not be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "possible to safely escape some special characters, and using them will result",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in an error being returned at process spawn. The set of unescapeable",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "special characters might change between releases.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Also note that running batch scripts in this way may be removed in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "future and so should not be relied upon.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "random",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/random/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Random value generation.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "sync",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/sync/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Useful synchronization primitives.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "The need for synchronization",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Conceptually, a Rust program is a series of operations which will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be executed on a computer. The timeline of events happening in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "program is consistent with the order of the operations in the code.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Consider the following code, operating on some global static variables:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// FIXME(static_mut_refs): Do not allow `static_mut_refs` lint\n#![allow(static_mut_refs)]\n\nstatic mut A: u32 = 0;\nstatic mut B: u32 = 0;\nstatic mut C: u32 = 0;\n\nfn main() {\n    unsafe {\n        A = 3;\n        B = 4;\n        A = A + B;\n        C = B;\n        println!(\"{A} {B} {C}\");\n        C = A;\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It appears as if some variables stored in memory are changed, an addition",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is performed, result is stored in ",
                    "style": "Plain"
                  },
                  {
                    "text": "A",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and the variable ",
                    "style": "Plain"
                  },
                  {
                    "text": "C",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "modified twice.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When only a single thread is involved, the results are as expected:",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the line ",
                    "style": "Plain"
                  },
                  {
                    "text": "7 4 4",
                    "style": "InlineCode"
                  },
                  {
                    "text": " gets printed.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As for what happens behind the scenes, when optimizations are enabled the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "final generated machine code might look very different from the code:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The first store to ",
                            "style": "Plain"
                          },
                          {
                            "text": "C",
                            "style": "InlineCode"
                          },
                          {
                            "text": " might be moved before the store to ",
                            "style": "Plain"
                          },
                          {
                            "text": "A",
                            "style": "InlineCode"
                          },
                          {
                            "text": " or ",
                            "style": "Plain"
                          },
                          {
                            "text": "B",
                            "style": "InlineCode"
                          },
                          {
                            "text": ",",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "as if",
                            "style": "Emphasis"
                          },
                          {
                            "text": " we had written ",
                            "style": "Plain"
                          },
                          {
                            "text": "C = 4; A = 3; B = 4",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Assignment of ",
                            "style": "Plain"
                          },
                          {
                            "text": "A + B",
                            "style": "InlineCode"
                          },
                          {
                            "text": " to ",
                            "style": "Plain"
                          },
                          {
                            "text": "A",
                            "style": "InlineCode"
                          },
                          {
                            "text": " might be removed, since the sum can be stored",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "in a temporary location until it gets printed, with the global variable",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "never getting updated.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The final result could be determined just by looking at the code",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "at compile time, so ",
                            "style": "Plain"
                          },
                          {
                            "text": "constant folding",
                            "style": "Plain",
                            "url": "https://en.wikipedia.org/wiki/Constant_folding"
                          },
                          {
                            "text": " might turn the whole",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "block into a simple ",
                            "style": "Plain"
                          },
                          {
                            "text": "println!(\"7 4 4\")",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The compiler is allowed to perform any combination of these",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "optimizations, as long as the final optimized code, when executed,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "produces the same results as the one without optimizations.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Due to the ",
                    "style": "Plain"
                  },
                  {
                    "text": "concurrency",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Concurrency_(computer_science)"
                  },
                  {
                    "text": " involved in modern computers, assumptions",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "about the program's execution order are often wrong. Access to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "global variables can lead to nondeterministic results, ",
                    "style": "Plain"
                  },
                  {
                    "text": "even if",
                    "style": "Strong"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "compiler optimizations are disabled, and it is ",
                    "style": "Plain"
                  },
                  {
                    "text": "still possible",
                    "style": "Strong"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to introduce synchronization bugs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that thanks to Rust's safety guarantees, accessing global (static)",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "variables requires ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " code, assuming we don't use any of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "synchronization primitives in this module.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Out-of-order execution",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Instructions can execute in a different order from the one we define, due to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "various reasons:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The ",
                            "style": "Plain"
                          },
                          {
                            "text": "compiler",
                            "style": "Strong"
                          },
                          {
                            "text": " reordering instructions: If the compiler can issue an",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "instruction at an earlier point, it will try to do so. For example, it",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "might hoist memory loads at the top of a code block, so that the CPU can",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "start ",
                            "style": "Plain"
                          },
                          {
                            "text": "prefetching",
                            "style": "Plain",
                            "url": "https://en.wikipedia.org/wiki/Cache_prefetching"
                          },
                          {
                            "text": " the values from memory.",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "In single-threaded scenarios, this can cause issues when writing",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "signal handlers or certain kinds of low-level code.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "Use ",
                            "style": "Plain"
                          },
                          {
                            "text": "compiler fences",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/sync/atomic/index.html?search=core%3A%3Async%3A%3Aatomic%3A%3Acompiler%5Ffence"
                          },
                          {
                            "text": " to prevent this reordering.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "A ",
                            "style": "Plain"
                          },
                          {
                            "text": "single processor",
                            "style": "Strong"
                          },
                          {
                            "text": " executing instructions ",
                            "style": "Plain"
                          },
                          {
                            "text": "out-of-order",
                            "style": "Plain",
                            "url": "https://en.wikipedia.org/wiki/Out-of-order_execution"
                          },
                          {
                            "text": ":",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "Modern CPUs are capable of ",
                            "style": "Plain"
                          },
                          {
                            "text": "superscalar",
                            "style": "Plain",
                            "url": "https://en.wikipedia.org/wiki/Superscalar_processor"
                          },
                          {
                            "text": " execution,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "i.e., multiple instructions might be executing at the same time,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "even though the machine code describes a sequential process.",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "This kind of reordering is handled transparently by the CPU.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "A ",
                            "style": "Plain"
                          },
                          {
                            "text": "multiprocessor",
                            "style": "Strong"
                          },
                          {
                            "text": " system executing multiple hardware threads",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "at the same time: In multi-threaded scenarios, you can use two",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "kinds of primitives to deal with synchronization:",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "memory fences",
                                    "style": "Plain",
                                    "url": "https://doc.rust-lang.org/nightly/core/sync/atomic/index.html?search=core%3A%3Async%3A%3Aatomic%3A%3Afence"
                                  },
                                  {
                                    "text": " to ensure memory accesses are made visible to",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "other CPUs in the right order.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "atomic operations",
                                    "style": "Plain",
                                    "url": "https://doc.rust-lang.org/nightly/core/sync/index.html?search=core%3A%3Async%3A%3Aatomic"
                                  },
                                  {
                                    "text": " to ensure simultaneous access to the same",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "memory location doesn't lead to undefined behavior.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Higher-level synchronization objects",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Most of the low-level synchronization primitives are quite error-prone and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "inconvenient to use, which is why the standard library also exposes some",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "higher-level synchronization objects.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "These abstractions can be built out of lower-level primitives.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "For efficiency, the sync objects in the standard library are usually",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implemented with help from the operating system's kernel, which is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "able to reschedule the threads while they are blocked on acquiring",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a lock.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The following is an overview of the available synchronization",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "objects:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Arc",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/alloc/sync/index.html?search=alloc%3A%3Async%3A%3AArc"
                          },
                          {
                            "text": ": Atomically Reference-Counted pointer, which can be used",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "in multithreaded environments to prolong the lifetime of some",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "data until all the threads have finished using it.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Barrier",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/barrier/struct.Barrier.html"
                          },
                          {
                            "text": ": Ensures multiple threads will wait for each other",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "to reach a point in the program, before continuing execution all",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "together.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Condvar",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/poison/condvar/struct.Condvar.html"
                          },
                          {
                            "text": ": Condition Variable, providing the ability to block",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "a thread while waiting for an event to occur.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "mpsc",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/mpsc/index.html"
                          },
                          {
                            "text": ": Multi-producer, single-consumer queues, used for",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "message-based communication. Can provide a lightweight",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "inter-thread synchronisation mechanism, at the cost of some",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "extra memory.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "mpmc",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/mpmc/index.html"
                          },
                          {
                            "text": ": Multi-producer, multi-consumer queues, used for",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "message-based communication. Can provide a lightweight",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "inter-thread synchronisation mechanism, at the cost of some",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "extra memory.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Mutex",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/poison/mutex/struct.Mutex.html"
                          },
                          {
                            "text": ": Mutual Exclusion mechanism, which ensures that at",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "most one thread at a time is able to access some data.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Once",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/once/struct.Once.html"
                          },
                          {
                            "text": ": Used for a thread-safe, one-time global initialization routine.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "Mostly useful for implementing other types like ",
                            "style": "Plain"
                          },
                          {
                            "text": "OnceLock",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/once_lock/struct.OnceLock.html"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "OnceLock",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/once_lock/struct.OnceLock.html"
                          },
                          {
                            "text": ": Used for thread-safe, one-time initialization of a",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "variable, with potentially different initializers based on the caller.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "LazyLock",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/lazy_lock/struct.LazyLock.html"
                          },
                          {
                            "text": ": Used for thread-safe, one-time initialization of a",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "variable, using one nullary initializer function provided at creation.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "RwLock",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/sync/poison/rwlock/struct.RwLock.html"
                          },
                          {
                            "text": ": Provides a mutual exclusion mechanism which allows",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "multiple readers at the same time, while allowing only one",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "writer at a time. In some cases, this can be more efficient than",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "a mutex.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "time",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/time/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Temporal quantification.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are multiple ways to create a new ",
                    "style": "Plain"
                  },
                  {
                    "text": "Duration",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/time/index.html?search=core%3A%3Atime%3A%3ADuration"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let five_seconds = Duration::from_secs(5);\nassert_eq!(five_seconds, Duration::from_millis(5_000));\nassert_eq!(five_seconds, Duration::from_micros(5_000_000));\nassert_eq!(five_seconds, Duration::from_nanos(5_000_000_000));\n\nlet ten_seconds = Duration::from_secs(10);\nlet seven_nanos = Duration::from_nanos(7);\nlet total = ten_seconds + seven_nanos;\nassert_eq!(total, Duration::new(10, 7));"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Using ",
                    "style": "Plain"
                  },
                  {
                    "text": "Instant",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/time/struct.Instant.html"
                  },
                  {
                    "text": " to calculate how long a function took to run:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "ignore (incomplete)",
                "code": "let now = Instant::now();\n\n// Calling a slow function, it may take a while\nslow_function();\n\nlet elapsed_time = now.elapsed();\nprintln!(\"Running slow_function() took {} seconds.\", elapsed_time.as_secs());\n"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "simd",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/simd/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Portable SIMD module.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module offers a portable abstraction for SIMD operations",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that is not bound to any particular hardware architecture.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "What is \"portable\"?",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module provides a SIMD implementation that is fast and predictable on any target.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Portable SIMD works on every target",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unlike target-specific SIMD in ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::arch",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", portable SIMD compiles for every target.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "In this regard, it is just like \"regular\" Rust.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Portable SIMD is consistent between targets",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A program using portable SIMD can expect identical behavior on any target.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "In most regards, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Simd<T, N>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/core_simd/vector/index.html?search=core%3A%3Acore%5Fsimd%3A%3Avector%3A%3ASimd"
                  },
                  {
                    "text": " can be thought of as a parallelized ",
                    "style": "Plain"
                  },
                  {
                    "text": "[T; N]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and operates like a sequence of ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This has one notable exception: a handful of older architectures (e.g. ",
                    "style": "Plain"
                  },
                  {
                    "text": "armv7",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "powerpc",
                    "style": "InlineCode"
                  },
                  {
                    "text": ") flush ",
                    "style": "Plain"
                  },
                  {
                    "text": "subnormal",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values to zero.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "On these architectures, subnormal ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " input values are replaced with zeros, and any operation producing subnormal ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values produces zeros instead.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This doesn't affect most architectures or programs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Operations use the best instructions available",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Operations provided by this module compile to the best available SIMD instructions.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Portable SIMD is not a low-level vendor library, and operations in portable SIMD ",
                    "style": "Plain"
                  },
                  {
                    "text": "do not",
                    "style": "Emphasis"
                  },
                  {
                    "text": " necessarily map to a single instruction.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Instead, they map to a reasonable implementation of the operation for the target.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Consistency between targets is not compromised to use faster or fewer instructions.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "In some cases, ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::arch",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will provide a faster function that has slightly different behavior than the ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::simd",
                    "style": "InlineCode"
                  },
                  {
                    "text": " equivalent.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "For example, ",
                    "style": "Plain"
                  },
                  {
                    "text": "_mm_min_ps",
                    "style": "InlineCode"
                  },
                  {
                    "text": "^1",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%5E1"
                  },
                  {
                    "text": " can be slightly faster than ",
                    "style": "Plain"
                  },
                  {
                    "text": "SimdFloat::simd_min",
                    "style": "InlineCode",
                    "url": "https://docs.rs/`num/latest/`num/SimdFloat/index.html?search=%60num%3A%3ASimdFloat%3A%3Asimd%5Fmin%60"
                  },
                  {
                    "text": ", but does not conform to the IEEE standard also used by ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32::min",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "When necessary, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Simd<T, N>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/core_simd/vector/index.html?search=core%3A%3Acore%5Fsimd%3A%3Avector%3A%3ASimd"
                  },
                  {
                    "text": " can be converted to the types provided by ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::arch",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to make use of target-specific functions.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Many targets simply don't have SIMD, or don't support SIMD for a particular element type.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "In those cases, regular scalar operations are generated instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "^1",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%5E1"
                  },
                  {
                    "text": ": ",
                    "style": "Plain"
                  },
                  {
                    "text": "_mm_min_ps(x, y)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is equivalent to ",
                    "style": "Plain"
                  },
                  {
                    "text": "x.simd_lt(y).select(x, y)",
                    "style": "InlineCode"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "autodiff",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/autodiff/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module provides support for automatic differentiation. For precise information on",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "differences between the ",
                    "style": "Plain"
                  },
                  {
                    "text": "autodiff_forward",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "autodiff_reverse",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macros and how to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "use them, see their respective documentation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "General usage",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Autodiff macros can be applied to almost all function definitions, see below for examples.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "They can be applied to functions accepting structs, arrays, slices, vectors, tuples, and more.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It is possible to apply multiple autodiff macros to the same function. As an example, this can",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be helpful to compute the partial derivatives with respect to ",
                    "style": "Plain"
                  },
                  {
                    "text": "x",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "y",
                    "style": "InlineCode"
                  },
                  {
                    "text": " independently:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[autodiff_forward(dsquare1, Dual, Const, Dual)]\n#[autodiff_forward(dsquare2, Const, Dual, Dual)]\n#[autodiff_forward(dsquare3, Active, Active, Active)]\nfn square(x: f64, y: f64) -> f64 {\n  x * x + 2.0 * y\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "We also support autodiff on functions with generic parameters:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[autodiff_forward(generic_derivative, Duplicated, Active)]\nfn generic_f<T: std::ops::Mul<Output = T> + Copy>(x: &T) -> T {\n x * x\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "or applying autodiff to nested functions:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn outer(x: f64) -> f64 {\n  #[autodiff_forward(inner_derivative, Dual, Const)]\n  fn inner(y: f64) -> f64 {\n    y * y\n  }\n  inner_derivative(x, 1.0)\n}\n\nfn main() {\n    assert_eq!(outer(3.14), 6.28);\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The generated function will be available in the same scope as the function differentiated, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "have the same private/pub usability.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Traits and impls",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Autodiff macros can be used in multiple ways in combination with traits:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "struct Foo {\n    a: f64,\n}\n\ntrait MyTrait {\n    #[autodiff_reverse(df, Const, Active, Active)]\n    fn f(&self, x: f64) -> f64;\n}\n\nimpl MyTrait for Foo {\n    fn f(&self, x: f64) -> f64 {\n        x.sin()\n    }\n}\n\nfn main() {\n    let foo = Foo { a: 3.0f64 };\n    assert_eq!(foo.f(2.0), 2.0_f64.sin());\n    assert_eq!(foo.df(2.0, 1.0).1, 2.0_f64.cos());\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In this case ",
                    "style": "Plain"
                  },
                  {
                    "text": "df",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will be the default implementation provided by the library who provided the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "trait. A user implementing ",
                    "style": "Plain"
                  },
                  {
                    "text": "MyTrait",
                    "style": "InlineCode"
                  },
                  {
                    "text": " could then decide to use the default implementation of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "df",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", or overwrite it with a custom implementation as a form of \"custom derivatives\".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On the other hand, a function generated by either autodiff macro can also be used to implement a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "trait:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "struct Foo {\n    a: f64,\n}\n\ntrait MyTrait {\n    fn f(&self, x: f64) -> f64;\n    fn df(&self, x: f64, seed: f64) -> (f64, f64);\n}\n\nimpl MyTrait for Foo {\n    #[autodiff_reverse(df, Const, Active, Active)]\n    fn f(&self, x: f64) -> f64 {\n        self.a * 0.25 * (x * x - 1.0 - 2.0 * x.ln())\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Simple ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl",
                    "style": "InlineCode"
                  },
                  {
                    "text": " blocks without traits are also supported. Differentiating with respect to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implemented struct will then require the use of a \"shadow struct\" to hold the derivatives of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "struct fields:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "struct OptProblem {\n    a: f64,\n    b: f64,\n}\n\nimpl OptProblem {\n    #[autodiff_reverse(d_objective, Duplicated, Duplicated, Duplicated)]\n    fn objective(&self, x: &[f64], out: &mut f64) {\n        *out = self.a + x[0].sqrt() * self.b\n    }\n}\nfn main() {\n    let p = OptProblem { a: 1., b: 2. };\n    let mut p_shadow = OptProblem { a: 0., b: 0. };\n    let mut dx = [0.0];\n    let mut out = 0.0;\n    let mut dout = 1.0;\n\n    p.d_objective(&mut p_shadow, &x, &mut dx, &mut out, &mut dout);\n}"
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Higher-order derivatives",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Finally, it is possible to generate higher-order derivatives (e.g. Hessian) by applying an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "autodiff macro to a function that is already generated by an autodiff macro, via a thin wrapper.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The following example uses Forward mode over Reverse mode",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[autodiff_reverse(df, Duplicated, Duplicated)]\nfn f(x: &[f64;2], y: &mut f64) {\n  *y = x[0] * x[0] + x[1] * x[0]\n}\n\n#[autodiff_forward(h, Dual, Dual, Dual, Dual)]\nfn wrapper(x: &[f64;2], dx: &mut [f64;2], y: &mut f64, dy: &mut f64) {\n  df(x, dx, y, dy);\n}\n\nfn main() {\n    let mut y = 0.0;\n    let x = [2.0, 2.0];\n\n    let mut dy = 0.0;\n    let mut dx = [1.0, 0.0];\n\n    let mut bx = [0.0, 0.0];\n    let mut by = 1.0;\n    let mut dbx = [0.0, 0.0];\n    let mut dby = 0.0;\n    h(&x, &mut dx, &mut bx, &mut dbx, &mut y, &mut dy, &mut by, &mut dby);\n    assert_eq!(&dbx, [2.0, 1.0]);\n}"
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Current limitations:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Differentiating a function which accepts a ",
                            "style": "Plain"
                          },
                          {
                            "text": "dyn Trait",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is currently not supported.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Builds without ",
                            "style": "Plain"
                          },
                          {
                            "text": "lto=\"fat\"",
                            "style": "InlineCode"
                          },
                          {
                            "text": " are not yet supported.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Builds in debug mode are currently more likely to fail compilation.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "offload",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/offload/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module provides support for gpu offloading. For technical details regarding the ",
                    "style": "Plain"
                  },
                  {
                    "text": "offload_kernel",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and how to use it, see their respective documentation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "General usage",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "offload_kernel",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro can be applied to a function to generate the necessary code to launch a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "kernel on the target device.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[offload_kernel]\nfn kernel(x: *mut [f64; 256]) {\n    // SAFETY:\n    // calling our `arch` functions and dereferencing a raw pointer is unsafe\n    unsafe {\n        let n = (*x).len();\n        let i = (thread_idx_x() + block_idx_x() * block_dim_x()) as usize;\n        if i < n {\n            (*x)[i] = i as f64;\n        }\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "To launch an offloaded kernel, the only current way is to use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "core::intrinsic::offload",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "intrinsic (note that intrinsics usage is discouraged outside the standard library). This",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "allows you to specify grid and block dimensions and pass the required arguments to the device.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut x = [0.0f64; 256];\ncore::intrinsics::offload::<_, _, ()>(kernel, [256, 1, 1], [1, 1, 1], (&mut x as *mut [f64; 256],));"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For precise information on the ",
                    "style": "Plain"
                  },
                  {
                    "text": "offload",
                    "style": "InlineCode"
                  },
                  {
                    "text": " intrinsic, see its respective documentation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Current limitations:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Usage is restricted to types supported by the current device-mapping implementation.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Generics and functions accepting dyn Trait are not supported.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Kernel execution is currently restricted to intrinsics usage, which is discouraged outside of the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "standard library.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "task",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/task/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Types and Traits for working with asynchronous tasks.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "arch",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/arch/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "SIMD and vendor intrinsics module.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module is intended to be the gateway to architecture-specific",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "intrinsic functions, typically related to SIMD (but not always!). Each",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "architecture that Rust compiles to may contain a submodule here, which",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "means that this is not a portable module! If you're writing a portable",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "library take care when using these APIs!",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Under this module you'll find an architecture-named module, such as",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86_64",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Each ",
                    "style": "Plain"
                  },
                  {
                    "text": "#[cfg(target_arch)]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " that Rust can compile to may have a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "module entry here, only present on that particular target. For example the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "i686-pc-windows-msvc",
                    "style": "InlineCode"
                  },
                  {
                    "text": " target will have an ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86",
                    "style": "InlineCode"
                  },
                  {
                    "text": " module here, whereas",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86_64-pc-windows-msvc",
                    "style": "InlineCode"
                  },
                  {
                    "text": " has ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86_64",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Overview",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module exposes vendor-specific intrinsics that typically correspond to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a single machine instruction. These intrinsics are not portable: their",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "availability is architecture-dependent, and not all machines of that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "architecture might provide the intrinsic.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "arch",
                    "style": "InlineCode"
                  },
                  {
                    "text": " module is intended to be a low-level implementation detail for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "higher-level APIs. Using it correctly can be quite tricky as you need to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ensure at least a few guarantees are upheld:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The correct architecture's module is used. For example the ",
                            "style": "Plain"
                          },
                          {
                            "text": "arm",
                            "style": "InlineCode"
                          },
                          {
                            "text": " module",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "isn't available on the ",
                            "style": "Plain"
                          },
                          {
                            "text": "x86_64-unknown-linux-gnu",
                            "style": "InlineCode"
                          },
                          {
                            "text": " target. This is",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "typically done by ensuring that ",
                            "style": "Plain"
                          },
                          {
                            "text": "#[cfg]",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is used appropriately when using",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "this module.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The CPU the program is currently running on supports the function being",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "called. For example it is unsafe to call an AVX2 function on a CPU that",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "doesn't actually support AVX2.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As a result of the latter of these guarantees all intrinsics in this module",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "are ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and extra care needs to be taken when calling them!",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "CPU Feature Detection",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In order to call these APIs in a safe fashion there's a number of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "mechanisms available to ensure that the correct CPU feature is available",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to call an intrinsic. Let's consider, for example, the ",
                    "style": "Plain"
                  },
                  {
                    "text": "_mm256_add_epi64",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "intrinsics on the ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86_64",
                    "style": "InlineCode"
                  },
                  {
                    "text": " architectures. This function requires",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the AVX2 feature as ",
                    "style": "Plain"
                  },
                  {
                    "text": "documented by Intel",
                    "style": "Plain",
                    "url": "https://www.intel.com/content/www/us/en/docs/intrinsics-guide/index.html#text=_mm256_add_epi64&expand=100"
                  },
                  {
                    "text": " so to correctly call",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "this function we need to (a) guarantee we only call it on ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86",
                    "style": "InlineCode"
                  },
                  {
                    "text": "/",
                    "style": "Plain"
                  },
                  {
                    "text": "x86_64",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and (b) ensure that the CPU feature is available",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Static CPU Feature Detection",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The first option available to us is to conditionally compile code via the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "#[cfg]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " attribute. CPU features correspond to the ",
                    "style": "Plain"
                  },
                  {
                    "text": "target_feature",
                    "style": "InlineCode"
                  },
                  {
                    "text": " cfg",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "available, and can be used like so:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[cfg(\n    all(\n        any(target_arch = \"x86\", target_arch = \"x86_64\"),\n        target_feature = \"avx2\"\n    )\n)]\nfn foo() {\n    #[cfg(target_arch = \"x86\")]\n    use std::arch::x86::_mm256_add_epi64;\n    #[cfg(target_arch = \"x86_64\")]\n    use std::arch::x86_64::_mm256_add_epi64;\n\n    unsafe {\n        _mm256_add_epi64(...);\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Here we're using ",
                    "style": "Plain"
                  },
                  {
                    "text": "#[cfg(target_feature = \"avx2\")]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to conditionally compile",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "this function into our module. This means that if the ",
                    "style": "Plain"
                  },
                  {
                    "text": "avx2",
                    "style": "InlineCode"
                  },
                  {
                    "text": " feature is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "enabled statically",
                    "style": "Emphasis"
                  },
                  {
                    "text": " then we'll use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "_mm256_add_epi64",
                    "style": "InlineCode"
                  },
                  {
                    "text": " function at",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "runtime. The ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode"
                  },
                  {
                    "text": " block here can be justified through the usage of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "#[cfg]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to only compile the code in situations where the safety guarantees",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "are upheld.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Statically enabling a feature is typically done with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "-C target-feature",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "-C target-cpu",
                    "style": "InlineCode"
                  },
                  {
                    "text": " flags to the compiler. For example if",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "your local CPU supports AVX2 then you can compile the above function with:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "sh",
                "code": "$ RUSTFLAGS='-C target-cpu=native' cargo build\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Or otherwise you can specifically enable just the AVX2 feature:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "sh",
                "code": "$ RUSTFLAGS='-C target-feature=+avx2' cargo build\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that when you compile a binary with a particular feature enabled it's",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "important to ensure that you only run the binary on systems which satisfy",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the required feature set.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Dynamic CPU Feature Detection",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Sometimes statically dispatching isn't quite what you want. Instead you",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "might want to build a portable binary that runs across a variety of CPUs,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "but at runtime it selects the most optimized implementation available. This",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "allows you to build a \"least common denominator\" binary which has certain",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "sections more optimized for different CPUs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Taking our previous example from before, we're going to compile our binary",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "without",
                    "style": "Emphasis"
                  },
                  {
                    "text": " AVX2 support, but we'd like to enable it for just one function.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "We can do that in a manner like:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn foo() {\n    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n    {\n        if is_x86_feature_detected!(\"avx2\") {\n            return unsafe { foo_avx2() };\n        }\n    }\n\n    // fallback implementation without using AVX2\n}\n\n#[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n#[target_feature(enable = \"avx2\")]\nunsafe fn foo_avx2() {\n    #[cfg(target_arch = \"x86\")]\n    use std::arch::x86::_mm256_add_epi64;\n    #[cfg(target_arch = \"x86_64\")]\n    use std::arch::x86_64::_mm256_add_epi64;\n\n    unsafe { _mm256_add_epi64(...); }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There's a couple of components in play here, so let's go through them in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "detail!",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "First up we notice the ",
                            "style": "Plain"
                          },
                          {
                            "text": "is_x86_feature_detected!",
                            "style": "InlineCode"
                          },
                          {
                            "text": " macro. Provided by",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the standard library, this macro will perform necessary runtime detection",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "to determine whether the CPU the program is running on supports the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "specified feature. In this case the macro will expand to a boolean",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "expression evaluating to whether the local CPU has the AVX2 feature or",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "not.",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Note that this macro, like the ",
                            "style": "Plain"
                          },
                          {
                            "text": "arch",
                            "style": "InlineCode"
                          },
                          {
                            "text": " module, is platform-specific. For",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "example calling ",
                            "style": "Plain"
                          },
                          {
                            "text": "is_x86_feature_detected!(\"avx2\")",
                            "style": "InlineCode"
                          },
                          {
                            "text": " on ARM will be a",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "compile time error. To ensure we don't hit this error a statement level",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "#[cfg]",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is used to only compile usage of the macro on ",
                            "style": "Plain"
                          },
                          {
                            "text": "x86",
                            "style": "InlineCode"
                          },
                          {
                            "text": "/",
                            "style": "Plain"
                          },
                          {
                            "text": "x86_64",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Next up we see our AVX2-enabled function, ",
                            "style": "Plain"
                          },
                          {
                            "text": "foo_avx2",
                            "style": "InlineCode"
                          },
                          {
                            "text": ". This function is",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "decorated with the ",
                            "style": "Plain"
                          },
                          {
                            "text": "#[target_feature]",
                            "style": "InlineCode"
                          },
                          {
                            "text": " attribute which enables a CPU",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "feature for just this one function. Using a compiler flag like ",
                            "style": "Plain"
                          },
                          {
                            "text": "-C target-feature=+avx2",
                            "style": "InlineCode"
                          },
                          {
                            "text": " will enable AVX2 for the entire program, but using",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "an attribute will only enable it for the one function. Usage of the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "#[target_feature]",
                            "style": "InlineCode"
                          },
                          {
                            "text": " attribute currently requires the function to also be",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "unsafe",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", as we see here. This is because the function can only be",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "correctly called on systems which have the AVX2 (like the intrinsics",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "themselves).",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "And with all that we should have a working program! This program will run",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "across all machines and it'll use the optimized AVX2 implementation on",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "machines where support is detected.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Ergonomics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It's important to note that using the ",
                    "style": "Plain"
                  },
                  {
                    "text": "arch",
                    "style": "InlineCode"
                  },
                  {
                    "text": " module is not the easiest",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "thing in the world, so if you're curious to try it out you may want to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "brace yourself for some wordiness!",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The primary purpose of this module is to enable stable crates on crates.io",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to build up much more ergonomic abstractions which end up using SIMD under",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the hood. Over time these abstractions may also move into the standard",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "library itself, but for now this module is tasked with providing the bare",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "minimum necessary to use vendor intrinsics on stable Rust.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Other architectures",
                    "style": "Plain"
                  }
                ]
              },
              {
