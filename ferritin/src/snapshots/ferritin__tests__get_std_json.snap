                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Result",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                          },
