                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Any two ",
                            "style": "Plain"
                          },
                          {
                            "text": "fn",
                            "style": "InlineCode"
                          },
                          {
                            "text": " (function pointer) types are ABI-compatible with each other if they have the same",
                            "style": "Plain"
                          },
