                    "text": " is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the thing that will affect the behavior of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": "<",
                    "style": "Plain"
                  },
                  {
                    "text": "Box",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fboxed%2Fstruct%2EBox"
                  },
                  {
                    "text": "<T>>",
                    "style": "Plain"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Builtin types that are ",
                    "style": "Plain"
                  },
                  {
                    "text": "Unpin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Unpin.html"
                  },
                  {
                    "text": " include all of the primitive types, like ",
                    "style": "Plain"
                  },
                  {
                    "text": "bool",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.bool.html"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "i32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.i32.html"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.f32.html"
                  },
                  {
