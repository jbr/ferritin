                  },
                  {
                    "text": "two ways:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "By spawning a new thread, e.g., using the ",
                            "style": "Plain"
                          },
                          {
                            "text": "thread::spawn",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/thread/functions/fn.spawn.html"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "function, and calling ",
                            "style": "Plain"
                          },
                          {
                            "text": "thread",
