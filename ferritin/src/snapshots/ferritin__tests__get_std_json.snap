                  {
                    "text": "io::stdout",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/io/stdio/fn.stdout.html"
                  },
                  {
                    "text": ". See ",
                    "style": "Plain"
                  },
                  {
                    "text": "println!",
                    "style": "InlineCode",
