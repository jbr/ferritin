                            "url": "http://docs.rust-lang.org/nightly/std/net/tcp/struct.TcpListener.html"
                          },
                          {
                            "text": ", ",
                            "style": "Plain"
                          },
                          {
                            "text": "TcpStream",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/net/tcp/struct.TcpStream.html"
                          },
                          {
                            "text": " or ",
                            "style": "Plain"
                          },
                          {
                            "text": "UdpSocket",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/net/udp/struct.UdpSocket.html"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Other types are return or parameter types for various methods in this module",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rust disables inheritance of socket objects to child processes by default when possible.  For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example, through the use of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "CLOEXEC",
                    "style": "InlineCode"
                  },
                  {
                    "text": " flag in UNIX systems or the ",
                    "style": "Plain"
                  },
                  {
                    "text": "HANDLE_FLAG_INHERIT",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "flag on Windows.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
