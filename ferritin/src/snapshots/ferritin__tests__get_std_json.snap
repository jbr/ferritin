              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "First let's take a look at not actually using any intrinsics but instead",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "using LLVM's auto-vectorization to produce optimized vectorized code for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "AVX2 and also for the default platform.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn main() {\n    let mut dst = [0];\n    add_quickly(&[1], &[2], &mut dst);\n    assert_eq!(dst[0], 3);\n}\n\nfn add_quickly(a: &[u8], b: &[u8], c: &mut [u8]) {\n    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n    {\n        // Note that this `unsafe` block is safe because we're testing\n        // that the `avx2` feature is indeed available on our CPU.\n        if is_x86_feature_detected!(\"avx2\") {\n            return unsafe { add_quickly_avx2(a, b, c) };\n        }\n    }\n\n    add_quickly_fallback(a, b, c)\n}\n\n#[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n#[target_feature(enable = \"avx2\")]\nunsafe fn add_quickly_avx2(a: &[u8], b: &[u8], c: &mut [u8]) {\n    add_quickly_fallback(a, b, c) // the function below is inlined here\n}\n\nfn add_quickly_fallback(a: &[u8], b: &[u8], c: &mut [u8]) {\n    for ((a, b), c) in a.iter().zip(b).zip(c) {\n        *c = *a + *b;\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Next up let's take a look at an example of manually using intrinsics. Here",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "we'll be using SSE4.1 features to implement hex encoding.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn main() {\n    let mut dst = [0; 32];\n    hex_encode(b\"\\x01\\x02\\x03\", &mut dst);\n    assert_eq!(&dst[..6], b\"010203\");\n\n    let mut src = [0; 16];\n    for i in 0..16 {\n        src[i] = (i + 1) as u8;\n    }\n    hex_encode(&src, &mut dst);\n    assert_eq!(&dst, b\"0102030405060708090a0b0c0d0e0f10\");\n}\n\npub fn hex_encode(src: &[u8], dst: &mut [u8]) {\n    let len = src.len().checked_mul(2).unwrap();\n    assert!(dst.len() >= len);\n\n    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n    {\n        if is_x86_feature_detected!(\"sse4.1\") {\n            return unsafe { hex_encode_sse41(src, dst) };\n        }\n    }\n\n    hex_encode_fallback(src, dst)\n}\n\n// translated from\n// <https://github.com/Matherunner/bin2hex-sse/blob/master/base16_sse4.cpp>\n#[target_feature(enable = \"sse4.1\")]\n#[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\nunsafe fn hex_encode_sse41(mut src: &[u8], dst: &mut [u8]) {\n    #[cfg(target_arch = \"x86\")]\n    use std::arch::x86::*;\n    #[cfg(target_arch = \"x86_64\")]\n    use std::arch::x86_64::*;\n\n    unsafe {\n        let ascii_zero = _mm_set1_epi8(b'0' as i8);\n        let nines = _mm_set1_epi8(9);\n        let ascii_a = _mm_set1_epi8((b'a' - 9 - 1) as i8);\n        let and4bits = _mm_set1_epi8(0xf);\n\n        let mut i = 0_isize;\n        while src.len() >= 16 {\n            let invec = _mm_loadu_si128(src.as_ptr() as *const _);\n\n            let masked1 = _mm_and_si128(invec, and4bits);\n            let masked2 = _mm_and_si128(_mm_srli_epi64(invec, 4), and4bits);\n\n            // return 0xff corresponding to the elements > 9, or 0x00 otherwise\n            let cmpmask1 = _mm_cmpgt_epi8(masked1, nines);\n            let cmpmask2 = _mm_cmpgt_epi8(masked2, nines);\n\n            // add '0' or the offset depending on the masks\n            let masked1 = _mm_add_epi8(\n                masked1,\n                _mm_blendv_epi8(ascii_zero, ascii_a, cmpmask1),\n            );\n            let masked2 = _mm_add_epi8(\n                masked2,\n                _mm_blendv_epi8(ascii_zero, ascii_a, cmpmask2),\n            );\n\n            // interleave masked1 and masked2 bytes\n            let res1 = _mm_unpacklo_epi8(masked2, masked1);\n            let res2 = _mm_unpackhi_epi8(masked2, masked1);\n\n            _mm_storeu_si128(dst.as_mut_ptr().offset(i * 2) as *mut _, res1);\n            _mm_storeu_si128(\n                dst.as_mut_ptr().offset(i * 2 + 16) as *mut _,\n                res2,\n            );\n            src = &src[16..];\n            i += 16;\n        }\n\n        let i = i as usize;\n        hex_encode_fallback(src, &mut dst[i * 2..]);\n    }\n}\n\nfn hex_encode_fallback(src: &[u8], dst: &mut [u8]) {\n    fn hex(byte: u8) -> u8 {\n        static TABLE: &[u8] = b\"0123456789abcdef\";\n        TABLE[byte as usize]\n    }\n\n    for (byte, slots) in src.iter().zip(dst.chunks_mut(2)) {\n        slots[0] = hex((*byte >> 4) & 0xf);\n        slots[1] = hex(*byte & 0xf);\n    }\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "alloc",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/alloc/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Memory allocation APIs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In a given program, the standard library has one “global” memory allocator",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that is used for example by ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Currently the default global allocator is unspecified. Libraries, however,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "like ",
                    "style": "Plain"
                  },
                  {
                    "text": "cdylib",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s and ",
                    "style": "Plain"
                  },
                  {
                    "text": "staticlib",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s are guaranteed to use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "System",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/alloc/struct.System.html"
                  },
                  {
                    "text": " by",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "default.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "#[global_allocator]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " attribute",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This attribute allows configuring the choice of global allocator.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "You can use this to implement a completely custom global allocator",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to route all",
                    "style": "Plain"
                  },
                  {
                    "text": "^system-alloc",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%5Esystem%2Dalloc"
                  },
                  {
                    "text": " default allocation requests to a custom object.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::alloc::{GlobalAlloc, System, Layout};\n\nstruct MyAllocator;\n\nunsafe impl GlobalAlloc for MyAllocator {\n    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {\n        unsafe { System.alloc(layout) }\n    }\n\n    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {\n        unsafe { System.dealloc(ptr, layout) }\n    }\n}\n\n#[global_allocator]\nstatic GLOBAL: MyAllocator = MyAllocator;\n\nfn main() {\n    // This `Vec` will allocate memory through `GLOBAL` above\n    let mut v = Vec::new();\n    v.push(1);\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The attribute is used on a ",
                    "style": "Plain"
                  },
                  {
                    "text": "static",
                    "style": "InlineCode"
                  },
                  {
                    "text": " item whose type implements the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "GlobalAlloc",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/alloc/global/index.html?search=core%3A%3Aalloc%3A%3Aglobal%3A%3AGlobalAlloc"
                  },
                  {
                    "text": " trait. This type can be provided by an external library:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use jemallocator::Jemalloc;\n\n#[global_allocator]\nstatic GLOBAL: Jemalloc = Jemalloc;\n\nfn main() {}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "#[global_allocator]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can only be used once in a crate",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "or its recursive dependencies.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "^system-alloc",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%5Esystem%2Dalloc"
                  },
                  {
                    "text": ": Note that the Rust standard library internals may still",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "directly call ",
                    "style": "Plain"
                  },
                  {
                    "text": "System",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/alloc/struct.System.html"
                  },
                  {
                    "text": " when necessary (for example for the runtime",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "support typically required to implement a global allocator, see ",
                    "style": "Plain"
                  },
                  {
                    "text": "re-entrance",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3AGlobalAlloc"
                  },
                  {
                    "text": " on ",
                    "style": "Plain"
                  },
                  {
                    "text": "GlobalAlloc",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/alloc/global/index.html?search=core%3A%3Aalloc%3A%3Aglobal%3A%3AGlobalAlloc"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for more details).",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "from",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/from/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unstable module containing the unstable ",
                    "style": "Plain"
                  },
                  {
                    "text": "From",
                    "style": "InlineCode"
                  },
                  {
                    "text": " derive macro.",
                    "style": "Plain"
                  }
                ]
              }
            ],
