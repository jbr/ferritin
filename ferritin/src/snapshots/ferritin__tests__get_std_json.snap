                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "More signatures can be ABI-compatible on specific targets, but that should not be relied upon",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
