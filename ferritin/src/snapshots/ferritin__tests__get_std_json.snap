                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let msg = Some(\"howdy\");\n\n// Take a reference to the contained string\nif let Some(m) = &msg {\n    println!(\"{}\", *m);\n}\n\n// Remove the contained string, destroying the Option\nlet unwrapped_msg = msg.unwrap_or(\"default message\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Initialize a result to ",
                    "style": "Plain"
                  },
                  {
                    "text": "None",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " before a loop:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "enum Kingdom { Plant(u32, &'static str), Animal(u32, &'static str) }\n\n// A list of data to search through.\nlet all_the_big_things = [\n    Kingdom::Plant(250, \"redwood\"),\n    Kingdom::Plant(230, \"noble fir\"),\n    Kingdom::Plant(229, \"sugar pine\"),\n    Kingdom::Animal(25, \"blue whale\"),\n    Kingdom::Animal(19, \"fin whale\"),\n    Kingdom::Animal(15, \"north pacific right whale\"),\n];\n\n// We're going to search for the name of the biggest animal,\n// but to start with we've just got `None`.\nlet mut name_of_biggest_animal = None;\nlet mut size_of_biggest_animal = 0;\nfor big_thing in &all_the_big_things {\n    match *big_thing {\n        Kingdom::Animal(size, name) if size > size_of_biggest_animal => {\n            // Now we've found the name of some big animal\n            size_of_biggest_animal = size;\n            name_of_biggest_animal = Some(name);\n        }\n        Kingdom::Animal(..) | Kingdom::Plant(..) => ()\n    }\n}\n\nmatch name_of_biggest_animal {\n    Some(name) => println!(\"the biggest animal is {name}\"),\n    None => println!(\"there are no animals :(\"),\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "pin",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/core/pin/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Types that pin data to a location in memory.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It is sometimes useful to be able to rely upon a certain value not being able to ",
                    "style": "Plain"
                  },
                  {
                    "text": "move",
                    "style": "Emphasis"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the sense that its address in memory cannot change. This is useful especially when there",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "are one or more ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointers",
                    "style": "Emphasis",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.pointer.html"
                  },
                  {
                    "text": " pointing at that value. The ability to rely on this",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "guarantee that the value a ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointer",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.pointer.html"
                  },
                  {
                    "text": " is pointing at (its ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointee",
                    "style": "Strong"
                  },
                  {
                    "text": ") will",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Not be ",
                            "style": "Plain"
                          },
                          {
                            "text": "moved",
                            "style": "Emphasis"
                          },
                          {
                            "text": " out of its memory location",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "More generally, remain ",
                            "style": "Plain"
                          },
                          {
                            "text": "valid",
                            "style": "Emphasis"
                          },
                          {
                            "text": " at that same memory location",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "is called \"pinning.\" We would say that a value which satisfies these guarantees has been",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"pinned,\" in that it has been permanently (until the end of its lifespan) attached to its",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "location in memory, as though pinned to a pinboard. Pinning a value is an incredibly useful",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "building block for ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": " code to be able to reason about whether a raw pointer to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pinned value is still valid. ",
                    "style": "Plain"
                  },
                  {
                    "text": "As we'll see later",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                  },
                  {
                    "text": ", once a value is pinned,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "it is necessarily valid at its memory location until the end of its lifespan. This concept",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of \"pinning\" is necessary to implement safe interfaces on top of things like self-referential",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "types and intrusive data structures which cannot currently be modeled in fully safe Rust using",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "only borrow-checked ",
                    "style": "Plain"
                  },
                  {
                    "text": "references",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "\"Pinning\" allows us to put a ",
                    "style": "Plain"
                  },
                  {
                    "text": "value",
                    "style": "Emphasis"
                  },
                  {
                    "text": " which exists at some location in memory into a state where",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "safe code cannot ",
                    "style": "Plain"
                  },
                  {
                    "text": "move",
                    "style": "Emphasis"
                  },
                  {
                    "text": " that value to a different location in memory or otherwise invalidate it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "at its current location (unless it implements ",
                    "style": "Plain"
                  },
                  {
                    "text": "Unpin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Unpin.html"
                  },
                  {
                    "text": ", which we will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "talk about below",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                  },
                  {
                    "text": "). Anything that wants to interact with the pinned value in a way",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that has the potential to violate these guarantees must promise that it will not actually",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "violate them, using the ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": " keyword to mark that such a promise is upheld by the user",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and not the compiler. In this way, we can allow other ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": " code to rely on any pointers",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that point to the pinned value to be valid to dereference while it is pinned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that as long as you don't use ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": ", it's impossible to create or misuse a pinned",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "value in a way that is unsound. See the documentation of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin<Ptr>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": " for more",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "information on the practicalities of how to pin a value and how to use that pinned value from a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "user's perspective without using ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The rest of this documentation is intended to be the source of truth for users of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin<Ptr>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that are implementing the ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": " pieces of an interface that relies on pinning for validity;",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "users of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin<Ptr>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": " in safe code do not need to read it in detail.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are several sections to this documentation:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "What is \"",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          },
                          {
                            "text": "moving",
                            "style": "Emphasis",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          },
                          {
                            "text": "\"?",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "What is \"pinning\"?",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Address sensitivity, AKA \"when do we need pinning?\"",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Examples of types with address-sensitive states",
                            "style": "Plain",
                            "url": "#examples-of-address-sensitive-types"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Self-referential struct",
                                    "style": "Plain",
                                    "url": "#a-self-referential-struct"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Intrusive, doubly-linked list",
                                    "style": "Plain",
                                    "url": "#an-intrusive-doubly-linked-list"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Subtle details and the ",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          },
                          {
                            "text": "Drop",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          },
                          {
                            "text": " guarantee",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "What is \"",
                    "style": "Plain"
                  },
                  {
                    "text": "moving",
                    "style": "Emphasis"
                  },
                  {
                    "text": "\"?",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When we say a value is ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": ", we mean that the compiler copies, byte-for-byte, the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "value from one location to another. In a purely mechanical sense, this is identical to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Copy",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Copy.html"
                  },
                  {
                    "text": "ing a value from one place in memory to another. In Rust, \"move\" carries with it the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "semantics of ownership transfer from one variable to another, which is the key difference",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "between a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Copy",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Copy.html"
                  },
                  {
                    "text": " and a move. For the purposes of this module's documentation, however, when",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "we write ",
                    "style": "Plain"
                  },
                  {
                    "text": "move",
                    "style": "Emphasis"
                  },
                  {
                    "text": " in italics, we mean ",
                    "style": "Plain"
                  },
                  {
                    "text": "specifically",
                    "style": "Emphasis"
                  },
                  {
                    "text": " that the value has ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " in the mechanical",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "sense of being located at a new place in memory.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "All values in Rust are trivially ",
                    "style": "Plain"
                  },
                  {
                    "text": "moveable",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". This means that the address at which a value is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "located is not necessarily stable in between borrows. The compiler is allowed to ",
                    "style": "Plain"
                  },
                  {
                    "text": "move",
                    "style": "Emphasis"
                  },
                  {
                    "text": " a value",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to a new address without running any code to notify that value that its address",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "has changed. Although the compiler will not insert memory ",
                    "style": "Plain"
                  },
                  {
                    "text": "moves",
                    "style": "Emphasis"
                  },
                  {
                    "text": " where no semantic move has",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "occurred, there are many places where a value ",
                    "style": "Plain"
                  },
                  {
                    "text": "may",
                    "style": "Emphasis"
                  },
                  {
                    "text": " be moved. For example, when doing",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "assignment or passing a value into a function.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[derive(Default)]\nstruct AddrTracker(Option<usize>);\n\nimpl AddrTracker {\n    // If we haven't checked the addr of self yet, store the current\n    // address. If we have, confirm that the current address is the same\n    // as it was last time, or else panic.\n    fn check_for_move(&mut self) {\n        let current_addr = self as *mut Self as usize;\n        match self.0 {\n            None => self.0 = Some(current_addr),\n            Some(prev_addr) => assert_eq!(prev_addr, current_addr),\n        }\n    }\n}\n\n// Create a tracker and store the initial address\nlet mut tracker = AddrTracker::default();\ntracker.check_for_move();\n\n// Here we shadow the variable. This carries a semantic move, and may therefore also\n// come with a mechanical memory *move*\nlet mut tracker = tracker;\n\n// May panic!\n// tracker.check_for_move();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In this sense, Rust does not guarantee that ",
                    "style": "Plain"
                  },
                  {
                    "text": "check_for_move()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will never panic, because the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "compiler is permitted to ",
                    "style": "Plain"
                  },
                  {
                    "text": "move",
                    "style": "Emphasis"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "tracker",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in many situations.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Common smart-pointer types such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fboxed%2Fstruct%2EBox"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut T",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": " also allow ",
                    "style": "Plain"
                  },
                  {
                    "text": "moving",
                    "style": "Emphasis"
                  },
                  {
                    "text": " the underlying",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "value",
                    "style": "Emphasis"
                  },
                  {
                    "text": " they point at: you can move out of a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fboxed%2Fstruct%2EBox"
                  },
                  {
                    "text": ", or you can use ",
                    "style": "Plain"
                  },
                  {
                    "text": "mem::replace",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/mem/fn.replace.html"
                  },
                  {
                    "text": " to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "move a ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " out of a ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut T",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": ". Therefore, putting a value (such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "tracker",
                    "style": "InlineCode"
                  },
                  {
                    "text": " above) behind a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointer isn't enough on its own to ensure that its address does not change.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "What is \"pinning\"?",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "We say that a value has been ",
                    "style": "Plain"
                  },
                  {
                    "text": "pinned",
                    "style": "Emphasis"
                  },
                  {
                    "text": " when it has been put into a state where it is guaranteed",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to remain ",
                    "style": "Plain"
                  },
                  {
                    "text": "located at the same place in memory",
                    "style": "Emphasis"
                  },
                  {
                    "text": " from the time it is pinned until its",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "drop",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " is called.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Address-sensitive values, AKA \"when we need pinning\"",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Most values in Rust are entirely okay with being ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " around at-will.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Types for which it is ",
                    "style": "Plain"
                  },
                  {
                    "text": "always",
                    "style": "Emphasis"
                  },
                  {
                    "text": " the case that ",
                    "style": "Plain"
                  },
                  {
                    "text": "any",
                    "style": "Emphasis"
                  },
                  {
                    "text": " value of that type can be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " at-will should implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "Unpin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Unpin.html"
                  },
                  {
                    "text": ", which we will discuss more ",
                    "style": "Plain"
                  },
                  {
                    "text": "below",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aself"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Pin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": " is specifically targeted at allowing the implementation of ",
                    "style": "Plain"
                  },
                  {
                    "text": "safe interfaces",
                    "style": "Emphasis"
                  },
                  {
                    "text": " around",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "types which have some state during which they become \"address-sensitive.\" A value in such an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"address-sensitive\" state is ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Emphasis"
                  },
                  {
                    "text": " okay with being ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " around at-will. Such a value must",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "stay ",
                    "style": "Plain"
                  },
                  {
                    "text": "un-moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " and valid during the address-sensitive portion of its lifespan because some",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "interface is relying on those invariants to be true in order for its implementation to be sound.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As a motivating example of a type which may become address-sensitive, consider a type which",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "contains a pointer to another piece of its own data, ",
                    "style": "Plain"
                  },
                  {
                    "text": "i.e.",
                    "style": "Emphasis"
                  },
                  {
                    "text": " a \"self-referential\" type. In order",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for such a type to be implemented soundly, the pointer which points into ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s data must be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "proven valid whenever it is accessed. But if that value is ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": ", the pointer will still",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "point to the old address where the value was located and not into the new location of ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "thus becoming invalid. A key example of such self-referential types are the state machines",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "generated by the compiler to implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "Future",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/future/future/trait.Future.html"
                  },
                  {
                    "text": " for ",
                    "style": "Plain"
                  },
                  {
                    "text": "async fn",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Such types that have an ",
                    "style": "Plain"
                  },
                  {
                    "text": "address-sensitive",
                    "style": "Emphasis"
                  },
                  {
                    "text": " state usually follow a lifecycle",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that looks something like so:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "A value is created which can be freely moved around.",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "e.g. calling an async function which returns a state machine implementing ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "Future",
                                    "style": "InlineCode",
                                    "url": "http://docs.rust-lang.org/nightly/core/future/future/trait.Future.html"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "An operation causes the value to depend on its own address not changing",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "e.g. calling ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "poll",
                                    "style": "InlineCode",
                                    "url": "https://doc.rust-lang.org/nightly/core/"
                                  },
                                  {
                                    "text": " for the first time on the produced ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "Future",
                                    "style": "InlineCode",
                                    "url": "http://docs.rust-lang.org/nightly/core/future/future/trait.Future.html"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Further pieces of the safe interface of the type use internal ",
                            "style": "Plain"
                          },
                          {
                            "text": "unsafe",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                          },
                          {
                            "text": " operations which",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "assume that the address of the value is stable",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "e.g. subsequent calls to ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "poll",
                                    "style": "InlineCode",
                                    "url": "https://doc.rust-lang.org/nightly/core/"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Before the value is invalidated (e.g. deallocated), it is ",
                            "style": "Plain"
                          },
                          {
                            "text": "dropped",
                            "style": "Emphasis"
                          },
                          {
                            "text": ", giving it a chance to",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "notify anything with pointers to itself that those pointers will be invalidated",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "e.g. ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "drop",
                                    "style": "InlineCode",
                                    "url": "https://doc.rust-lang.org/nightly/core/"
                                  },
                                  {
                                    "text": "ping the ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "Future",
                                    "style": "InlineCode",
                                    "url": "http://docs.rust-lang.org/nightly/core/future/future/trait.Future.html"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "^pin-drop-future",
                                    "style": "Plain",
                                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%5Epin%2Ddrop%2Dfuture"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are two possible ways to ensure the invariants required for 2. and 3. above (which",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "apply to any address-sensitive type, not just self-referential types) do not get broken.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Have the value detect when it is moved and update all the pointers that point to itself.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Guarantee that the address of the value does not change (and that memory is not re-used",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "for anything else) during the time that the pointers to it are expected to be valid to",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "dereference.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Since, as we discussed, Rust can move values without notifying them that they have moved, the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "first option is ruled out.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In order to implement the second option, we must in some way enforce its key invariant,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "i.e.",
                    "style": "Emphasis"
                  },
                  {
                    "text": " prevent the value from being ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " or otherwise invalidated (you may notice this",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "sounds an awful lot like the definition of ",
                    "style": "Plain"
                  },
                  {
                    "text": "pinning",
                    "style": "Emphasis"
                  },
                  {
                    "text": " a value). There are a few ways one might",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be able to enforce this invariant in Rust:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Offer a wholly ",
                            "style": "Plain"
                          },
                          {
                            "text": "unsafe",
                            "style": "InlineCode"
                          },
                          {
                            "text": " API to interact with the object, thus requiring every caller to",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "uphold the invariant themselves",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Store the value that must not be moved behind a carefully managed pointer internal to",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the object",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Leverage the type system to encode and enforce this invariant by presenting a restricted",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "API surface to interact with ",
                            "style": "Plain"
                          },
                          {
                            "text": "any",
                            "style": "Emphasis"
                          },
                          {
                            "text": " object that requires these invariants",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The first option is quite obviously undesirable, as the ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fkeyword%2Eunsafe"
                  },
                  {
                    "text": "ty of the interface will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "become viral throughout all code that interacts with the object.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The second option is a viable solution to the problem for some use cases, in particular",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for self-referential types. Under this model, any type that has an address sensitive state",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "would ultimately store its data in something like a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fboxed%2Fstruct%2EBox"
                  },
                  {
                    "text": ", carefully manage internal",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "access to that data to ensure no ",
                    "style": "Plain"
                  },
                  {
                    "text": "moves",
                    "style": "Emphasis"
                  },
                  {
                    "text": " or other invalidation occurs, and finally",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "provide a safe interface on top.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are a couple of linked disadvantages to using this model. The most significant is that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "each individual object must assume it is ",
                    "style": "Plain"
                  },
                  {
                    "text": "on its own",
                    "style": "Emphasis"
                  },
                  {
                    "text": " to ensure",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that its data does not become ",
                    "style": "Plain"
                  },
                  {
                    "text": "moved",
                    "style": "Emphasis"
                  },
                  {
                    "text": " or otherwise invalidated. Since there is no shared",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "contract between values of different types, an object cannot assume that others interacting",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
