                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/marker/trait.Unpin.html"
                  },
                  {
                    "text": " auto-trait, which cancels the restrictive effects of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": " when the ",
