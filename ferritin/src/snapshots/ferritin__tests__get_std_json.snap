              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "format!(\"test\");                             // => \"test\"\nformat!(\"hello {}\", \"world!\");               // => \"hello world!\"\nformat!(\"x = {}, y = {val}\", 10, val = 30);  // => \"x = 10, y = 30\"\nlet (x, y) = (1, 2);\nformat!(\"{x} + {y} = 3\");                    // => \"1 + 2 = 3\""
