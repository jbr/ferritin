                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The following are the primary interfaces of the error system and the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "responsibilities they cover:",
                    "style": "Plain"
                  }
                ]
