      {
        "path": "panic",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/std/macro.panic.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics the current thread.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This allows a program to terminate immediately and provide feedback",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to the caller of the program.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro is the perfect way to assert conditions in example code and in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "tests. ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is closely tied with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "unwrap",
                    "style": "InlineCode"
                  },
                  {
                    "text": " method of both",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Option",
                    "style": "InlineCode",
                    "url": "https://docs.rs/Option/latest/Option/index.html?search=Option%3A%3Aunwrap"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode",
                    "url": "https://docs.rs/Result/latest/Result/index.html?search=Result%3A%3Aunwrap"
                  },
                  {
                    "text": " enums. Both implementations call",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " when they are set to ",
                    "style": "Plain"
                  },
                  {
                    "text": "None",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/option/Option/index.html?search=core%3A%3Aoption%3A%3AOption%3A%3ANone"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/result/Result/index.html?search=core%3A%3Aresult%3A%3AResult%3A%3AErr"
                  },
                  {
                    "text": " variants.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When using ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " you can specify a string payload that is built using",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "formatting syntax",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/../std/index.html?search=std%3A%3A%2E%2E%3A%3Astd%3A%3Afmt"
                  },
                  {
                    "text": ". That payload is used when injecting the panic into",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the calling Rust thread, causing the thread to panic entirely.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The behavior of the default ",
                    "style": "Plain"
                  },
                  {
                    "text": "std",
                    "style": "InlineCode"
                  },
                  {
                    "text": " hook, i.e. the code that runs directly",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "after the panic is invoked, is to print the message payload to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "stderr",
                    "style": "InlineCode"
                  },
                  {
                    "text": " along with the file/line/column information of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "call. You can override the panic hook using ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::panic::set_hook()",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Fpanic%2Ffn%2Eset%5Fhook"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Inside the hook a panic can be accessed as a ",
                    "style": "Plain"
                  },
                  {
                    "text": "&dyn Any + Send",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which contains either a ",
                    "style": "Plain"
                  },
                  {
                    "text": "&str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for regular ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " invocations.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(Whether a particular invocation contains the payload at type ",
                    "style": "Plain"
                  },
                  {
                    "text": "&str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is unspecified and can change.)",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "To panic with a value of another other type, ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic_any",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Fpanic%2Ffn%2Epanic%5Fany"
                  },
                  {
                    "text": " can be used.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the macro ",
                    "style": "Plain"
                  },
                  {
                    "text": "compile_error!",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Acompile%5Ferror"
                  },
                  {
                    "text": ", for raising errors during compilation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "When to use ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " vs ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The Rust language provides two complementary systems for constructing /",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "representing, reporting, propagating, reacting to, and discarding errors. These",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "responsibilities are collectively known as \"error handling.\" ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " are similar in that they are each the primary interface of their",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "respective error handling systems; however, the meaning these interfaces attach",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to their errors and the responsibilities they fulfill within their respective",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "error handling systems differ.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro is used to construct errors that represent a bug that has",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "been detected in your program. With ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " you provide a message that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "describes the bug and the language then constructs an error with that message,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "reports it, and propagates it for you.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on the other hand is used to wrap other types that represent either",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the successful result of some computation, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok(T)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", or error types that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "represent an anticipated runtime failure mode of that computation, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err(E)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is used alongside user defined types which represent the various",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "anticipated runtime failure modes that the associated computation could",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "encounter. ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " must be propagated manually, often with the help of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "?",
                    "style": "InlineCode"
                  },
                  {
                    "text": " operator and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Try",
                    "style": "InlineCode"
                  },
                  {
                    "text": " trait, and they must be reported manually, often with",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the help of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Error",
                    "style": "InlineCode"
                  },
                  {
                    "text": " trait.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For more detailed information about error handling check out the ",
                    "style": "Plain"
                  },
                  {
                    "text": "book",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fbook%2Fch09%2D00%2Derror%2Dhandling"
                  },
                  {
                    "text": " or the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::result",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/../std/index.html?search=std%3A%3A%2E%2E%3A%3Astd%3A%3Aresult"
                  },
                  {
                    "text": " module docs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Current implementation",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the main thread panics it will terminate all your threads and end your",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "program with code ",
                    "style": "Plain"
                  },
                  {
                    "text": "101",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Editions",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Behavior of the panic macros changed over editions.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "2021 and later",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In Rust 2021 and later, ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " always requires a format string and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the applicable format arguments, and is the same in ",
                    "style": "Plain"
                  },
                  {
                    "text": "core",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "std",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Use ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::panic::panic_any(x)",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Fpanic%2Ffn%2Epanic%5Fany"
                  },
                  {
                    "text": " to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic with an arbitrary payload.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "2018 and 2015",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In Rust Editions prior to 2021, ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::panic!(x)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " with a single",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "argument directly uses that argument as a payload.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This is true even if the argument is a string literal.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "For example, ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic!(\"problem: {reason}\")",
                    "style": "InlineCode"
                  },
                  {
                    "text": " panics with a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "payload of literally ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"problem: {reason}\"",
                    "style": "InlineCode"
                  },
                  {
                    "text": " (a ",
                    "style": "Plain"
                  },
                  {
                    "text": "&'static str",
                    "style": "InlineCode"
                  },
                  {
                    "text": ").",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "core::panic!(x)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " with a single argument requires that ",
                    "style": "Plain"
                  },
                  {
                    "text": "x",
                    "style": "InlineCode"
                  },
                  {
                    "text": " be ",
                    "style": "Plain"
                  },
                  {
                    "text": "&str",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "but otherwise behaves like ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::panic!",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". In particular, the string",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "need not be a literal, and is not interpreted as a format string.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "panic!();\npanic!(\"this is a terrible mistake!\");\npanic!(\"this is a {} {message}\", \"fancy\", message = \"message\");\nstd::panic::panic_any(4); // panic with the value of 4 to be collected elsewhere"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "print",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/std/macro.print.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Prints to the standard output.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Equivalent to the ",
                    "style": "Plain"
                  },
                  {
                    "text": "println!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/macro.println.html"
                  },
                  {
                    "text": " macro except that a newline is not printed at",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the end of the message.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that stdout is frequently line-buffered by default so it may be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "necessary to use ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::stdout().flush()",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " to ensure the output is emitted",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "immediately.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "print!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro will lock the standard output on each call. If you call",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "print!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " within a hot loop, this behavior may be the bottleneck of the loop.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "To avoid this, lock stdout with ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::stdout().lock()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/io/stdio/struct.Stdout.html"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::io::{stdout, Write};\n\nlet mut lock = stdout().lock();\nwrite!(lock, \"hello world\").unwrap();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Use ",
                    "style": "Plain"
                  },
                  {
                    "text": "print!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " only for the primary output of your program. Use",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "eprint!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/macro.eprint.html"
                  },
                  {
                    "text": " instead to print error and progress messages.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See the formatting documentation in ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::fmt",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Afmt"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for details of the macro argument syntax.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if writing to ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::stdout()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " fails.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Writing to non-blocking stdout can cause an error, which will lead",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "this macro to panic.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::io::{self, Write};\n\nprint!(\"this \");\nprint!(\"will \");\nprint!(\"be \");\nprint!(\"on \");\nprint!(\"the \");\nprint!(\"same \");\nprint!(\"line \");\n\nio::stdout().flush().unwrap();\n\nprint!(\"this string has a newline, why not choose println! instead?\\n\");\n\nio::stdout().flush().unwrap();"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "println",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/std/macro.println.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Prints to the standard output, with a newline.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On all platforms, the newline is the LINE FEED character (",
                    "style": "Plain"
                  },
                  {
                    "text": "\\n",
                    "style": "InlineCode"
                  },
                  {
                    "text": "/",
                    "style": "Plain"
                  },
                  {
                    "text": "U+000A",
                    "style": "InlineCode"
                  },
                  {
                    "text": ") alone",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(no additional CARRIAGE RETURN (",
                    "style": "Plain"
                  },
                  {
                    "text": "\\r",
                    "style": "InlineCode"
                  },
                  {
                    "text": "/",
                    "style": "Plain"
                  },
                  {
                    "text": "U+000D",
                    "style": "InlineCode"
                  },
                  {
                    "text": ")).",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro uses the same syntax as ",
                    "style": "Plain"
                  },
                  {
                    "text": "format!",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Aformat"
                  },
                  {
                    "text": ", but writes to the standard output instead.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "See ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::fmt",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Afmt"
                  },
                  {
                    "text": " for more information.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "println!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro will lock the standard output on each call. If you call",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "println!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " within a hot loop, this behavior may be the bottleneck of the loop.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "To avoid this, lock stdout with ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::stdout().lock()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/io/stdio/struct.Stdout.html"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::io::{stdout, Write};\n\nlet mut lock = stdout().lock();\nwriteln!(lock, \"hello world\").unwrap();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Use ",
                    "style": "Plain"
                  },
                  {
                    "text": "println!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " only for the primary output of your program. Use",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "eprintln!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/macro.eprintln.html"
                  },
                  {
                    "text": " instead to print error and progress messages.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See the formatting documentation in ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::fmt",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Afmt"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for details of the macro argument syntax.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if writing to ",
                    "style": "Plain"
                  },
                  {
                    "text": "io::stdout",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/io/stdio/fn.stdout.html"
                  },
                  {
                    "text": " fails.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Writing to non-blocking stdout can cause an error, which will lead",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "this macro to panic.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "println!(); // prints just a newline\nprintln!(\"hello there!\");\nprintln!(\"format {} arguments\", \"some\");\nlet local_variable = \"some\";\nprintln!(\"format {local_variable} arguments\");"
              }
