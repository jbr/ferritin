              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "format_args!",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3A%2E%2F%2E%2E%2Fstd%2Fmacro%2Eformat%5Fargs"
