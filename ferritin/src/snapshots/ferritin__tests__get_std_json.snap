                            "text": " for it",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "will allow your collection to be used with the ",
                            "style": "Plain"
                          },
                          {
                            "text": "for",
                            "style": "InlineCode"
                          },
                          {
                            "text": " loop.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Iterating by reference",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Since ",
                    "style": "Plain"
                  },
                  {
                    "text": "into_iter()",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " takes ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": " by value, using a ",
                    "style": "Plain"
                  },
                  {
                    "text": "for",
                    "style": "InlineCode"
                  },
                  {
                    "text": " loop to iterate",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "over a collection consumes that collection. Often, you may want to iterate",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "over a collection without consuming it. Many collections offer methods that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "provide iterators over references, conventionally called ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter_mut()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " respectively:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut values = vec![41];\nfor x in values.iter_mut() {\n    *x += 1;\n}\nfor x in values.iter() {\n    assert_eq!(*x, 42);\n}\nassert_eq!(values.len(), 1); // `values` is still owned by this function."
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If a collection type ",
                    "style": "Plain"
                  },
                  {
                    "text": "C",
                    "style": "InlineCode"
                  },
                  {
                    "text": " provides ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", it usually also implements",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "IntoIterator",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for ",
                    "style": "Plain"
                  },
                  {
                    "text": "&C",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", with an implementation that just calls ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Likewise, a collection ",
                    "style": "Plain"
                  },
                  {
                    "text": "C",
                    "style": "InlineCode"
                  },
                  {
                    "text": " that provides ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter_mut()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " generally implements",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "IntoIterator",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut C",
                    "style": "InlineCode"
                  },
                  {
                    "text": " by delegating to ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter_mut()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". This enables a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "convenient shorthand:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut values = vec![41];\nfor x in &mut values {\n    //   ^ same as `values.iter_mut()`\n    *x += 1;\n}\nfor x in &values {\n    //   ^ same as `values.iter()`\n    assert_eq!(*x, 42);\n}\nassert_eq!(values.len(), 1);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "While many collections offer ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", not all offer ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter_mut()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example, mutating the keys of a ",
                    "style": "Plain"
                  },
                  {
                    "text": "HashSet<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fcollections%2Fstruct%2EHashSet"
                  },
                  {
                    "text": " could put the collection",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "into an inconsistent state if the key hashes change, so this collection",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "only offers ",
                    "style": "Plain"
                  },
                  {
                    "text": "iter()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Adapters",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Functions which take an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Iterator",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/iter/traits/iterator/trait.Iterator.html"
                  },
                  {
                    "text": " and return another ",
                    "style": "Plain"
                  },
                  {
                    "text": "Iterator",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/iter/traits/iterator/trait.Iterator.html"
                  },
                  {
                    "text": " are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "often called 'iterator adapters', as they're a form of the 'adapter",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pattern'.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Common iterator adapters include ",
                    "style": "Plain"
                  },
                  {
                    "text": "map",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "take",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ", and ",
                    "style": "Plain"
                  },
                  {
                    "text": "filter",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "For more, see their documentation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If an iterator adapter panics, the iterator will be in an unspecified (but",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "memory safe) state.  This state is also not guaranteed to stay the same",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "across versions of Rust, so you should avoid relying on the exact values",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "returned by an iterator which panicked.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Laziness",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Iterators (and iterator ",
                    "style": "Plain"
                  },
                  {
                    "text": "adapters",
                    "style": "Plain",
                    "url": "#adapters"
                  },
                  {
                    "text": ") are ",
                    "style": "Plain"
                  },
                  {
                    "text": "lazy",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". This means that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "just creating an iterator doesn't ",
                    "style": "Plain"
                  },
                  {
                    "text": "do",
                    "style": "Emphasis"
                  },
                  {
                    "text": " a whole lot. Nothing really happens",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "until you call ",
                    "style": "Plain"
                  },
                  {
                    "text": "next",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ". This is sometimes a source of confusion when",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "creating an iterator solely for its side effects. For example, the ",
                    "style": "Plain"
                  },
                  {
                    "text": "map",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "method calls a closure on each element it iterates over:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = vec![1, 2, 3, 4, 5];\nv.iter().map(|x| println!(\"{x}\"));"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This will not print any values, as we only created an iterator, rather than",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "using it. The compiler will warn us about this kind of behavior:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "text",
                "code": "warning: unused result that must be used: iterators are lazy and\ndo nothing unless consumed\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The idiomatic way to write a ",
                    "style": "Plain"
                  },
                  {
                    "text": "map",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " for its side effects is to use a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for",
                    "style": "InlineCode"
                  },
                  {
                    "text": " loop or call the ",
                    "style": "Plain"
                  },
                  {
                    "text": "for_each",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " method:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = vec![1, 2, 3, 4, 5];\n\nv.iter().for_each(|x| println!(\"{x}\"));\n// or\nfor x in &v {\n    println!(\"{x}\");\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Another common way to evaluate an iterator is to use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "collect",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "method to produce a new collection.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Infinity",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Iterators do not have to be finite. As an example, an open-ended range is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "an infinite iterator:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let numbers = 0..;"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It is common to use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "take",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " iterator adapter to turn an infinite",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "iterator into a finite one:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let numbers = 0..;\nlet five_numbers = numbers.take(5);\n\nfor number in five_numbers {\n    println!(\"{number}\");\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This will print the numbers ",
                    "style": "Plain"
                  },
                  {
                    "text": "0",
                    "style": "InlineCode"
                  },
                  {
                    "text": " through ",
                    "style": "Plain"
                  },
                  {
                    "text": "4",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", each on their own line.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Bear in mind that methods on infinite iterators, even those for which a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "result can be determined mathematically in finite time, might not terminate.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Specifically, methods such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "min",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": ", which in the general case require",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "traversing every element in the iterator, are likely not to return",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "successfully for any infinite iterators.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let ones = std::iter::repeat(1);\nlet least = ones.min().unwrap(); // Oh no! An infinite loop!\n// `ones.min()` causes an infinite loop, so we won't reach this point!\nprintln!(\"The smallest number one is {least}.\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "marker",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/core/marker/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Primitive traits and types representing basic properties of types.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rust types can be classified in various useful ways according to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "their intrinsic properties. These classifications are represented",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as traits.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
