                  },
                  {
                    "text": "by the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Write",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fio%2Ftrait%2EWrite"
                  },
                  {
                    "text": " trait:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::io;\n\ntrait Write {\n    fn write_all(&mut self, bytes: &[u8]) -> Result<(), io::Error>;\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note: The actual definition of ",
                    "style": "Emphasis"
                  },
                  {
                    "text": "Write",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fio%2Ftrait%2EWrite"
                  },
                  {
                    "text": " uses ",
