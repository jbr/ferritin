              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "*const T",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", ",
                            "style": "Plain"
                          },
                          {
                            "text": "*mut T",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", ",
                            "style": "Plain"
                          },
                          {
                            "text": "&T",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", ",
