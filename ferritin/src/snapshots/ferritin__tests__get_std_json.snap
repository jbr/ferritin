                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Converting Errors into Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The panic and error systems are not entirely distinct. Often times errors",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that are anticipated runtime failures in an API might instead represent bugs",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to a caller. For these situations the standard library provides APIs for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "constructing panics with an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Error",
                    "style": "InlineCode"
                  },
                  {
                    "text": " as its source.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Result::unwrap",
                            "style": "InlineCode",
                            "url": "https://docs.rs/Result/latest/Result/index.html?search=Result%3A%3Aunwrap"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Result::expect",
                            "style": "InlineCode",
                            "url": "https://docs.rs/Result/latest/Result/index.html?search=Result%3A%3Aexpect"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "These functions are equivalent, they either return the inner value if the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or panic if the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err",
                    "style": "InlineCode"
                  },
                  {
                    "text": " printing the inner error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as the source. The only difference between them is that with ",
                    "style": "Plain"
                  },
                  {
                    "text": "expect",
                    "style": "InlineCode"
                  },
                  {
                    "text": " you",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "provide a panic error message to be printed alongside the source, whereas",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "unwrap",
                    "style": "InlineCode"
                  },
                  {
                    "text": " has a default message indicating only that you unwrapped an ",
                    "style": "Plain"
                  },
                  {
                    "text": "Err",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Of the two, ",
                    "style": "Plain"
                  },
                  {
                    "text": "expect",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is generally preferred since its ",
                    "style": "Plain"
                  },
                  {
                    "text": "msg",
                    "style": "InlineCode"
                  },
                  {
                    "text": " field allows you",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to convey your intent and assumptions which makes tracking down the source",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of a panic easier. ",
                    "style": "Plain"
                  },
                  {
                    "text": "unwrap",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on the other hand can still be a good fit in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "situations where you can trivially show that a piece of code will never",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "panic, such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"127.0.0.1\".parse::<std::net::IpAddr>().unwrap()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or early",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "prototyping.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Common Message Styles",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are two common styles for how people word ",
                    "style": "Plain"
                  },
                  {
                    "text": "expect",
                    "style": "InlineCode"
                  },
                  {
                    "text": " messages. Using",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the message to present information to users encountering a panic",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(\"expect as error message\") or using the message to present information",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to developers debugging the panic (\"expect as precondition\").",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In the former case the expect message is used to describe the error that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "has occurred which is considered a bug. Consider the following example:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// Read environment variable, panic if it is not present\nlet path = std::env::var(\"IMPORTANT_PATH\").unwrap();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In the \"expect as error message\" style we would use expect to describe",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that the environment variable was not set when it should have been:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let path = std::env::var(\"IMPORTANT_PATH\")\n    .expect(\"env variable `IMPORTANT_PATH` is not set\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In the \"expect as precondition\" style, we would instead describe the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "reason we ",
                    "style": "Plain"
                  },
                  {
                    "text": "expect",
                    "style": "Emphasis"
                  },
                  {
                    "text": " the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Result",
                    "style": "InlineCode"
                  },
                  {
                    "text": " should be ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". With this style we would",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "prefer to write:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let path = std::env::var(\"IMPORTANT_PATH\")\n    .expect(\"env variable `IMPORTANT_PATH` should be set by `wrapper_script.sh`\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The \"expect as error message\" style does not work as well with the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "default output of the std panic hooks, and often ends up repeating",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "information that is already communicated by the source error being",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "unwrapped:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "text",
                "code": "thread 'main' panicked at src/main.rs:4:6:\nenv variable `IMPORTANT_PATH` is not set: NotPresent\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In this example we end up mentioning that an env variable is not set,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "followed by our source message that says the env is not present, the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "only additional information we're communicating is the name of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "environment variable being checked.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The \"expect as precondition\" style instead focuses on source code",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "readability, making it easier to understand what must have gone wrong in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "situations where panics are being used to represent bugs exclusively.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Also, by framing our expect in terms of what \"SHOULD\" have happened to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "prevent the source error, we end up introducing new information that is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "independent from our source error.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "text",
                "code": "thread 'main' panicked at src/main.rs:4:6:\nenv variable `IMPORTANT_PATH` should be set by `wrapper_script.sh`: NotPresent\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In this example we are communicating not only the name of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "environment variable that should have been set, but also an explanation",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for why it should have been set, and we let the source error display as",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a clear contradiction to our expectation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Hint",
                    "style": "Strong"
                  },
                  {
                    "text": ": If you're having trouble remembering how to phrase",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "expect-as-precondition style error messages remember to focus on the word",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"should\" as in \"env variable should be set by blah\" or \"the given binary",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "should be available and executable by the current user\".",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "ffi",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/ffi/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Utilities related to FFI bindings.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module provides utilities to handle data across non-Rust",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "interfaces, like other programming languages and the underlying",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "operating system. It is mainly of use for FFI (Foreign Function",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Interface) bindings and code that needs to exchange C-like strings",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "with other languages.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Overview",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rust represents owned strings with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/string/index.html?search=alloc%3A%3Astring%3A%3AString"
                  },
                  {
                    "text": " type, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "borrowed slices of strings with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.str.html"
                  },
                  {
                    "text": " primitive. Both are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "always in UTF-8 encoding, and may contain nul bytes in the middle,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "i.e., if you look at the bytes that make up the string, there may",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be a ",
                    "style": "Plain"
                  },
                  {
                    "text": "\\0",
                    "style": "InlineCode"
                  },
                  {
                    "text": " among them. Both ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " store their length",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "explicitly; there are no nul terminators at the end of strings",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "like in C.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "C strings are different from Rust strings:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Encodings",
                            "style": "Strong"
                          },
                          {
                            "text": " - Rust strings are UTF-8, but C strings may use",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "other encodings. If you are using a string from C, you should",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "check its encoding explicitly, rather than just assuming that it",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "is UTF-8 like you can do in Rust.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Character size",
                            "style": "Strong"
                          },
                          {
                            "text": " - C strings may use ",
                            "style": "Plain"
                          },
                          {
                            "text": "char",
                            "style": "InlineCode"
                          },
                          {
                            "text": " or ",
                            "style": "Plain"
                          },
                          {
                            "text": "wchar_t",
                            "style": "InlineCode"
                          },
                          {
                            "text": "-sized",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "characters; please ",
                            "style": "Plain"
                          },
                          {
                            "text": "note",
                            "style": "Strong"
                          },
                          {
                            "text": " that C's ",
                            "style": "Plain"
                          },
                          {
                            "text": "char",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is different from Rust's.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "The C standard leaves the actual sizes of those types open to",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "interpretation, but defines different APIs for strings made up of",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "each character type. Rust strings are always UTF-8, so different",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "Unicode characters will be encoded in a variable number of bytes",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "each. The Rust type ",
                            "style": "Plain"
                          },
                          {
                            "text": "char",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/primitive.char.html"
                          },
                          {
                            "text": " represents a '",
                            "style": "Plain"
                          },
                          {
                            "text": "Unicode scalar",
                            "style": "Plain",
                            "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                          },
                          {
                            "text": " ",
                            "style": "Plain",
                            "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                          },
                          {
                            "text": "value",
                            "style": "Plain",
                            "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                          },
                          {
                            "text": "', which is similar to, but not the same as, a '",
                            "style": "Plain"
                          },
                          {
                            "text": "Unicode",
                            "style": "Plain",
                            "url": "https://www.unicode.org/glossary/#code_point"
                          },
                          {
                            "text": " ",
                            "style": "Plain",
                            "url": "https://www.unicode.org/glossary/#code_point"
                          },
                          {
                            "text": "code point",
                            "style": "Plain",
                            "url": "https://www.unicode.org/glossary/#code_point"
                          },
                          {
                            "text": "'.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Nul terminators and implicit string lengths",
                            "style": "Strong"
                          },
                          {
                            "text": " - Often, C",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "strings are nul-terminated, i.e., they have a ",
                            "style": "Plain"
                          },
                          {
                            "text": "\\0",
                            "style": "InlineCode"
                          },
                          {
                            "text": " character at the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "end. The length of a string buffer is not stored, but has to be",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "calculated; to compute the length of a string, C code must",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "manually call a function like ",
                            "style": "Plain"
                          },
                          {
                            "text": "strlen()",
                            "style": "InlineCode"
                          },
                          {
                            "text": " for ",
                            "style": "Plain"
                          },
                          {
                            "text": "char",
                            "style": "InlineCode"
                          },
                          {
                            "text": "-based strings,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "or ",
                            "style": "Plain"
                          },
                          {
                            "text": "wcslen()",
                            "style": "InlineCode"
                          },
                          {
                            "text": " for ",
                            "style": "Plain"
                          },
                          {
                            "text": "wchar_t",
                            "style": "InlineCode"
                          },
                          {
                            "text": "-based ones. Those functions return",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the number of characters in the string excluding the nul",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "terminator, so the buffer length is really ",
                            "style": "Plain"
                          },
                          {
                            "text": "len+1",
                            "style": "InlineCode"
                          },
                          {
                            "text": " characters.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "Rust strings don't have a nul terminator; their length is always",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "stored and does not need to be calculated. While in Rust",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "accessing a string's length is an ",
                            "style": "Plain"
                          },
                          {
                            "text": "O",
                            "style": "Emphasis"
                          },
                          {
                            "text": "(1) operation (because the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "length is stored); in C it is an ",
                            "style": "Plain"
                          },
                          {
                            "text": "O",
                            "style": "Emphasis"
                          },
                          {
                            "text": "(",
                            "style": "Plain"
                          },
                          {
                            "text": "n",
                            "style": "Emphasis"
                          },
                          {
                            "text": ") operation because the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "length needs to be computed by scanning the string for the nul",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "terminator.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Internal nul characters",
                            "style": "Strong"
                          },
                          {
                            "text": " - When C strings have a nul",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "terminator character, this usually means that they cannot have nul",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "characters in the middle — a nul character would essentially",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "truncate the string. Rust strings ",
                            "style": "Plain"
                          },
                          {
                            "text": "can",
                            "style": "Emphasis"
                          },
                          {
                            "text": " have nul characters in",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the middle, because nul does not have to mark the end of the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "string in Rust.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Representations of non-Rust strings",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "CString",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/ffi/c_str/index.html?search=alloc%3A%3Affi%3A%3Ac%5Fstr%3A%3ACString"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "CStr",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ffi/c_str/index.html?search=core%3A%3Affi%3A%3Ac%5Fstr%3A%3ACStr"
                  },
                  {
                    "text": " are useful when you need to transfer",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "UTF-8 strings to and from languages with a C ABI, like Python.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "From Rust to C:",
                            "style": "Strong"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "CString",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/alloc/ffi/c_str/index.html?search=alloc%3A%3Affi%3A%3Ac%5Fstr%3A%3ACString"
                          },
                          {
                            "text": " represents an owned, C-friendly",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "string: it is nul-terminated, and has no internal nul characters.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "Rust code can create a ",
                            "style": "Plain"
                          },
                          {
                            "text": "CString",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/alloc/ffi/c_str/index.html?search=alloc%3A%3Affi%3A%3Ac%5Fstr%3A%3ACString"
                          },
                          {
                            "text": " out of a normal string (provided",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "that the string doesn't have nul characters in the middle), and",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "then use a variety of methods to obtain a raw ",
                            "style": "Plain"
                          },
                          {
                            "text": "*mut ",
                            "style": "Plain"
                          },
                          {
                            "text": "u8",
                            "style": "Plain",
                            "url": "http://docs.rust-lang.org/nightly/std/primitive.u8.html"
                          },
                          {
                            "text": " that can",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "then be passed as an argument to functions which use the C",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "conventions for strings.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "From C to Rust:",
                            "style": "Strong"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "CStr",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/ffi/c_str/index.html?search=core%3A%3Affi%3A%3Ac%5Fstr%3A%3ACStr"
                          },
                          {
                            "text": " represents a borrowed C string; it",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "is what you would use to wrap a raw ",
                            "style": "Plain"
                          },
                          {
                            "text": "*const ",
                            "style": "Plain"
                          },
                          {
                            "text": "u8",
                            "style": "Plain",
                            "url": "http://docs.rust-lang.org/nightly/std/primitive.u8.html"
                          },
                          {
                            "text": " that you got from",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "a C function. A ",
                            "style": "Plain"
                          },
                          {
                            "text": "CStr",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/ffi/c_str/index.html?search=core%3A%3Affi%3A%3Ac%5Fstr%3A%3ACStr"
                          },
                          {
                            "text": " is guaranteed to be a nul-terminated array",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "of bytes. Once you have a ",
                            "style": "Plain"
                          },
                          {
                            "text": "CStr",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/ffi/c_str/index.html?search=core%3A%3Affi%3A%3Ac%5Fstr%3A%3ACStr"
                          },
                          {
                            "text": ", you can convert it to a Rust",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "&",
                            "style": "Plain"
                          },
                          {
                            "text": "str",
                            "style": "Plain",
                            "url": "http://docs.rust-lang.org/nightly/std/primitive.str.html"
                          },
                          {
                            "text": " if it's valid UTF-8, or lossily convert it by adding",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "replacement characters.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "OsString",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                  },
                  {
                    "text": " are useful when you need to transfer",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "strings to and from the operating system itself, or when capturing",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the output of external commands. Conversions between ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsString",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                  },
                  {
                    "text": " and Rust strings work similarly to those for ",
                    "style": "Plain"
                  },
                  {
                    "text": "CString",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/ffi/c_str/index.html?search=alloc%3A%3Affi%3A%3Ac%5Fstr%3A%3ACString"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and ",
                    "style": "Plain"
                  },
                  {
                    "text": "CStr",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ffi/c_str/index.html?search=core%3A%3Affi%3A%3Ac%5Fstr%3A%3ACStr"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "OsString",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                          },
                          {
                            "text": " losslessly represents an owned platform string. However, this",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "representation is not necessarily in a form native to the platform.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "In the Rust standard library, various APIs that transfer strings to/from the operating",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "system use ",
                            "style": "Plain"
                          },
                          {
                            "text": "OsString",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                          },
                          {
                            "text": " instead of plain strings. For example,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "env::var_os()",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/env/fn.var_os.html"
                          },
                          {
                            "text": " is used to query environment variables; it",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "returns an ",
                            "style": "Plain"
                          },
                          {
                            "text": "Option",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/option/index.html?search=core%3A%3Aoption%3A%3AOption"
                          },
                          {
                            "text": "<",
                            "style": "Plain"
                          },
                          {
                            "text": "OsString",
                            "style": "Plain",
                            "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                          },
                          {
                            "text": ">",
                            "style": "Plain"
                          },
                          {
                            "text": ". If the environment variable",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "exists you will get a ",
                            "style": "Plain"
                          },
                          {
                            "text": "Some",
                            "style": "Plain",
                            "url": "https://doc.rust-lang.org/nightly/core/option/Option/index.html?search=core%3A%3Aoption%3A%3AOption%3A%3ASome"
                          },
                          {
                            "text": "(os_string)",
                            "style": "Plain"
                          },
                          {
                            "text": ", which you can",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "then",
                            "style": "Emphasis"
                          },
                          {
                            "text": " try to convert to a Rust string. This yields a ",
                            "style": "Plain"
                          },
                          {
                            "text": "Result",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/result/index.html?search=core%3A%3Aresult%3A%3AResult"
                          },
                          {
                            "text": ", so that",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "your code can detect errors in case the environment variable did",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "not in fact contain valid Unicode data.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "OsStr",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                          },
                          {
                            "text": " losslessly represents a borrowed reference to a platform string.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "However, this representation is not necessarily in a form native to the platform.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "It can be converted into a UTF-8 Rust string slice in a similar way to",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "OsString",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Conversions",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "On Unix",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On Unix, ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                  },
                  {
                    "text": " implements the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::os::unix::ffi::",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStrExt",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/os/unix/ffi/os_str/trait.OsStrExt.html"
                  },
                  {
                    "text": " trait, which",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "augments it with two methods, ",
                    "style": "Plain"
                  },
                  {
                    "text": "from_bytes",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "as_bytes",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "These do inexpensive conversions from and to byte slices.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Additionally, on Unix ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsString",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                  },
                  {
                    "text": " implements the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::os::unix::ffi::",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStringExt",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/os/unix/ffi/os_str/trait.OsStringExt.html"
                  },
                  {
                    "text": " trait,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which provides ",
                    "style": "Plain"
                  },
                  {
                    "text": "from_vec",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "into_vec",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " methods that consume",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "their arguments, and take or produce vectors of ",
                    "style": "Plain"
                  },
                  {
                    "text": "u8",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.u8.html"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "On Windows",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "An ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                  },
                  {
                    "text": " can be losslessly converted to a native Windows string. And",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a native Windows string can be losslessly converted to an ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsString",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On Windows, ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                  },
                  {
                    "text": " implements the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
