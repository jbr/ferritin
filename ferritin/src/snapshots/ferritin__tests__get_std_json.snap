                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "null",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ptr/index.html?search=core%3A%3Aptr%3A%3Anull"
                  },
                  {
