              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn foo(x: Option<i32>) {\n    match x {\n        Some(n) if n >= 0 => println!(\"Some(Non-negative)\"),\n        Some(n) if n <  0 => println!(\"Some(Negative)\"),\n        Some(_)           => unreachable!(), // compile error if commented out\n        None              => println!(\"None\")\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Iterators:",
                    "style": "Plain"
