                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This method doesn't produce a value, but the write may",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "fail. It's crucial to handle the error case, and ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Emphasis"
                  },
                  {
                    "text": " write",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "something like this:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::fs::File;\nuse std::io::prelude::*;\n\nlet mut file = File::create(\"valuable_data.txt\").unwrap();\n// If `write_all` errors, then we'll never know, because the return\n// value is ignored.\nfile.write_all(b\"important message\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If you ",
                    "style": "Plain"
                  },
                  {
                    "text": "do",
                    "style": "Emphasis"
                  },
                  {
                    "text": " write that in Rust, the compiler will give you a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "warning (by default, controlled by the ",
                    "style": "Plain"
                  },
                  {
                    "text": "unused_must_use",
                    "style": "InlineCode"
