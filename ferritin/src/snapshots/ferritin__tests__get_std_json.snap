                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "iter()",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", which iterates over ",
                            "style": "Plain"
                          },
                          {
                            "text": "&T",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
