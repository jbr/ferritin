                          },
                          {
                            "text": " represents socket addresses of either IPv4 or IPv6; ",
                            "style": "Plain"
                          },
                          {
                            "text": "SocketAddrV4",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/net/socket_addr/index.html?search=core%3A%3Anet%3A%3Asocket%5Faddr%3A%3ASocketAddrV4"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "and ",
