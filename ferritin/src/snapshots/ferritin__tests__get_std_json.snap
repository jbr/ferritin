                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "iter_mut()",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", which iterates over ",
                            "style": "Plain"
                          },
                          {
                            "text": "&mut T",
