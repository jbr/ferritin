                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Send",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/marker/index.html?search=core%3A%3Amarker%3A%3ASend"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Sync",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/marker/index.html?search=core%3A%3Amarker%3A%3ASync"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Unpin",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/marker/index.html?search=core%3A%3Amarker%3A%3AUnpin"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "UnwindSafe",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/panic/unwind_safe/index.html?search=core%3A%3Apanic%3A%3Aunwind%5Fsafe%3A%3AUnwindSafe"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "RefUnwindSafe",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/panic/unwind_safe/index.html?search=core%3A%3Apanic%3A%3Aunwind%5Fsafe%3A%3ARefUnwindSafe"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Basic usage:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let tuple = (\"hello\", 5, 'c');\n\nassert_eq!(tuple.0, \"hello\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tuples are often used as a return type when you want to return more than",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "one value:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn calculate_point() -> (i32, i32) {\n    // Don't do a calculation, that's not the point of the example\n    (4, 5)\n}\n\nlet point = calculate_point();\n\nassert_eq!(point.0, 4);\nassert_eq!(point.1, 5);\n\n// Combining this with patterns can be nicer.\n\nlet (x, y) = calculate_point();\n\nassert_eq!(x, 4);\nassert_eq!(y, 5);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Homogeneous tuples can be created from arrays of appropriate length:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let array: [u32; 3] = [1, 2, 3];\nlet tuple: (u32, u32, u32) = array.into();"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "f16",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.f16.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A 16-bit floating-point type (specifically, the \"binary16\" type defined in IEEE 754-2008).",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This type is very similar to ",
                    "style": "Plain"
                  },
                  {
                    "text": "prim@f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": " but has decreased precision because it uses half as many",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "bits. Please see ",
                    "style": "Plain"
                  },
                  {
                    "text": "the documentation for ",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Wikipedia on half-precision",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Half-precision_floating-point_format"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Half-precision_floating-point_format"
                  },
                  {
                    "text": "values",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Half-precision_floating-point_format"
                  },
                  {
                    "text": " for more information.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that most common platforms will not support ",
                    "style": "Plain"
                  },
                  {
                    "text": "f16",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in hardware without enabling extra target",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "features, with the notable exception of Apple Silicon (also known as M1, M2, etc.) processors.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Hardware support on x86/x86-64 requires the avx512fp16 or avx10.1 features, while RISC-V requires",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Zfh, and Arm/AArch64 requires FEAT_FP16.  Usually the fallback implementation will be to use ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "hardware if it exists, and convert between ",
                    "style": "Plain"
                  },
                  {
                    "text": "f16",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " when performing math.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the ",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f16/index.html?search=core%3A%3Af16%3A%3Aconsts"
                  },
                  {
                    "text": "std::f16::consts",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/f16/index.html?search=core%3A%3Af16%3A%3Aconsts"
                  },
                  {
                    "text": " module",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f16/index.html?search=core%3A%3Af16%3A%3Aconsts"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "f32",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A 32-bit floating-point type (specifically, the \"binary32\" type defined in IEEE 754-2008).",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This type can represent a wide range of decimal numbers, like ",
                    "style": "Plain"
                  },
                  {
                    "text": "3.5",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "27",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "-113.75",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "0.0078125",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "34359738368",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "0",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "-1",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". So unlike integer types",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "i32",
                    "style": "InlineCode"
                  },
                  {
                    "text": "), floating-point types can represent non-integer numbers,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "too.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "However, being able to represent this wide range of numbers comes at the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "cost of precision: floats can only represent some of the real numbers and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "calculation with floats round to a nearby representable number. For example,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "5.0",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "1.0",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can be exactly represented as ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", but ",
                    "style": "Plain"
                  },
                  {
                    "text": "1.0 / 5.0",
                    "style": "InlineCode"
                  },
                  {
                    "text": " results",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in ",
                    "style": "Plain"
                  },
                  {
                    "text": "0.20000000298023223876953125",
                    "style": "InlineCode"
                  },
                  {
                    "text": " since ",
                    "style": "Plain"
                  },
                  {
                    "text": "0.2",
                    "style": "InlineCode"
                  },
                  {
                    "text": " cannot be exactly represented",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Note, however, that printing floats with ",
                    "style": "Plain"
                  },
                  {
                    "text": "println",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and friends will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "often discard insignificant digits: ",
                    "style": "Plain"
                  },
                  {
                    "text": "println!(\"{}\", 1.0f32 / 5.0f32)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "print ",
                    "style": "Plain"
                  },
                  {
                    "text": "0.2",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Additionally, ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can represent some special values:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "−0.0: IEEE 754 floating-point numbers have a bit that indicates their sign, so −0.0 is a",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "possible value. For comparison −0.0 = +0.0, but floating-point operations can carry",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the sign bit through arithmetic operations. This means −0.0 × +0.0 produces −0.0 and",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "a negative number rounded to a value smaller than a float can represent also produces −0.0.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "∞",
                            "style": "Plain",
                            "url": "#associatedconstant.INFINITY"
                          },
                          {
                            "text": " and",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "−∞",
                            "style": "Plain",
                            "url": "#associatedconstant.NEG_INFINITY"
                          },
                          {
                            "text": ": these result from calculations",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "like ",
                            "style": "Plain"
                          },
                          {
                            "text": "1.0 / 0.0",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "NaN (not a number)",
                            "style": "Plain",
                            "url": "#associatedconstant.NAN"
                          },
                          {
                            "text": ": this value results from",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "calculations like ",
                            "style": "Plain"
                          },
                          {
                            "text": "(-1.0).sqrt()",
                            "style": "InlineCode"
                          },
                          {
                            "text": ". NaN has some potentially unexpected",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "behavior:",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "It is not equal to any float, including itself! This is the reason ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "f32",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "doesn't implement the ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "Eq",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " trait.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "It is also neither smaller nor greater than any float, making it",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "impossible to sort by the default comparison operation, which is the",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "reason ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "f32",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " doesn't implement the ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "Ord",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " trait.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "It is also considered ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "infectious",
                                    "style": "Emphasis"
                                  },
                                  {
                                    "text": " as almost all calculations where one",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "of the operands is NaN will also result in NaN. The explanations on this",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "page only explicitly document behavior on NaN operands if this default",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "is deviated from.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Lastly, there are multiple bit patterns that are considered NaN.",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "Rust does not currently guarantee that the bit patterns of NaN are",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "preserved over arithmetic operations, and they are not guaranteed to be",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "portable or even fully deterministic! This means that there may be some",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "surprising results upon inspecting the bit patterns,",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "as the same calculations might produce NaNs with different bit patterns.",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "This also affects the sign of the NaN: checking ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "is_sign_positive",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " or ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "is_sign_negative",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " on",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "a NaN is the most common way to run into these surprising results.",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "(Checking ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "x >= 0.0",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " or ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "x <= 0.0",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " avoids those surprises, but also how negative/positive",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "zero are treated.)",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "See the section below for what exactly is guaranteed about the bit pattern of a NaN.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When a primitive operation (addition, subtraction, multiplication, or",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "division) is performed on this type, the result is rounded according to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "roundTiesToEven direction defined in IEEE 754-2008. That means:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The result is the representable value closest to the true value, if there",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "is a unique closest representable value.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If the true value is exactly half-way between two representable values,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the result is the one with an even least-significant binary digit.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If the true value's magnitude is ≥ ",
                            "style": "Plain"
                          },
                          {
                            "text": "f32::MAX",
                            "style": "InlineCode"
                          },
                          {
                            "text": " + 2",
                            "style": "Plain"
                          },
                          {
                            "text": "(",
                            "style": "Plain"
                          },
                          {
                            "text": "f32::MAX_EXP",
                            "style": "InlineCode"
                          },
                          {
                            "text": " −",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "f32::MANTISSA_DIGITS",
                            "style": "InlineCode"
                          },
                          {
                            "text": " − 1)",
                            "style": "Plain"
                          },
                          {
                            "text": ", the result is ∞ or −∞ (preserving the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "true value's sign).",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If the result of a sum exactly equals zero, the outcome is +0.0 unless",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "both arguments were negative, then it is -0.0. Subtraction ",
                            "style": "Plain"
                          },
                          {
                            "text": "a - b",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "regarded as a sum ",
                            "style": "Plain"
                          },
                          {
                            "text": "a + (-b)",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For more information on floating-point numbers, see ",
                    "style": "Plain"
                  },
                  {
                    "text": "Wikipedia",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Single-precision_floating-point_format"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the ",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f32/index.html?search=core%3A%3Af32%3A%3Aconsts"
                  },
                  {
                    "text": "std::f32::consts",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/f32/index.html?search=core%3A%3Af32%3A%3Aconsts"
                  },
                  {
                    "text": " module",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f32/index.html?search=core%3A%3Af32%3A%3Aconsts"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "NaN bit patterns",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This section defines the possible NaN bit patterns returned by floating-point operations.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The bit pattern of a floating-point NaN value is defined by:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "a sign bit.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "a quiet/signaling bit. Rust assumes that the quiet/signaling bit being set to ",
                            "style": "Plain"
                          },
                          {
                            "text": "1",
                            "style": "InlineCode"
                          },
                          {
                            "text": " indicates a",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "quiet NaN (QNaN), and a value of ",
                            "style": "Plain"
                          },
                          {
                            "text": "0",
                            "style": "InlineCode"
                          },
                          {
                            "text": " indicates a signaling NaN (SNaN). In the following we",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "will hence just call it the \"quiet bit\".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "a payload, which makes up the rest of the significand (i.e., the mantissa) except for the",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "quiet bit.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The rules for NaN values differ between ",
                    "style": "Plain"
                  },
                  {
                    "text": "arithmetic",
                    "style": "Emphasis"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "non-arithmetic",
                    "style": "Emphasis"
                  },
                  {
                    "text": " (or \"bitwise\")",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "operations. The non-arithmetic operations are unary ",
                    "style": "Plain"
                  },
                  {
                    "text": "-",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "abs",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "copysign",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "signum",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "{to,from}_bits",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "{to,from}_{be,le,ne}_bytes",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "is_sign_{positive,negative}",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". These",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "operations are guaranteed to exactly preserve the bit pattern of their input except for possibly",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "changing the sign bit.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The following rules apply when a NaN value is returned from an arithmetic operation:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The result has a non-deterministic sign.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The quiet bit and payload are non-deterministically chosen from",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the following set of options:",
                            "style": "Plain"
                          }
                        ]
                      },
                      {
                        "type": "list",
                        "items": [
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Preferred NaN",
                                    "style": "Strong"
                                  },
                                  {
                                    "text": ": The quiet bit is set and the payload is all-zero.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Quieting NaN propagation",
                                    "style": "Strong"
                                  },
                                  {
                                    "text": ": The quiet bit is set and the payload is copied from any input",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "operand that is a NaN. If the inputs and outputs do not have the same payload size (i.e., for",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "as",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " casts), then",
                                    "style": "Plain"
                                  }
                                ]
                              },
                              {
                                "type": "list",
                                "items": [
                                  {
                                    "content": [
                                      {
                                        "type": "paragraph",
                                        "spans": [
                                          {
                                            "text": "If the output is smaller than the input, low-order bits of the payload get dropped.",
                                            "style": "Plain"
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "content": [
                                      {
                                        "type": "paragraph",
                                        "spans": [
                                          {
                                            "text": "If the output is larger than the input, the payload gets filled up with 0s in the low-order",
                                            "style": "Plain"
                                          },
                                          {
                                            "text": " ",
                                            "style": "Plain"
                                          },
                                          {
                                            "text": "bits.",
                                            "style": "Plain"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Unchanged NaN propagation",
                                    "style": "Strong"
                                  },
                                  {
                                    "text": ": The quiet bit and payload are copied from any input operand",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "that is a NaN. If the inputs and outputs do not have the same size (i.e., for ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "as",
                                    "style": "InlineCode"
                                  },
                                  {
                                    "text": " casts), the",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "same rules as for \"quieting NaN propagation\" apply, with one caveat: if the output is smaller",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "than the input, dropping the low-order bits may result in a payload of 0; a payload of 0 is not",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "possible with a signaling NaN (the all-0 significand encodes an infinity) so unchanged NaN",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "propagation cannot occur with some inputs.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "content": [
                              {
                                "type": "paragraph",
                                "spans": [
                                  {
                                    "text": "Target-specific NaN",
                                    "style": "Strong"
                                  },
                                  {
                                    "text": ": The quiet bit is set and the payload is picked from a target-specific",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "set of \"extra\" possible NaN payloads. The set can depend on the input operand values.",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": " ",
                                    "style": "Plain"
                                  },
                                  {
                                    "text": "See the table below for the concrete NaNs this set contains on various targets.",
                                    "style": "Plain"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In particular, if all input NaNs are quiet (or if there are no input NaNs), then the output NaN",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is definitely quiet. Signaling NaN outputs can only occur if they are provided as an input",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "value. Similarly, if all input NaNs are preferred (or if there are no input NaNs) and the target",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "does not have any \"extra\" NaN payloads, then the output NaN is guaranteed to be preferred.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The non-deterministic choice happens when the operation is executed; i.e., the result of a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "NaN-producing floating-point operation is a stable bit pattern (looking at these bits multiple",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "times will yield consistent results), but running the same operation twice with the same inputs",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "can produce different results.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "These guarantees are neither stronger nor weaker than those of IEEE 754: IEEE 754 guarantees",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that an operation never returns a signaling NaN, whereas it is possible for operations like",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "SNAN * 1.0",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to return a signaling NaN in Rust. Conversely, IEEE 754 makes no statement at all",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "about which quiet NaN is returned, whereas Rust restricts the set of possible results to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ones listed above.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unless noted otherwise, the same rules also apply to NaNs returned by other library functions",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(e.g. ",
                    "style": "Plain"
                  },
                  {
                    "text": "min",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "minimum",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "max",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "maximum",
                    "style": "InlineCode"
                  },
                  {
                    "text": "); other aspects of their semantics and which IEEE 754",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "operation they correspond to are documented with the respective functions.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When an arithmetic floating-point operation is executed in ",
                    "style": "Plain"
                  },
                  {
                    "text": "const",
                    "style": "InlineCode"
                  },
                  {
                    "text": " context, the same rules",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "apply: no guarantee is made about which of the NaN bit patterns described above will be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "returned. The result does not have to match what happens when executing the same code at",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "runtime, and the result can vary depending on factors such as compiler version and flags.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Target-specific \"extra\" NaN values",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "table",
                "header": [
                  {
                    "spans": [
                      {
                        "text": "target_arch",
                        "style": "InlineCode"
                      }
                    ]
                  },
                  {
                    "spans": [
                      {
                        "text": "Extra payloads possible on this platform",
                        "style": "Plain"
                      }
                    ]
                  }
                ],
                "rows": [
                  [
                    {
                      "spans": [
                        {
                          "text": "aarch64",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "arm",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "arm64ec",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "loongarch64",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "powerpc",
                          "style": "InlineCode"
                        },
                        {
                          "text": " (except when ",
                          "style": "Plain"
                        },
                        {
                          "text": "target_abi = \"spe\"",
                          "style": "InlineCode"
                        },
                        {
                          "text": "), ",
                          "style": "Plain"
                        },
                        {
                          "text": "powerpc64",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "riscv32",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "riscv64",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "s390x",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "x86",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "x86_64",
                          "style": "InlineCode"
                        }
                      ]
                    },
                    {
                      "spans": [
                        {
                          "text": "None",
                          "style": "Plain"
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "spans": [
                        {
                          "text": "nvptx64",
                          "style": "InlineCode"
                        }
                      ]
                    },
                    {
                      "spans": [
                        {
                          "text": "All payloads",
                          "style": "Plain"
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "spans": [
                        {
                          "text": "sparc",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "sparc64",
                          "style": "InlineCode"
                        }
                      ]
                    },
                    {
                      "spans": [
                        {
                          "text": "The all-one payload",
                          "style": "Plain"
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "spans": [
                        {
                          "text": "wasm32",
                          "style": "InlineCode"
                        },
                        {
                          "text": ", ",
                          "style": "Plain"
                        },
                        {
                          "text": "wasm64",
                          "style": "InlineCode"
                        }
                      ]
                    },
                    {
                      "spans": [
                        {
                          "text": "If all input NaNs are quiet with all-zero payload: None.",
                          "style": "Plain"
                        },
                        {
                          "text": " Otherwise: all payloads.",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For targets not in this table, all payloads are possible.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Algebraic operators",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Algebraic operators of the form ",
                    "style": "Plain"
                  },
                  {
                    "text": "a.algebraic_*(b)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " allow the compiler to optimize",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "floating point operations using all the usual algebraic properties of real numbers --",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "despite the fact that those properties do ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Emphasis"
                  },
                  {
                    "text": " hold on floating point numbers.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This can give a great performance boost since it may unlock vectorization.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The exact set of optimizations is unspecified but typically allows combining operations,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "rearranging series of operations based on mathematical properties, converting between division",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and reciprocal multiplication, and disregarding the sign of zero. This means that the results of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "elementary operations may have undefined precision, and \"non-mathematical\" values",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "such as NaN, +/-Inf, or -0.0 may behave in unexpected ways, but these operations",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "will never cause undefined behavior.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Because of the unpredictable nature of compiler optimizations, the same inputs may produce",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "different results even within a single program run. ",
                    "style": "Plain"
                  },
                  {
                    "text": "Unsafe code must not rely on any property",
                    "style": "Strong"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of the return value for soundness.",
                    "style": "Strong"
                  },
                  {
                    "text": " However, implementations will generally do their best to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pick a reasonable tradeoff between performance and accuracy of the result.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For example:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "x = a.algebraic_add(b).algebraic_add(c).algebraic_add(d);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "May be rewritten as:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "x = ((a + b) + c) + d; // As written\nx = (a + c) + (b + d); // Reordered to shorten critical path and enable vectorization"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "f64",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.f64.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A 64-bit floating-point type (specifically, the \"binary64\" type defined in IEEE 754-2008).",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This type is very similar to ",
                    "style": "Plain"
                  },
                  {
                    "text": "prim@f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": ", but has increased precision by using twice as many",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "bits. Please see ",
                    "style": "Plain"
                  },
                  {
                    "text": "the documentation for ",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Wikipedia on double-precision",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Double-precision_floating-point_format"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Double-precision_floating-point_format"
                  },
                  {
                    "text": "values",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Double-precision_floating-point_format"
                  },
                  {
                    "text": " for more information.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the ",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f64/index.html?search=core%3A%3Af64%3A%3Aconsts"
                  },
                  {
                    "text": "std::f64::consts",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/f64/index.html?search=core%3A%3Af64%3A%3Aconsts"
                  },
                  {
                    "text": " module",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f64/index.html?search=core%3A%3Af64%3A%3Aconsts"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "f128",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.f128.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A 128-bit floating-point type (specifically, the \"binary128\" type defined in IEEE 754-2008).",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This type is very similar to ",
                    "style": "Plain"
                  },
                  {
                    "text": "prim@f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "prim@f64",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f64.html"
                  },
                  {
                    "text": ", but has increased precision by using twice",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as many bits as ",
                    "style": "Plain"
                  },
                  {
                    "text": "f64",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Please see ",
                    "style": "Plain"
                  },
                  {
                    "text": "the documentation for ",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.f32.html"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Wikipedia on",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Quadruple-precision_floating-point_format"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Quadruple-precision_floating-point_format"
                  },
                  {
                    "text": "quad-precision values",
                    "style": "Plain",
                    "url": "https://en.wikipedia.org/wiki/Quadruple-precision_floating-point_format"
                  },
                  {
                    "text": " for more information.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that no platforms have hardware support for ",
                    "style": "Plain"
                  },
                  {
                    "text": "f128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " without enabling target specific features,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "as for all instruction set architectures ",
                    "style": "Plain"
                  },
                  {
                    "text": "f128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is considered an optional feature.  Only Power ISA",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "(\"PowerPC\") and RISC-V (via the Q extension) specify it, and only certain microarchitectures",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "actually implement it. For x86-64 and AArch64, ISA support is not even specified, so it will always",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be a software implementation significantly slower than ",
                    "style": "Plain"
                  },
                  {
                    "text": "f64",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note: ",
                    "style": "Emphasis"
                  },
                  {
                    "text": "f128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " support is incomplete. Many platforms will not be able to link math functions. On",
                    "style": "Emphasis"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "x86 in particular, these functions do link but their results are always incorrect.",
                    "style": "Emphasis"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the ",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f128/index.html?search=core%3A%3Af128%3A%3Aconsts"
                  },
                  {
                    "text": "std::f128::consts",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/f128/index.html?search=core%3A%3Af128%3A%3Aconsts"
                  },
                  {
                    "text": " module",
                    "style": "Emphasis",
                    "url": "https://doc.rust-lang.org/nightly/core/f128/index.html?search=core%3A%3Af128%3A%3Aconsts"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
