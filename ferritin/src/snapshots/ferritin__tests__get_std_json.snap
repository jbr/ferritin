                    "text": "None",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", then this call is Undefined",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Behavior since transmuting ",
                    "style": "Plain"
                  },
