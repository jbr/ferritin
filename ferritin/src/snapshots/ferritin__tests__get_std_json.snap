                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "You must not offer any other operations that could lead to data being ",
                            "style": "Plain"
                          },
                          {
                            "text": "moved",
                            "style": "Emphasis"
                          },
                          {
                            "text": " out of",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the structural fields when your type is pinned. For example, if the struct contains an",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
