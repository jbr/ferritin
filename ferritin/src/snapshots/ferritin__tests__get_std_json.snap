      {
        "path": "isize",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.isize.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The pointer-sized signed integer type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The size of this primitive is how many bytes it takes to reference any",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "location in memory. For example, on a 32 bit target, this is 4 bytes",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and on a 64 bit target, this is 8 bytes.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
