      {
        "path": "i128",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.i128.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The 128-bit signed integer type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "ABI compatibility",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rust's ",
                    "style": "Plain"
                  },
                  {
                    "text": "i128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is expected to be ABI-compatible with C's ",
                    "style": "Plain"
                  },
                  {
                    "text": "__int128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on platforms where the type",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is available, which includes most 64-bit architectures. If any platforms that do not specify",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "__int128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " are updated to introduce it, the Rust ",
                    "style": "Plain"
                  },
                  {
                    "text": "i128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ABI on relevant targets will be changed",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to match.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It is important to note that in C, ",
                    "style": "Plain"
                  },
                  {
                    "text": "__int128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Emphasis"
                  },
                  {
                    "text": " the same as ",
                    "style": "Plain"
                  },
                  {
                    "text": "_BitInt(128)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and the two",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "types are allowed to have different ABIs. In particular, on x86, ",
                    "style": "Plain"
                  },
                  {
                    "text": "__int128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "_BitInt(128)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "do not use the same alignment. ",
                    "style": "Plain"
                  },
                  {
                    "text": "i128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is intended to always match ",
                    "style": "Plain"
                  },
                  {
                    "text": "__int128",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and does not",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "attempt to match ",
                    "style": "Plain"
                  },
                  {
                    "text": "_BitInt(128)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on platforms without ",
                    "style": "Plain"
                  },
                  {
                    "text": "__int128",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
