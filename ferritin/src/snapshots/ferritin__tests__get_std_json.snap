      {
        "path": "string",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/alloc/string/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A UTF-8–encoded, growable string.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module contains the ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html"
                  },
                  {
                    "text": " type, the ",
                    "style": "Plain"
                  },
                  {
                    "text": "ToString",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/trait.ToString.html"
                  },
                  {
                    "text": " trait for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "converting to strings, and several error types that may result from",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "working with ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html"
                  },
                  {
                    "text": "s.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are multiple ways to create a new ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html"
                  },
                  {
                    "text": " from a string literal:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let s = \"Hello\".to_string();\n\nlet s = String::from(\"world\");\nlet s: String = \"also this\".into();"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You can create a new ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html"
                  },
                  {
                    "text": " from an existing one by concatenating with",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "+",
                    "style": "InlineCode"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let s = \"Hello\".to_string();\n\nlet message = s + \" world!\";"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If you have a vector of valid UTF-8 bytes, you can make a ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html"
                  },
                  {
                    "text": " out of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "it. You can do the reverse too.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let sparkle_heart = vec![240, 159, 146, 150];\n\n// We know these bytes are valid, so we'll use `unwrap()`.\nlet sparkle_heart = String::from_utf8(sparkle_heart).unwrap();\n\nassert_eq!(\"💖\", sparkle_heart);\n\nlet bytes = sparkle_heart.into_bytes();\n\nassert_eq!(bytes, [240, 159, 146, 150]);"
              }
            ],
            "level": "SingleLine"
          }
