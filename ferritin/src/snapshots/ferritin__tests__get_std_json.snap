        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Note the documentation for the primitives ",
              "style": "Plain"
            },
            {
              "text": "str",
              "style": "InlineCode",
              "path": "std::str"
            },
            {
              "text": " and ",
