                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": " T>",
                    "style": "Plain"
                  },
                  {
                    "text": ", which in turn restricts our access.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Unpin",
