      {
        "path": "line",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.line.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Expands to the line number on which it was invoked.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "With ",
                    "style": "Plain"
                  },
                  {
                    "text": "column!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.column.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "file!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.file.html"
                  },
                  {
                    "text": ", these macros provide debugging information for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "developers about the location within the source.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The expanded expression has type ",
                    "style": "Plain"
                  },
                  {
                    "text": "u32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and is 1-based, so the first line",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in each file evaluates to 1, the second to 2, etc. This is consistent",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "with error messages by common compilers or popular editors.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The returned line is ",
                    "style": "Plain"
                  },
                  {
                    "text": "not necessarily",
                    "style": "Emphasis"
                  },
                  {
                    "text": " the line of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "line!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " invocation itself,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "but rather the first macro invocation leading up to the invocation",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "line!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let current_line = line!();\nprintln!(\"defined on line: {current_line}\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
