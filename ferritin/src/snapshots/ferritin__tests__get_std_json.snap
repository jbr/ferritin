                            "url": "http://docs.rust-lang.org/nightly/core/cell/once/struct.OnceCell.html#method.get_mut"
                          },
                          {
                            "text": ": provide a mutable reference to the inner value, only available",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "if you have a mutable reference to the cell itself.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The corresponding ",
                    "style": "Plain"
                  },
                  {
                    "text": "Sync",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fmarker%2Ftrait%2ESync"
                  },
                  {
                    "text": " version of ",
                    "style": "Plain"
                  },
                  {
                    "text": "OnceCell<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is ",
                    "style": "Plain"
                  },
                  {
                    "text": "OnceLock<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fsync%2Fstruct%2EOnceLock"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "LazyCell<T, F>",
                    "style": "InlineCode"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A common pattern with OnceCell is, for a given OnceCell, to use the same function on every",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "call to ",
                    "style": "Plain"
                  },
                  {
                    "text": "OnceCell::get_or_init",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/cell/once/struct.OnceCell.html#method.get_or_init"
                  },
                  {
                    "text": " with that cell. This is what is offered by ",
                    "style": "Plain"
                  },
                  {
                    "text": "LazyCell",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/cell/lazy/struct.LazyCell.html"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which pairs cells of ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " with functions of ",
                    "style": "Plain"
                  },
                  {
                    "text": "F",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and always calls ",
                    "style": "Plain"
                  },
                  {
                    "text": "F",
                    "style": "InlineCode"
                  },
                  {
                    "text": " before it yields ",
                    "style": "Plain"
                  },
                  {
                    "text": "&T",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This happens implicitly by simply attempting to dereference the LazyCell to get its contents,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "so its use is much more transparent with a place which has been initialized by a constant.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "More complicated patterns that don't fit this description can be built on ",
                    "style": "Plain"
                  },
                  {
                    "text": "OnceCell<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "LazyCell",
                    "style": "InlineCode"
                  },
                  {
                    "text": " works by providing an implementation of ",
                    "style": "Plain"
                  },
                  {
                    "text": "impl Deref",
                    "style": "InlineCode"
                  },
                  {
                    "text": " that calls the function,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "so you can just use it by dereference (e.g. ",
                    "style": "Plain"
                  },
                  {
                    "text": "*lazy_cell",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "lazy_cell.deref()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ").",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The corresponding ",
                    "style": "Plain"
                  },
                  {
                    "text": "Sync",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fmarker%2Ftrait%2ESync"
                  },
                  {
                    "text": " version of ",
                    "style": "Plain"
                  },
                  {
                    "text": "LazyCell<T, F>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is ",
                    "style": "Plain"
                  },
                  {
                    "text": "LazyLock<T, F>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fsync%2Fstruct%2ELazyLock"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "When to choose interior mutability",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The more common inherited mutability, where one must have unique access to mutate a value, is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "one of the key language elements that enables Rust to reason strongly about pointer aliasing,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "statically preventing crash bugs. Because of that, inherited mutability is preferred, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "interior mutability is something of a last resort. Since cell types enable mutation where it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "would otherwise be disallowed though, there are occasions when interior mutability might be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "appropriate, or even ",
                    "style": "Plain"
                  },
                  {
                    "text": "must",
                    "style": "Emphasis"
                  },
                  {
                    "text": " be used, e.g.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Introducing mutability 'inside' of something immutable",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Implementation details of logically-immutable methods.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Mutating implementations of ",
                            "style": "Plain"
                          },
                          {
                            "text": "Clone",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/core/clone/trait.Clone.html"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Introducing mutability 'inside' of something immutable",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Many shared smart pointer types, including ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Frc%2Fstruct%2ERc"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Arc<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fsync%2Fstruct%2EArc"
                  },
                  {
                    "text": ", provide containers that can",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be cloned and shared between multiple parties. Because the contained values may be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "multiply-aliased, they can only be borrowed with ",
                    "style": "Plain"
                  },
                  {
                    "text": "&",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", not ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Without cells it would be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "impossible to mutate data inside of these smart pointers at all.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It's very common then to put a ",
                    "style": "Plain"
                  },
                  {
                    "text": "RefCell<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " inside shared pointer types to reintroduce",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "mutability:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::cell::{RefCell, RefMut};\nuse std::collections::HashMap;\nuse std::rc::Rc;\n\nfn main() {\n    let shared_map: Rc<RefCell<_>> = Rc::new(RefCell::new(HashMap::new()));\n    // Create a new block to limit the scope of the dynamic borrow\n    {\n        let mut map: RefMut<'_, _> = shared_map.borrow_mut();\n        map.insert(\"africa\", 92388);\n        map.insert(\"kyoto\", 11837);\n        map.insert(\"piccadilly\", 11826);\n        map.insert(\"marbles\", 38);\n    }\n\n    // Note that if we had not let the previous borrow of the cache fall out\n    // of scope then the subsequent borrow would cause a dynamic thread panic.\n    // This is the major hazard of using `RefCell`.\n    let total: i32 = shared_map.borrow().values().sum();\n    println!(\"{total}\");\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that this example uses ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and not ",
                    "style": "Plain"
                  },
                  {
                    "text": "Arc<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". ",
                    "style": "Plain"
                  },
                  {
                    "text": "RefCell<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s are for single-threaded",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "scenarios. Consider using ",
                    "style": "Plain"
                  },
                  {
                    "text": "RwLock<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fsync%2Fstruct%2ERwLock"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Mutex<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fsync%2Fstruct%2EMutex"
                  },
                  {
                    "text": " if you need shared mutability in a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "multi-threaded situation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Implementation details of logically-immutable methods",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Occasionally it may be desirable not to expose in an API that there is mutation happening",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"under the hood\". This may be because logically the operation is immutable, but e.g., caching",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "forces the implementation to perform mutation; or because you must employ mutation to implement",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a trait method that was originally defined to take ",
                    "style": "Plain"
                  },
                  {
                    "text": "&self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::cell::OnceCell;\n\nstruct Graph {\n    edges: Vec<(i32, i32)>,\n    span_tree_cache: OnceCell<Vec<(i32, i32)>>\n}\n\nimpl Graph {\n    fn minimum_spanning_tree(&self) -> Vec<(i32, i32)> {\n        self.span_tree_cache\n            .get_or_init(|| self.calc_span_tree())\n            .clone()\n    }\n\n    fn calc_span_tree(&self) -> Vec<(i32, i32)> {\n        // Expensive computation goes here\n        vec![]\n    }\n}"
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Mutating implementations of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Clone",
                    "style": "InlineCode"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This is simply a special - but common - case of the previous: hiding mutability for operations",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that appear to be immutable. The ",
                    "style": "Plain"
                  },
                  {
                    "text": "clone",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " method is expected to not change the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "source value, and is declared to take ",
                    "style": "Plain"
                  },
                  {
                    "text": "&self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", not ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Therefore, any mutation that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "happens in the ",
                    "style": "Plain"
                  },
                  {
                    "text": "clone",
                    "style": "InlineCode"
                  },
                  {
                    "text": " method must use cell types. For example, ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rc<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Frc%2Fstruct%2ERc"
                  },
                  {
                    "text": " maintains its",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "reference counts within a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Cell<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::cell::Cell;\nuse std::ptr::NonNull;\nuse std::process::abort;\nuse std::marker::PhantomData;\n\nstruct Rc<T: ?Sized> {\n    ptr: NonNull<RcInner<T>>,\n    phantom: PhantomData<RcInner<T>>,\n}\n\nstruct RcInner<T: ?Sized> {\n    strong: Cell<usize>,\n    refcount: Cell<usize>,\n    value: T,\n}\n\nimpl<T: ?Sized> Clone for Rc<T> {\n    fn clone(&self) -> Rc<T> {\n        self.inc_strong();\n        Rc {\n            ptr: self.ptr,\n            phantom: PhantomData,\n        }\n    }\n}\n\ntrait RcInnerPtr<T: ?Sized> {\n\n    fn inner(&self) -> &RcInner<T>;\n\n    fn strong(&self) -> usize {\n        self.inner().strong.get()\n    }\n\n    fn inc_strong(&self) {\n        self.inner()\n            .strong\n            .set(self.strong()\n                     .checked_add(1)\n                     .unwrap_or_else(|| abort() ));\n    }\n}\n\nimpl<T: ?Sized> RcInnerPtr<T> for Rc<T> {\n   fn inner(&self) -> &RcInner<T> {\n       unsafe {\n           self.ptr.as_ref()\n       }\n   }\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
