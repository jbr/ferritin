      {
        "path": "assert_eq",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.assert_eq.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Asserts that two expressions are equal to each other (using ",
                    "style": "Plain"
                  },
                  {
                    "text": "PartialEq",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/cmp/trait.PartialEq.html"
                  },
                  {
                    "text": ").",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Assertions are always checked in both debug and release builds, and cannot",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be disabled. See ",
                    "style": "Plain"
                  },
                  {
                    "text": "debug_assert_eq!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.debug_assert_eq.html"
                  },
                  {
                    "text": " for assertions that are disabled in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "release builds by default.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On panic, this macro will print the values of the expressions with their",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "debug representations.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Like ",
                    "style": "Plain"
                  },
                  {
                    "text": "assert!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.assert.html"
                  },
