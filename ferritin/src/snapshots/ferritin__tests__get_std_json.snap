              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Various things in the standard library may implement one or more of the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "three, where appropriate.",
