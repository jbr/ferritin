                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn move_away(_: String) { /* Do interesting things. */ }\n\nlet [john, roa] = [\"John\".to_string(), \"Roa\".to_string()];\nmove_away(john);\nmove_away(roa);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Arrays can be created from homogeneous tuples of appropriate length:",
