                    "text": "Expands to a string that represents the current module path.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The current module path can be thought of as the hierarchy of modules",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "leading back up to the crate root. The first component of the path",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "returned is the name of the crate currently being compiled.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "mod test {\n    pub fn foo() {\n        assert!(module_path!().ends_with(\"test\"));\n    }\n}\n\ntest::foo();"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "option_env",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.option_env.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Optionally inspects an environment variable at compile time.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the named environment variable is present at compile time, this will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "expand into an expression of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "Option<&'static str>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " whose value is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Some",
                    "style": "InlineCode"
                  },
                  {
                    "text": " of the value of the environment variable (a compilation error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "will be emitted if the environment variable is not a valid Unicode",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "string). If the environment variable is not present, then this will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "expand to ",
                    "style": "Plain"
                  },
                  {
                    "text": "None",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". See ",
                    "style": "Plain"
                  },
                  {
                    "text": "Option<T>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/option/enum.Option.html"
                  },
                  {
                    "text": " for more information on this",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "type.  Use ",
                    "style": "Plain"
                  },
                  {
                    "text": "std::env::var",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2Fstd%2Fenv%2Ffn%2Evar"
                  },
                  {
                    "text": " instead if you want to read the value at",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "runtime.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A compile time error is only emitted when using this macro if the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "environment variable exists and is not a valid Unicode string. To also",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "emit a compile error if the environment variable is not present, use the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "env!",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.env.html"
                  },
                  {
                    "text": " macro instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let key: Option<&'static str> = option_env!(\"SECRET_KEY\");\nprintln!(\"the secret key might be: {key:?}\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "stringify",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.stringify.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Stringifies its arguments.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro will yield an expression of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "&'static str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " which is the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "stringification of all the tokens passed to the macro. No restrictions",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "are placed on the syntax of the macro invocation itself.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that the expanded results of the input tokens may change in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "future. You should be careful if you rely on the output.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let one_plus_one = stringify!(1 + 1);\nassert_eq!(one_plus_one, \"1 + 1\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
