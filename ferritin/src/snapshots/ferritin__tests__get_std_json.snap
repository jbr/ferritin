                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Furthermore, ABI compatibility satisfies the following general properties:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Every type is ABI-compatible with itself.",
