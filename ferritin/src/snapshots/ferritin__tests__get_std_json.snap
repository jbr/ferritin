              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Implementing Iterator",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Creating an iterator of your own involves two steps: creating a ",
                    "style": "Plain"
                  },
                  {
                    "text": "struct",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "hold the iterator's state, and then implementing ",
                    "style": "Plain"
                  },
                  {
                    "text": "Iterator",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/iter/traits/iterator/trait.Iterator.html"
                  },
                  {
                    "text": " for that ",
                    "style": "Plain"
                  },
                  {
                    "text": "struct",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This is why there are so many ",
                    "style": "Plain"
                  },
                  {
                    "text": "struct",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s in this module: there is one for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "each iterator and iterator adapter.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Let's make an iterator named ",
                    "style": "Plain"
                  },
                  {
                    "text": "Counter",
                    "style": "InlineCode"
                  },
                  {
                    "text": " which counts from ",
                    "style": "Plain"
                  },
                  {
                    "text": "1",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to ",
                    "style": "Plain"
                  },
                  {
                    "text": "5",
                    "style": "InlineCode"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// First, the struct:\n\n/// An iterator which counts from one to five\nstruct Counter {\n    count: usize,\n}\n\n// we want our count to start at one, so let's add a new() method to help.\n// This isn't strictly necessary, but is convenient. Note that we start\n// `count` at zero, we'll see why in `next()`'s implementation below.\nimpl Counter {\n    fn new() -> Counter {\n        Counter { count: 0 }\n    }\n}\n\n// Then, we implement `Iterator` for our `Counter`:\n\nimpl Iterator for Counter {\n    // we will be counting with usize\n    type Item = usize;\n\n    // next() is the only required method\n    fn next(&mut self) -> Option<Self::Item> {\n        // Increment our count. This is why we started at zero.\n        self.count += 1;\n\n        // Check to see if we've finished counting or not.\n        if self.count < 6 {\n            Some(self.count)\n        } else {\n            None\n        }\n    }\n}\n\n// And now we can use it!\n\nlet mut counter = Counter::new();\n\nassert_eq!(counter.next(), Some(1));\nassert_eq!(counter.next(), Some(2));\nassert_eq!(counter.next(), Some(3));\nassert_eq!(counter.next(), Some(4));\nassert_eq!(counter.next(), Some(5));\nassert_eq!(counter.next(), None);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Calling ",
                    "style": "Plain"
                  },
                  {
                    "text": "next",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " this way gets repetitive. Rust has a construct which can",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "call ",
                    "style": "Plain"
                  },
                  {
                    "text": "next",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " on your iterator, until it reaches ",
                    "style": "Plain"
                  },
                  {
                    "text": "None",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Let's go over that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "next.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Also note that ",
                    "style": "Plain"
                  },
                  {
                    "text": "Iterator",
                    "style": "InlineCode"
                  },
                  {
                    "text": " provides a default implementation of methods such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "nth",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
