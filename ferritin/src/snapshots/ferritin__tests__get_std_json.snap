                    "text": "which currently allows you to set the name and stack size for the thread:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::thread;\n\nthread::Builder::new().name(\"thread1\".to_string()).spawn(move || {\n    println!(\"Hello, world!\");\n});"
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "Thread",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Threads are represented via the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Thread",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/thread/thread/struct.Thread.html"
                  },
                  {
                    "text": " type, which you can get in one of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
