                    "url": "http://docs.rust-lang.org/nightly/std/os/windows/ffi/trait.OsStrExt.html"
                  },
                  {
                    "text": " trait,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which provides an ",
                    "style": "Plain"
                  },
                  {
                    "text": "encode_wide",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/"
                  },
                  {
                    "text": " method. This provides an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "iterator that can be ",
                    "style": "Plain"
                  },
                  {
                    "text": "collect",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/iter/Iterator/index.html?search=std%3A%3Aiter%3A%3AIterator%3A%3Acollect"
                  },
                  {
                    "text": "ed into a vector of ",
                    "style": "Plain"
                  },
                  {
                    "text": "u16",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.u16.html"
                  },
                  {
                    "text": ". After a nul",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "characters is appended, this is the same as a native Windows string.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Additionally, on Windows ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsString",
                    "style": "InlineCode",
