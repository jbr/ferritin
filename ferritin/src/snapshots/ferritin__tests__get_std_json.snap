                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that due to method call deref coercion, simply calling a trait method will act like they",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "work on references as well as they do on owned values! The implementations described here are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "meant for generic contexts, where the final type ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is a type parameter or otherwise not",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "locally known.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Safety",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For all types, ",
                    "style": "Plain"
                  },
                  {
                    "text": "T: ?Sized",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and for all ",
                    "style": "Plain"
                  },
                  {
                    "text": "t: &T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "t: &mut T",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", when such values cross an API",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "boundary, the following invariants must generally be upheld:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "t",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is non-null",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "t",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is aligned to ",
                            "style": "Plain"
                          },
                          {
                            "text": "align_of_val(t)",
                            "style": "InlineCode"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "if ",
                            "style": "Plain"
                          },
                          {
                            "text": "size_of_val(t) > 0",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", then ",
                            "style": "Plain"
                          },
                          {
                            "text": "t",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is dereferenceable for ",
                            "style": "Plain"
                          },
                          {
                            "text": "size_of_val(t)",
                            "style": "InlineCode"
                          },
                          {
                            "text": " many bytes",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If ",
                    "style": "Plain"
                  },
                  {
                    "text": "t",
                    "style": "InlineCode"
                  },
                  {
                    "text": " points at address ",
                    "style": "Plain"
                  },
                  {
                    "text": "a",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", being \"dereferenceable\" for N bytes means that the memory range",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "[a, a + N)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is all contained within a single ",
                    "style": "Plain"
                  },
                  {
                    "text": "allocation",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Aptr"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For instance, this means that unsafe code in a safe function may assume these invariants are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ensured of arguments passed by the caller, and it may assume that these invariants are ensured",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of return values from any safe functions it calls.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For the other direction, things are more complicated: when unsafe code passes arguments",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to safe functions or returns values from safe functions, they generally must ",
                    "style": "Plain"
                  },
                  {
                    "text": "at least",
                    "style": "Emphasis"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "not violate these invariants. The full requirements are stronger, as the reference generally",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "must point to data that is safe to use as type ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It is not decided yet whether unsafe code may violate these invariants temporarily on internal",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "data. As a consequence, unsafe code which violates these invariants temporarily on internal data",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "may be unsound or become unsound in future versions of Rust depending on how this question is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "decided.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "fn",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.fn.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Function pointers, like ",
                    "style": "Plain"
                  },
                  {
                    "text": "fn(usize) -> bool",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See also the traits ",
                    "style": "Emphasis"
                  },
                  {
                    "text": "Fn",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ops/function/index.html?search=core%3A%3Aops%3A%3Afunction%3A%3AFn"
                  },
                  {
                    "text": ", ",
                    "style": "Emphasis"
                  },
                  {
                    "text": "FnMut",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ops/function/index.html?search=core%3A%3Aops%3A%3Afunction%3A%3AFnMut"
                  },
                  {
                    "text": ", and ",
                    "style": "Emphasis"
                  },
                  {
                    "text": "FnOnce",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/ops/function/index.html?search=core%3A%3Aops%3A%3Afunction%3A%3AFnOnce"
                  },
                  {
                    "text": ".",
                    "style": "Emphasis"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Function pointers are pointers that point to ",
                    "style": "Plain"
                  },
                  {
                    "text": "code",
                    "style": "Emphasis"
                  },
                  {
                    "text": ", not data. They can be called",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "just like functions. Like references, function pointers are, among other things, assumed to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "not be null, so if you want to pass a function pointer over FFI and be able to accommodate null",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointers, make your type ",
                    "style": "Plain"
                  },
                  {
                    "text": "Option<fn()>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Aoption"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "with your required signature.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that FFI requires additional care to ensure that the ABI for both sides of the call match.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The exact requirements are not currently documented.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Safety",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Plain function pointers are obtained by casting either plain functions, or closures that don't",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "capture an environment:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn add_one(x: usize) -> usize {\n    x + 1\n}\n\nlet ptr: fn(usize) -> usize = add_one;\nassert_eq!(ptr(5), 6);\n\nlet clos: fn(usize) -> usize = |x| x + 5;\nassert_eq!(clos(5), 10);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In addition to varying based on their signature, function pointers come in two flavors: safe",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and unsafe. Plain ",
                    "style": "Plain"
                  },
                  {
                    "text": "fn()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " function pointers can only point to safe functions,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "while ",
                    "style": "Plain"
                  },
                  {
                    "text": "unsafe fn()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " function pointers can point to safe or unsafe functions.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn add_one(x: usize) -> usize {\n    x + 1\n}\n\nunsafe fn add_one_unsafely(x: usize) -> usize {\n    x + 1\n}\n\nlet safe_ptr: fn(usize) -> usize = add_one;\n\n//ERROR: mismatched types: expected normal fn, found unsafe fn\n//let bad_ptr: fn(usize) -> usize = add_one_unsafely;\n\nlet unsafe_ptr: unsafe fn(usize) -> usize = add_one_unsafely;\nlet really_safe_ptr: unsafe fn(usize) -> usize = add_one;"
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "ABI",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "On top of that, function pointers can vary based on what ABI they use. This",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is achieved by adding the ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern",
                    "style": "InlineCode"
                  },
                  {
                    "text": " keyword before the type, followed by the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ABI in question. The default ABI is \"Rust\", i.e., ",
                    "style": "Plain"
                  },
                  {
                    "text": "fn()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is the exact same",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "type as ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern \"Rust\" fn()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". A pointer to a function with C ABI would have",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "type ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern \"C\" fn()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "extern \"ABI\" { ... }",
                    "style": "InlineCode"
                  },
                  {
                    "text": " blocks declare functions with ABI \"ABI\". The default",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "here is \"C\", i.e., functions declared in an ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern {...}",
                    "style": "InlineCode"
                  },
                  {
                    "text": " block have \"C\"",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ABI.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For more information and a list of supported ABIs, see ",
                    "style": "Plain"
                  },
                  {
                    "text": "the nomicon's",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fnomicon%2Fffi"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fnomicon%2Fffi"
                  },
                  {
                    "text": "section on foreign calling conventions",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fnomicon%2Fffi"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Variadic functions",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Extern function declarations with the \"C\" or \"cdecl\" ABIs can also be ",
                    "style": "Plain"
                  },
                  {
                    "text": "variadic",
                    "style": "Emphasis"
                  },
                  {
                    "text": ", allowing them",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to be called with a variable number of arguments. Normal Rust functions, even those with an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern \"ABI\"",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", cannot be variadic. For more information, see ",
                    "style": "Plain"
                  },
                  {
                    "text": "the nomicon's section on",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fnomicon%2Fffi"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fnomicon%2Fffi"
                  },
                  {
                    "text": "variadic functions",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fnomicon%2Fffi"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Creating function pointers",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When ",
                    "style": "Plain"
                  },
                  {
                    "text": "bar",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is the name of a function, then the expression ",
                    "style": "Plain"
                  },
                  {
                    "text": "bar",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Emphasis"
                  },
                  {
                    "text": " a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "function pointer. Rather, it denotes a value of an unnameable type that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "uniquely identifies the function ",
                    "style": "Plain"
                  },
                  {
                    "text": "bar",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The value is zero-sized because the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "type already identifies the function. This has the advantage that \"calling\"",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the value (it implements the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Fn*",
                    "style": "InlineCode"
                  },
                  {
                    "text": " traits) does not require dynamic",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "dispatch.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This zero-sized type ",
                    "style": "Plain"
                  },
                  {
                    "text": "coerces",
                    "style": "Emphasis"
                  },
                  {
                    "text": " to a regular function pointer. For example:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn bar(x: i32) {}\n\nlet not_bar_ptr = bar; // `not_bar_ptr` is zero-sized, uniquely identifying `bar`\nassert_eq!(size_of_val(&not_bar_ptr), 0);\n\nlet bar_ptr: fn(i32) = not_bar_ptr; // force coercion to function pointer\nassert_eq!(size_of_val(&bar_ptr), size_of::<usize>());\n\nlet footgun = &bar; // this is a shared reference to the zero-sized type identifying `bar`"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The last line shows that ",
                    "style": "Plain"
                  },
                  {
                    "text": "&bar",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is not a function pointer either. Rather, it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is a reference to the function-specific ZST. ",
                    "style": "Plain"
                  },
                  {
                    "text": "&bar",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is basically never what you",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "want when ",
                    "style": "Plain"
                  },
                  {
                    "text": "bar",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is a function.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Casting to and from integers",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You can cast function pointers directly to integers:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let fnptr: fn(i32) -> i32 = |x| x+2;\nlet fnptr_addr = fnptr as usize;"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "However, a direct cast back is not possible. You need to use ",
                    "style": "Plain"
                  },
                  {
                    "text": "transmute",
                    "style": "InlineCode"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let fnptr = fnptr_addr as *const ();\nlet fnptr: fn(i32) -> i32 = unsafe { std::mem::transmute(fnptr) };\nassert_eq!(fnptr(40), 42);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Crucially, we ",
                    "style": "Plain"
                  },
                  {
                    "text": "as",
                    "style": "InlineCode"
                  },
                  {
                    "text": "-cast to a raw pointer before ",
                    "style": "Plain"
                  },
                  {
                    "text": "transmute",
                    "style": "InlineCode"
                  },
                  {
                    "text": "ing to a function pointer.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This avoids an integer-to-pointer ",
                    "style": "Plain"
                  },
                  {
                    "text": "transmute",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", which can be problematic.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Transmuting between raw pointers and function pointers (i.e., two pointer types) is fine.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that all of this is not portable to platforms where function pointers and data pointers",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "have different sizes.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "ABI compatibility",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Generally, when a function is declared with one signature and called via a function pointer with",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a different signature, the two signatures must be ",
                    "style": "Plain"
                  },
                  {
                    "text": "ABI-compatible",
                    "style": "Emphasis"
                  },
                  {
                    "text": " or else calling the function",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "via that function pointer is Undefined Behavior. ABI compatibility is a lot stricter than merely",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "having the same memory layout; for example, even if ",
                    "style": "Plain"
                  },
                  {
                    "text": "i32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "f32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " have the same size and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "alignment, they might be passed in different registers and hence not be ABI-compatible.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "ABI compatibility as a concern only arises in code that alters the type of function pointers,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and code that imports functions via ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern",
                    "style": "InlineCode"
                  },
                  {
                    "text": " blocks. Altering the type of function pointers is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "wildly unsafe (as in, a lot more unsafe than even ",
                    "style": "Plain"
                  },
                  {
                    "text": "transmute_copy",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/mem/index.html?search=core%3A%3Amem%3A%3Atransmute%5Fcopy"
                  },
                  {
                    "text": "), and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "should only occur in the most exceptional circumstances. Most Rust code just imports functions",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "via ",
                    "style": "Plain"
                  },
                  {
                    "text": "use",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". So, most likely you do not have to worry about ABI compatibility.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "But assuming such circumstances, what are the rules? For this section, we are only considering",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the ABI of direct Rust-to-Rust calls (with both definition and callsite visible to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Rust compiler), not linking in general -- once functions are imported via ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern",
                    "style": "InlineCode"
                  },
                  {
                    "text": " blocks, there",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "are more things to consider that we do not go into here. Note that this also applies to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "passing/calling functions across language boundaries via function pointers.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Nothing in this section should be taken as a guarantee for non-Rust-to-Rust calls, even with",
                    "style": "Strong"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "types from ",
                    "style": "Strong"
                  },
                  {
                    "text": "core::ffi",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Strong"
                  },
                  {
                    "text": "libc",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For two signatures to be considered ",
                    "style": "Plain"
                  },
                  {
                    "text": "ABI-compatible",
                    "style": "Emphasis"
                  },
                  {
                    "text": ", they must use a compatible ABI string,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "must take the same number of arguments, and the individual argument types and the return types",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "must be ABI-compatible. The ABI string is declared via ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern \"ABI\" fn(...) -> ...",
                    "style": "InlineCode"
                  },
                  {
                    "text": "; note that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "fn name(...) -> ...",
                    "style": "InlineCode"
                  },
                  {
                    "text": " implicitly uses the ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"Rust\"",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ABI string and ",
                    "style": "Plain"
                  },
                  {
                    "text": "extern fn name(...) -> ...",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "implicitly uses the ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"C\"",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ABI string.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ABI strings are guaranteed to be compatible if they are the same, or if the caller ABI",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "string is ",
                    "style": "Plain"
                  },
                  {
                    "text": "$X-unwind",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and the callee ABI string is ",
                    "style": "Plain"
                  },
                  {
                    "text": "$X",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", where ",
                    "style": "Plain"
                  },
                  {
                    "text": "$X",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is one of the following:",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"C\", \"aapcs\", \"fastcall\", \"stdcall\", \"system\", \"sysv64\", \"thiscall\", \"vectorcall\", \"win64\".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The following types are guaranteed to be ABI-compatible:",
                    "style": "Plain"
