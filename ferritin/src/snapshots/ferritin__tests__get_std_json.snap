                  },
                  {
                    "text": " is most prominently used",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "for ",
                    "style": "Plain"
                  },
                  {
                    "text": "I/O",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/../../std/index.html?search=core%3A%3A%2E%2E%3A%3A%2E%2E%3A%3Astd%3A%3Aio"
                  },
                  {
                    "text": ".",
