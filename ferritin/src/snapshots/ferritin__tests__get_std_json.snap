        {
          "type": "heading",
          "level": "Title",
          "spans": [
            {
              "text": "A Tour of The Rust Standard Library",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The rest of this crate documentation is dedicated to pointing out notable",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "features of The Rust Standard Library.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "heading",
          "level": "Section",
          "spans": [
            {
              "text": "Containers and collections",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The ",
              "style": "Plain"
            },
            {
              "text": "option",
              "style": "InlineCode",
              "path": "core::option"
            },
            {
              "text": " and ",
              "style": "Plain"
            },
            {
              "text": "result",
              "style": "InlineCode",
              "path": "core::result"
            },
            {
              "text": " modules define optional and error-handling",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "types, ",
              "style": "Plain"
            },
            {
              "text": "Option<T>",
              "style": "InlineCode",
              "path": "core::option::Option"
            },
            {
              "text": " and ",
              "style": "Plain"
            },
            {
              "text": "Result<T, E>",
              "style": "InlineCode",
              "path": "core::result::Result"
            },
            {
              "text": ". The ",
              "style": "Plain"
            },
            {
              "text": "iter",
              "style": "InlineCode",
              "path": "core::iter"
            },
            {
              "text": " module defines",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "Rust's iterator trait, ",
              "style": "Plain"
            },
            {
              "text": "Iterator",
              "style": "InlineCode",
              "path": "core::iter::traits::iterator::Iterator"
            },
            {
              "text": ", which works with the ",
              "style": "Plain"
            },
            {
              "text": "for",
              "style": "InlineCode",
              "url": "../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"
            },
            {
              "text": " loop to",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "access collections.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The standard library exposes three common ways to deal with contiguous",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "regions of memory:",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "list",
          "items": [
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Vec<T>",
                      "style": "InlineCode",
                      "path": "alloc::vec::Vec"
                    },
                    {
                      "text": " - A heap-allocated ",
                      "style": "Plain"
                    },
                    {
                      "text": "vector",
                      "style": "Emphasis"
                    },
                    {
                      "text": " that is resizable at runtime.",
                      "style": "Plain"
                    }
                  ]
                }
              ]
            },
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "[T; N]",
                      "style": "InlineCode",
                      "path": "std::array"
                    },
                    {
                      "text": " - An inline ",
                      "style": "Plain"
                    },
                    {
                      "text": "array",
                      "style": "Emphasis"
                    },
                    {
                      "text": " with a fixed size at compile time.",
                      "style": "Plain"
                    }
                  ]
                }
              ]
            },
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "[T]",
                      "style": "InlineCode",
                      "path": "std::slice"
                    },
                    {
                      "text": " - A dynamically sized ",
                      "style": "Plain"
                    },
                    {
                      "text": "slice",
                      "style": "Emphasis"
                    },
                    {
                      "text": " into any other kind of contiguous",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "storage, whether heap-allocated or not.",
                      "style": "Plain"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Slices can only be handled through some kind of ",
              "style": "Plain"
            },
            {
              "text": "pointer",
              "style": "Emphasis"
            },
            {
              "text": ", and as such come",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "in many flavors such as:",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "list",
          "items": [
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "&[T]",
                      "style": "InlineCode"
                    },
                    {
                      "text": " - ",
                      "style": "Plain"
                    },
                    {
                      "text": "shared slice",
                      "style": "Emphasis"
                    }
                  ]
                }
              ]
            },
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "&mut [T]",
                      "style": "InlineCode"
                    },
                    {
                      "text": " - ",
                      "style": "Plain"
                    },
                    {
                      "text": "mutable slice",
                      "style": "Emphasis"
                    }
                  ]
                }
              ]
            },
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Box<[T]>",
                      "style": "InlineCode",
                      "path": "alloc::boxed"
                    },
                    {
                      "text": " - ",
                      "style": "Plain"
                    },
                    {
                      "text": "owned slice",
                      "style": "Emphasis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "str",
              "style": "InlineCode",
              "path": "std::str"
            },
            {
              "text": ", a UTF-8 string slice, is a primitive type, and the standard library",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "defines many methods for it. Rust ",
              "style": "Plain"
            },
            {
              "text": "str",
              "style": "InlineCode",
              "path": "std::str"
            },
            {
              "text": "s are typically accessed as",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "immutable references: ",
              "style": "Plain"
            },
            {
              "text": "&str",
              "style": "InlineCode"
            },
            {
              "text": ". Use the owned ",
              "style": "Plain"
            },
            {
              "text": "String",
              "style": "InlineCode",
              "path": "alloc::string::String"
            },
            {
              "text": " for building and",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "mutating strings.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "For converting to strings use the ",
              "style": "Plain"
            },
            {
              "text": "format!",
              "style": "InlineCode",
              "path": "alloc::format"
            },
            {
              "text": " macro, and for converting from",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "strings use the ",
              "style": "Plain"
            },
            {
              "text": "FromStr",
              "style": "InlineCode",
              "path": "core::str::traits::FromStr"
            },
            {
              "text": " trait.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Data may be shared by placing it in a reference-counted box or the ",
              "style": "Plain"
            },
            {
              "text": "Rc",
              "style": "InlineCode",
              "path": "alloc::rc::Rc"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "type, and if further contained in a ",
              "style": "Plain"
            },
            {
              "text": "Cell",
              "style": "InlineCode",
              "path": "core::cell::Cell"
            },
            {
              "text": " or ",
              "style": "Plain"
            },
            {
              "text": "RefCell",
              "style": "InlineCode",
              "path": "core::cell::RefCell"
            },
            {
              "text": ", may be mutated",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "as well as shared. Likewise, in a concurrent setting it is common to pair an",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "atomically-reference-counted box, ",
              "style": "Plain"
            },
            {
              "text": "Arc",
              "style": "InlineCode",
              "path": "alloc::sync::Arc"
            },
            {
              "text": ", with a ",
              "style": "Plain"
            },
            {
              "text": "Mutex",
              "style": "InlineCode",
              "path": "std::sync::poison::mutex::Mutex"
            },
            {
              "text": " to get the same",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "effect.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The ",
              "style": "Plain"
            },
            {
              "text": "collections",
              "style": "InlineCode",
              "path": "std::collections"
            },
            {
              "text": " module defines maps, sets, linked lists and other",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "typical collection types, including the common ",
              "style": "Plain"
            },
            {
              "text": "HashMap<K, V>",
              "style": "InlineCode",
              "path": "std::collections::hash::map::HashMap"
            },
            {
              "text": ".",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "heading",
          "level": "Section",
          "spans": [
            {
              "text": "Platform abstractions and I/O",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Besides basic data types, the standard library is largely concerned with",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "abstracting over differences in common platforms, most notably Windows and",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "Unix derivatives.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Common types of I/O, including ",
              "style": "Plain"
            },
            {
              "text": "files",
              "style": "Plain",
              "path": "std::fs::File"
            },
            {
              "text": ", ",
              "style": "Plain"
            },
            {
              "text": "TCP",
              "style": "Plain",
              "path": "std::net::tcp::TcpStream"
            },
            {
              "text": ", and ",
              "style": "Plain"
            },
            {
              "text": "UDP",
              "style": "Plain",
              "path": "std::net::udp::UdpSocket"
            },
            {
              "text": ", are defined in",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "the ",
              "style": "Plain"
            },
            {
              "text": "io",
              "style": "InlineCode",
              "path": "std::io"
            },
            {
              "text": ", ",
              "style": "Plain"
            },
            {
              "text": "fs",
              "style": "InlineCode",
              "path": "std::fs"
            },
            {
              "text": ", and ",
              "style": "Plain"
            },
            {
              "text": "net",
              "style": "InlineCode",
              "path": "std::net"
            },
            {
              "text": " modules.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The ",
              "style": "Plain"
            },
            {
              "text": "thread",
              "style": "InlineCode",
              "path": "std::thread"
            },
            {
              "text": " module contains Rust's threading abstractions. ",
              "style": "Plain"
            },
            {
              "text": "sync",
              "style": "InlineCode",
              "path": "std::sync"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "contains further primitive shared memory types, including ",
              "style": "Plain"
            },
            {
              "text": "atomic",
              "style": "InlineCode",
              "path": "core::sync::atomic"
            },
            {
              "text": ", ",
              "style": "Plain"
            },
            {
              "text": "mpmc",
              "style": "InlineCode",
              "path": "std::sync::mpmc"
            },
            {
              "text": " and",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "mpsc",
              "style": "InlineCode",
              "path": "std::sync::mpsc"
            },
            {
              "text": ", which contains the channel types for message passing.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "heading",
          "level": "Title",
          "spans": [
            {
              "text": "Use before and after ",
              "style": "Plain"
            },
            {
              "text": "main()",
              "style": "InlineCode"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Many parts of the standard library are expected to work before and after ",
              "style": "Plain"
            },
            {
              "text": "main()",
              "style": "InlineCode"
            },
            {
              "text": ";",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "but this is not guaranteed or ensured by tests. It is recommended that you write your own tests",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "and run them on each platform you wish to support.",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "This means that use of ",
              "style": "Plain"
            },
            {
              "text": "std",
              "style": "InlineCode"
            },
            {
              "text": " before/after main, especially of features that interact with the",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "OS or global state, is exempted from stability and portability guarantees and instead only",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "provided on a best-effort basis. Nevertheless bug reports are appreciated.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "On the other hand ",
              "style": "Plain"
            },
            {
              "text": "core",
              "style": "InlineCode"
            },
            {
              "text": " and ",
              "style": "Plain"
            },
            {
              "text": "alloc",
              "style": "InlineCode"
            },
            {
              "text": " are most likely to work in such environments with",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "the caveat that any hookable behavior such as panics, oom handling or allocators will also",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "depend on the compatibility of the hooks.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Some features may also behave differently outside main, e.g. stdio could become unbuffered,",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "some panics might turn into aborts, backtraces might not get symbolicated or similar.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Non-exhaustive list of known limitations:",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "list",
          "items": [
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "after-main use of thread-locals, which also affects additional features:",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "content": [
                        {
                          "type": "paragraph",
                          "spans": [
                            {
                              "text": "thread::current()",
                              "style": "InlineCode",
                              "path": "std::thread::current::current"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "content": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "under UNIX, before main, file descriptors 0, 1, and 2 may be unchanged",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "(they are guaranteed to be open during main,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "and are opened to /dev/null O_RDWR if they weren't open on program start)",
                      "style": "Plain"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "level": "Full"
    }
