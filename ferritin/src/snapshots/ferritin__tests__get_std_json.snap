            {
              "text": " to get the same",
              "style": "Plain"
            },
            {
              "text": " ",
              "style": "Plain"
            },
            {
              "text": "effect.",
              "style": "Plain"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The ",
              "style": "Plain"
            },
            {
              "text": "collections",
              "style": "InlineCode",
              "url": "http://docs.rust-lang.org/nightly/std/collections/index.html"
            },
            {
              "text": " module defines maps, sets, linked lists and other",
