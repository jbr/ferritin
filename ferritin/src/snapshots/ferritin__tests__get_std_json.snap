                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Projections and Structural Pinning",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "With ordinary structs, it is natural that we want to add ",
                    "style": "Plain"
                  },
                  {
                    "text": "projection",
                    "style": "Emphasis"
                  },
                  {
                    "text": " methods that allow",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "borrowing one or more of the inner fields of a struct when the caller has access to a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "borrow of the whole struct:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "struct Struct {\n    field: Field,\n    // ...\n}\n\nimpl Struct {\n    fn field(&mut self) -> &mut Field { &mut self.field }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "When working with address-sensitive types, it's not obvious what the signature of these",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "functions should be. If ",
                    "style": "Plain"
                  },
                  {
                    "text": "field",
                    "style": "InlineCode"
                  },
                  {
                    "text": " takes ",
                    "style": "Plain"
                  },
                  {
                    "text": "self: ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": "<",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut Struct",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": ">",
                    "style": "Plain"
                  },
                  {
                    "text": ", should it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "return ",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut Field",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": "<",
                    "style": "Plain"
                  },
                  {
                    "text": "&mut Field",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": ">",
                    "style": "Plain"
                  },
                  {
                    "text": "? This question also arises with",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "enum",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s and wrapper types like ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fvec%2Fstruct%2EVec"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box<T>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fstd%2Fboxed%2Fstruct%2EBox"
                  },
                  {
                    "text": ", and ",
                    "style": "Plain"
                  },
                  {
                    "text": "RefCell<T>",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/cell/struct.RefCell.html"
                  },
                  {
                    "text": ". (This question",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "applies just as well to shared references, but we'll examine the more common case of mutable",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "references for illustration)",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It turns out that it's up to the author of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Struct",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to decide which type the \"projection\"",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "should produce. The choice must be ",
                    "style": "Plain"
                  },
                  {
                    "text": "consistent",
                    "style": "Emphasis"
                  },
                  {
                    "text": " though: if a pin is projected to a field",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in one place, then it should very likely not be exposed elsewhere without projecting the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pin.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As the author of a data structure, you get to decide for each field whether pinning",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "\"propagates\" to this field or not. Pinning that propagates is also called \"structural\",",
