                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html"
                  },
                  {
                    "text": " by way of ",
                    "style": "Plain"
                  },
                  {
                    "text": "Pin::set()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/pin/struct.Pin.html#method.set"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This does not violate any guarantees, since it will run ",
                    "style": "Plain"
                  },
                  {
                    "text": "drop",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
                    "text": " on the pointee value before",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "assigning the new value. Thus, the ",
                    "style": "Plain"
                  },
                  {
                    "text": "drop",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/"
                  },
                  {
