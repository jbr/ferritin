                "code": "use std::process::Command;\n\nlet output = Command::new(\"echo\")\n    .arg(\"Hello world\")\n    .output()\n    .expect(\"Failed to execute command\");\n\nassert_eq!(b\"Hello world\\n\", output.stdout.as_slice());"
              },
              {
                "type": "paragraph",
