                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::rc::Rc;\n\nlet my_rc = Rc::new(());\nlet my_weak = Rc::downgrade(&my_rc);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rc<T>",
                    "style": "InlineCode"
                  },
