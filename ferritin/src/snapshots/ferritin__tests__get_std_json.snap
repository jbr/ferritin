      {
        "path": "path",
        "kind": "module",
        "url": "http://docs.rust-lang.org/nightly/std/path/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Cross-platform path manipulation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This module provides two types, ",
                    "style": "Plain"
                  },
                  {
                    "text": "PathBuf",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.PathBuf.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Path",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html"
                  },
                  {
                    "text": " (akin to ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/string/index.html?search=alloc%3A%3Astring%3A%3AString"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and ",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.str.html"
                  },
                  {
                    "text": "), for working with paths abstractly. These types are thin wrappers",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "around ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsString",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsString.html"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "OsStr",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/ffi/os_str/struct.OsStr.html"
                  },
                  {
                    "text": " respectively, meaning that they work directly",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "on strings according to the local platform's path syntax.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Paths can be parsed into ",
                    "style": "Plain"
                  },
                  {
                    "text": "Component",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/enum.Component.html"
                  },
                  {
                    "text": "s by iterating over the structure",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "returned by the ",
                    "style": "Plain"
                  },
                  {
                    "text": "components",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.components"
                  },
                  {
                    "text": " method on ",
                    "style": "Plain"
                  },
                  {
                    "text": "Path",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html"
                  },
                  {
                    "text": ". ",
                    "style": "Plain"
                  },
                  {
                    "text": "Component",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/enum.Component.html"
                  },
                  {
                    "text": "s roughly",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "correspond to the substrings between path separators (",
                    "style": "Plain"
                  },
                  {
                    "text": "/",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "\\",
                    "style": "InlineCode"
                  },
                  {
                    "text": "). You can",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "reconstruct an equivalent path from components with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "push",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.PathBuf.html#method.push"
                  },
                  {
                    "text": " method on",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "PathBuf",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.PathBuf.html"
                  },
                  {
                    "text": "; note that the paths may differ syntactically by the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "normalization described in the documentation for the ",
                    "style": "Plain"
                  },
                  {
                    "text": "components",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.components"
                  },
                  {
                    "text": " method.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Case sensitivity",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unless otherwise indicated path methods that do not access the filesystem,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "such as ",
                    "style": "Plain"
                  },
                  {
                    "text": "Path::starts_with",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.starts_with"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "Path::ends_with",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.ends_with"
                  },
                  {
                    "text": ", are case sensitive no",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "matter the platform or filesystem. An exception to this is made for Windows",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "drive letters.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Path normalization",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Several methods in this module perform basic path normalization by disregarding",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "repeated separators, non-leading ",
                    "style": "Plain"
                  },
                  {
                    "text": ".",
                    "style": "InlineCode"
                  },
                  {
                    "text": " components, and trailing separators. These include:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Methods for iteration, such as ",
                            "style": "Plain"
                          },
                          {
                            "text": "Path::components",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.components"
                          },
                          {
                            "text": " and ",
                            "style": "Plain"
                          },
                          {
                            "text": "Path::iter",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.iter"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Methods for inspection, such as ",
                            "style": "Plain"
                          },
                          {
                            "text": "Path::has_root",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/std/path/struct.Path.html#method.has_root"
