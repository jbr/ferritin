                            "text": "Clone",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/clone/index.html?search=core%3A%3Aclone%3A%3AClone"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Debug",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/fmt/index.html?search=core%3A%3Afmt%3A%3ADebug"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "IntoIterator",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/iter/traits/collect/index.html?search=core%3A%3Aiter%3A%3Atraits%3A%3Acollect%3A%3AIntoIterator"
                          },
                          {
                            "text": " (implemented for ",
                            "style": "Plain"
                          },
                          {
                            "text": "[T; N]",
                            "style": "InlineCode"
                          },
                          {
                            "text": ", ",
                            "style": "Plain"
                          },
                          {
                            "text": "&[T; N]",
                            "style": "InlineCode"
                          },
