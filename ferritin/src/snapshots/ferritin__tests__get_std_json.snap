                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Arrays of sizes from 0 to 32 (inclusive) implement the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Default",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/default/index.html?search=core%3A%3Adefault%3A%3ADefault"
                  },
                  {
                    "text": " trait",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "if the element type allows it. As a stopgap, trait implementations are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "statically generated up to size 32.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Arrays of sizes from 1 to 12 (inclusive) implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "From<Tuple>",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/convert/index.html?search=core%3A%3Aconvert%3A%3AFrom"
                  },
                  {
                    "text": ", where ",
                    "style": "Plain"
                  },
                  {
                    "text": "Tuple",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is a homogeneous ",
                    "style": "Plain"
                  },
                  {
                    "text": "prim@tuple",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.tuple.html"
                  },
                  {
                    "text": " of appropriate length.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Arrays coerce to ",
                    "style": "Plain"
                  },
                  {
                    "text": "slices (",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.slice.html"
                  },
                  {
                    "text": "[T]",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.slice.html"
                  },
                  {
                    "text": ")",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/std/primitive.slice.html"
                  },
                  {
                    "text": ", so a slice method may be called on",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "an array. Indeed, this provides most of the API for working with arrays.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Slices have a dynamic size and do not coerce to arrays. Instead, use",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "slice.try_into().unwrap()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
