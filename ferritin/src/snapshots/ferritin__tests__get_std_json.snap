                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Eq",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AEq"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "PartialOrd",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3APartialOrd"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Ord",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AOrd"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
