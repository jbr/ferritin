                    "url": "http://docs.rust-lang.org/nightly/core/iter/traits/iterator/trait.Iterator.html"
                  },
                  {
                    "text": "s implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "IntoIterator",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/iter/traits/collect/trait.IntoIterator.html"
                  },
                  {
                    "text": ", by just",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "returning themselves. This means two things:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If you're writing an ",
                            "style": "Plain"
                          },
                          {
                            "text": "Iterator",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/core/iter/traits/iterator/trait.Iterator.html"
                          },
                          {
                            "text": ", you can use it with a ",
