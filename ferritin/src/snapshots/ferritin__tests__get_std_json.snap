      {
        "path": "vec",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/alloc/macro.vec.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Creates a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html"
                  },
                  {
                    "text": " containing the arguments.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "vec!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " allows ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s to be defined with the same syntax as array expressions.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "There are two forms of this macro:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Create a ",
                            "style": "Plain"
                          },
                          {
                            "text": "Vec",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html"
                          },
                          {
                            "text": " containing a given list of elements:",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = vec![1, 2, 3];\nassert_eq!(v[0], 1);\nassert_eq!(v[1], 2);\nassert_eq!(v[2], 3);"
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Create a ",
                            "style": "Plain"
                          },
                          {
                            "text": "Vec",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html"
                          },
                          {
                            "text": " from a given element and size:",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = vec![1; 3];\nassert_eq!(v, [1, 1, 1]);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that unlike array expressions this syntax supports all elements",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which implement ",
                    "style": "Plain"
                  },
                  {
                    "text": "Clone",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/clone/index.html?search=core%3A%3Aclone%3A%3AClone"
                  },
                  {
                    "text": " and the number of elements doesn't have to be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a constant.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This will use ",
                    "style": "Plain"
                  },
                  {
                    "text": "clone",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to duplicate an expression, so one should be careful",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "using this with types having a nonstandard ",
                    "style": "Plain"
                  },
                  {
                    "text": "Clone",
                    "style": "InlineCode"
                  },
                  {
                    "text": " implementation. For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example, ",
                    "style": "Plain"
                  },
                  {
                    "text": "vec![Rc::new(1); 5]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will create a vector of five references",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to the same boxed integer value, not five references pointing to independently",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "boxed integers.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Also, note that ",
                    "style": "Plain"
                  },
                  {
                    "text": "vec![expr; 0]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is allowed, and produces an empty vector.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This will still evaluate ",
                    "style": "Plain"
                  },
                  {
                    "text": "expr",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", however, and immediately drop the resulting value, so",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "be mindful of side effects.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "cfg_select",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macros/macro.cfg_select.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Selects code at compile-time based on ",
                    "style": "Plain"
                  },
                  {
                    "text": "cfg",
                    "style": "InlineCode"
                  },
                  {
                    "text": " predicates.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro evaluates, at compile-time, a series of ",
                    "style": "Plain"
                  },
                  {
                    "text": "cfg",
                    "style": "InlineCode"
                  },
                  {
                    "text": " predicates,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "selects the first that is true, and emits the code guarded by that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "predicate. The code guarded by other predicates is not emitted.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "An optional trailing ",
                    "style": "Plain"
                  },
                  {
                    "text": "_",
                    "style": "InlineCode"
                  },
                  {
                    "text": " wildcard can be used to specify a fallback. If",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "none of the predicates are true, a ",
                    "style": "Plain"
                  },
                  {
                    "text": "compile_error",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/core/macro.compile_error.html"
                  },
                  {
                    "text": " is emitted.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Example",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "cfg_select! {\n    unix => {\n        fn foo() { /* unix specific functionality */ }\n    }\n    target_pointer_width = \"32\" => {\n        fn foo() { /* non-unix, 32-bit functionality */ }\n    }\n    _ => {\n        fn foo() { /* fallback implementation */ }\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "cfg_select!",
                    "style": "InlineCode"
                  },
                  {
                    "text": " macro can also be used in expression position, with or without braces on the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "right-hand side:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let _some_string = cfg_select! {\n    unix => \"With great power comes great electricity bills\",\n    _ => { \"Behind every successful diet is an unwatched pizza\" }\n};"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "concat_bytes",
        "kind": "macro",
        "url": "http://docs.rust-lang.org/nightly/core/macro.concat_bytes.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Concatenates literals into a byte slice.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This macro takes any number of comma-separated literals, and concatenates them all into",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "one, yielding an expression of type ",
                    "style": "Plain"
                  },
                  {
                    "text": "&[u8; _]",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", which represents all of the literals",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "concatenated left-to-right. The literals passed can be any combination of:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "byte literals (",
                            "style": "Plain"
                          },
                          {
                            "text": "b'r'",
                            "style": "InlineCode"
                          },
                          {
                            "text": ")",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "byte strings (",
                            "style": "Plain"
                          },
                          {
                            "text": "b\"Rust\"",
                            "style": "InlineCode"
                          },
                          {
                            "text": ")",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "arrays of bytes/numbers (",
                            "style": "Plain"
                          },
                          {
                            "text": "[b'A', 66, b'C']",
                            "style": "InlineCode"
                          },
                          {
                            "text": ")",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(concat_bytes)]\n\nlet s: &[u8; 6] = concat_bytes!(b'A', b\"BC\", [68, b'E', 70]);\nassert_eq!(s, b\"ABCDEF\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
