                          },
                          {
                            "text": " is a trait that is used for generic address resolution when interacting",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "with networking objects like ",
                            "style": "Plain"
                          },
                          {
                            "text": "TcpListener",
