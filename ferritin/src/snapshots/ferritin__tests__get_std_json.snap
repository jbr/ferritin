                          },
                          {
                            "text": "Ipv4Addr",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/net/ip_addr/index.html?search=core%3A%3Anet%3A%3Aip%5Faddr%3A%3AIpv4Addr"
