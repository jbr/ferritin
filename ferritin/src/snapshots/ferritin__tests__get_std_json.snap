            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A character type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type represents a single character. More specifically, since",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "'character' isn't a well-defined concept in Unicode, ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is a '",
                    "style": "Plain"
                  },
                  {
                    "text": "Unicode",
                    "style": "Plain",
                    "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                  },
                  {
                    "text": "scalar value",
                    "style": "Plain",
                    "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                  },
                  {
                    "text": "'.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This documentation describes a number of methods and trait implementations on the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type. For technical reasons, there is additional, separate",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "documentation in ",
                    "style": "Plain"
                  },
                  {
                    "text": "the ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Achar"
                  },
                  {
                    "text": "std::char",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Achar"
                  },
                  {
                    "text": " module",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Achar"
                  },
                  {
                    "text": " as well.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Validity and Layout",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is a '",
                    "style": "Plain"
                  },
                  {
                    "text": "Unicode scalar value",
                    "style": "Plain",
                    "url": "https://www.unicode.org/glossary/#unicode_scalar_value"
                  },
                  {
                    "text": "', which is any '",
                    "style": "Plain"
                  },
                  {
                    "text": "Unicode code point",
                    "style": "Plain",
                    "url": "https://www.unicode.org/glossary/#code_point"
                  },
                  {
                    "text": "'",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "other than a ",
                    "style": "Plain"
                  },
                  {
                    "text": "surrogate code point",
                    "style": "Plain",
                    "url": "https://www.unicode.org/glossary/#surrogate_code_point"
                  },
                  {
                    "text": ". This has a fixed numerical definition:",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "code points are in the range 0 to 0x10FFFF, inclusive.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Surrogate code points, used by UTF-16, are in the range 0xD800 to 0xDFFF.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "No ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " may be constructed, whether as a literal or at runtime, that is not a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Unicode scalar value. Violating this rule causes undefined behavior.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// Each of these is a compiler error\n['\\u{D800}', '\\u{DFFF}', '\\u{110000}'];"
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// Panics; from_u32 returns None.\nchar::from_u32(0xDE01).unwrap();"
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "// Undefined behavior\nlet _ = unsafe { char::from_u32_unchecked(0x110000) };"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unicode scalar values are also the exact set of values that may be encoded in UTF-8. Because",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values are Unicode scalar values and functions may assume ",
                    "style": "Plain"
                  },
                  {
                    "text": "incoming ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Astr"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Astr"
                  },
                  {
                    "text": " values are",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Astr"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Astr"
                  },
                  {
                    "text": "valid UTF-8",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3Astr"
                  },
                  {
                    "text": ", it is safe to store any ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in a ",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or read",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "any character from a ",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "InlineCode"
                  },
                  {
                    "text": " as a ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The gap in valid ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values is understood by the compiler, so in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "below example the two ranges are understood to cover the whole range of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "possible ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values and there is no error for a ",
                    "style": "Plain"
                  },
                  {
                    "text": "non-exhaustive match",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fbook%2Fch06%2D02%2Dmatch"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let c: char = 'a';\nmatch c {\n    '\\0' ..= '\\u{D7FF}' => false,\n    '\\u{E000}' ..= '\\u{10FFFF}' => true,\n};"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "All Unicode scalar values are valid ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " values, but not all of them represent a real",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "character. Many Unicode scalar values are not currently assigned to a character, but may be in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the future (\"reserved\"); some will never be a character (\"noncharacters\"); and some may be given",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "different meanings by different users (\"private use\").",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is guaranteed to have the same size, alignment, and function call ABI as ",
                    "style": "Plain"
                  },
                  {
                    "text": "u32",
                    "style": "InlineCode"
                  },
                  {
                    "text": " on all",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "platforms.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::alloc::Layout;\nassert_eq!(Layout::new::<char>(), Layout::new::<u32>());"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Representation",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is always four bytes in size. This is a different representation than",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a given character would have as part of a ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/std/index.html?search=std%3A%3A%2E%2Fstd%2Fstring%2Fstruct%2EString"
                  },
                  {
                    "text": ". For example:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let v = vec!['h', 'e', 'l', 'l', 'o'];\n\n// five elements times four bytes for each element\nassert_eq!(20, v.len() * size_of::<char>());\n\nlet s = String::from(\"hello\");\n\n// five elements times one byte per element\nassert_eq!(5, s.len() * size_of::<u8>());"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As always, remember that a human intuition for 'character' might not map to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Unicode's definitions. For example, despite looking similar, the 'é'",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "character is one Unicode code point while 'é' is two Unicode code points:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut chars = \"é\".chars();\n// U+00e9: 'latin small letter e with acute'\nassert_eq!(Some('\\u{00e9}'), chars.next());\nassert_eq!(None, chars.next());\n\nlet mut chars = \"é\".chars();\n// U+0065: 'latin small letter e'\nassert_eq!(Some('\\u{0065}'), chars.next());\n// U+0301: 'combining acute accent'\nassert_eq!(Some('\\u{0301}'), chars.next());\nassert_eq!(None, chars.next());"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This means that the contents of the first string above ",
                    "style": "Plain"
                  },
                  {
                    "text": "will",
                    "style": "Emphasis"
                  },
                  {
                    "text": " fit into a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " while the contents of the second string ",
                    "style": "Plain"
                  },
                  {
                    "text": "will not",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". Trying to create",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " literal with the contents of the second string gives an error:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "text",
                "code": "error: character literal may only contain one codepoint: 'é'\nlet c = 'é';\n        ^^^\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Another implication of the 4-byte fixed size of a ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "per-",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " processing can end up using a lot more memory:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let s = String::from(\"love: ❤️\");\nlet v: Vec<char> = s.chars().collect();\n\nassert_eq!(12, size_of_val(&s[..]));\nassert_eq!(32, size_of_val(&v[..]));"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "unit",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.unit.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type, also called \"unit\".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " type has exactly one value ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and is used when there",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is no other meaningful value that could be returned. ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is most",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "commonly seen implicitly: functions without a ",
                    "style": "Plain"
                  },
                  {
                    "text": "-> ...",
                    "style": "InlineCode"
                  },
                  {
                    "text": " implicitly",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "have return type ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", that is, these are equivalent:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn long() -> () {}\n\nfn short() {}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The semicolon ",
                    "style": "Plain"
                  },
                  {
                    "text": ";",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can be used to discard the result of an",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "expression at the end of a block, making the expression (and thus",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the block) evaluate to ",
                    "style": "Plain"
                  },
                  {
                    "text": "()",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". For example,",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn returns_i64() -> i64 {\n    1i64\n}\nfn returns_unit() {\n    1i64;\n}\n\nlet is_i64 = {\n    returns_i64()\n};\nlet is_unit = {\n    returns_i64();\n};"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "pointer",
        "kind": "primitive",
        "url": "http://docs.rust-lang.org/nightly/std/primitive.pointer.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Raw, unsafe pointers, ",
                    "style": "Plain"
