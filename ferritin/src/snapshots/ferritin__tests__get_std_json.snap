                  },
                  {
                    "text": "&mut",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/core/primitive.reference.html"
                  },
                  {
                    "text": " T",
                    "style": "Plain"
                  },
                  {
                    "text": "), etc., as well as many",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "core and standard library types like ",
                    "style": "Plain"
                  },
