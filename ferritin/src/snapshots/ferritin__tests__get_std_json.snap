                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The question mark operator (",
                            "style": "Plain"
                          },
                          {
                            "text": "?",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/std/../../std/index.html?search=std%3A%3A%2E%2E%3A%3A%2E%2E%3A%3Astd%3A%3Aresult"
                          },
