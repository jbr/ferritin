---
"   Item: NotThreadSafe                                                          "
"   Kind: Struct                                                                 "
"   Visibility: Public                                                           "
"   Defined at: fixture_crate::NotThreadSafe                                     "
"   In crate: fixture-crate (0.1.0)                                              "
"                                                                                "
"   A type that is not thread-safe, to exercise negative auto-trait impls (!Send "
"   /!Sync, which rustdoc synthesizes for types holding a raw pointer).          "
"                                                                                "
"   struct NotThreadSafe {                                                       "
"       ptr: *const u8,                                                          "
"   }                                                                            "
"                                                                                "
"   Methods                                                                      "
"                                                                                "
"     ◦ pub fn new(ptr: *const u8) -> Self                                       "
"       Wrap a raw pointer.                                                      "
"                                                                                "
"   Trait Implementations                                                        "
"                                                                                "
"   std: Freeze, From<Self>, RefUnwindSafe, !Send, !Sync, Unpin, UnsafeUnpin,    "
"   UnwindSafe                                                                   "
"                                                                                "
"     ◦ impl Any where Self: 'static + ?Sized                                    "
"                                                                                "
"     ◦ impl Borrow<Self> where Self: ?Sized                                     "
"                                                                                "
"     ◦ impl BorrowMut<Self> where Self: ?Sized                                  "
"                                                                                "
"     ◦ impl<U: From<Self>> Into<U>                                              "
"                                                                                "
"     ◦ impl<U: Into<Self>> TryFrom<U>                                           "
"           type Error = never                                                   "
"                                                                                "
"     ◦ impl<U: TryFrom<Self>> TryInto<U>                                        "
"           type Error = <U as TryFrom<Self>>::Error                             "
"                                                                                "
