            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "If generic code merely needs to work for all types that can",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "provide a reference to related type ",
                  "style": "Plain"
                },
                {
                  "text": "T",
                  "style": "InlineCode"
                },
                {
                  "text": ", it is often better to use",
                  "style": "Plain"
