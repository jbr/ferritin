              "code": "use std::borrow::Borrow;\nuse std::hash::Hash;\n\npub struct HashMap<K, V> {\n    // fields omitted\n}\n\nimpl<K, V> HashMap<K, V> {\n    pub fn insert(&self, key: K, value: V) -> Option<V>\n    where K: Hash + Eq\n    {\n        // ...\n    }\n\n    pub fn get<Q>(&self, k: &Q) -> Option<&V>\n    where\n        K: Borrow<Q>,\n        Q: Hash + Eq + ?Sized\n    {\n        // ...\n    }\n}"
