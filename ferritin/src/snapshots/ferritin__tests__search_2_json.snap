                  "text": " must be equivalent for",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "borrowed and owned values: ",
                  "style": "Plain"
                },
                {
                  "text": "x.borrow() == y.borrow()",
                  "style": "InlineCode"
                },
                {
                  "text": " should give the",
