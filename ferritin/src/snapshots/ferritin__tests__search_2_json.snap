            {
              "type": "heading",
              "level": "Title",
              "spans": [
                {
                  "text": "Examples",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "As a data collection, ",
                  "style": "Plain"
