                  "style": "Plain"
                },
                {
                  "text": "the hash value calculated from the ",
                  "style": "Plain"
                },
                {
                  "text": "K",
                  "style": "InlineCode"
                },
                {
                  "text": " value.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "As a consequence, the hash map breaks if a ",
                  "style": "Plain"
                },
                {
                  "text": "K",
                  "style": "InlineCode"
                },
                {
                  "text": " wrapping a ",
                  "style": "Plain"
                },
                {
                  "text": "Q",
                  "style": "InlineCode"
                },
                {
                  "text": " value",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "produces a different hash than ",
                  "style": "Plain"
                },
                {
                  "text": "Q",
                  "style": "InlineCode"
                },
                {
                  "text": ". For instance, imagine you have a",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "type that wraps a string but compares ASCII letters ignoring their case:",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "codeBlock",
              "lang": "rust",
              "code": "pub struct CaseInsensitiveString(String);\n\nimpl PartialEq for CaseInsensitiveString {\n    fn eq(&self, other: &Self) -> bool {\n        self.0.eq_ignore_ascii_case(&other.0)\n    }\n}\n\nimpl Eq for CaseInsensitiveString { }"
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Because two equal values need to produce the same hash value, the",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "implementation of ",
