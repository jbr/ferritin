                  "text": ", and ",
                  "style": "Plain"
                },
                {
                  "text": "v",
                  "style": "InlineCode"
                },
                {
                  "text": " is a value of type ",
                  "style": "Plain"
                },
                {
                  "text": "T",
                  "style": "InlineCode"
                },
                {
                  "text": ", then:",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "In immutable contexts, ",
                          "style": "Plain"
                        },
                        {
                          "text": "*v",
                          "style": "InlineCode"
                        },
                        {
                          "text": " (where ",
                          "style": "Plain"
                        },
                        {
                          "text": "T",
                          "style": "InlineCode"
                        },
                        {
                          "text": " is neither a reference nor a raw",
                          "style": "Plain"
                        },
                        {
                          "text": " ",
                          "style": "Plain"
                        },
                        {
                          "text": "pointer) is equivalent to ",
                          "style": "Plain"
                        },
                        {
                          "text": "*Deref::deref(&v)",
                          "style": "InlineCode"
                        },
                        {
                          "text": ".",
                          "style": "Plain"
                        }
