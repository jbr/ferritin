                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "Values of type ",
                          "style": "Plain"
                        },
                        {
                          "text": "&T",
                          "style": "InlineCode"
                        },
                        {
                          "text": " are coerced to values of type ",
                          "style": "Plain"
                        },
                        {
                          "text": "&U",
                          "style": "InlineCode"
                        }
                      ]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "T",
                          "style": "InlineCode"
                        },
                        {
                          "text": " implicitly implements all the methods of the type ",
                          "style": "Plain"
                        },
                        {
                          "text": "U",
                          "style": "InlineCode"
                        },
                        {
                          "text": " which take the",
                          "style": "Plain"
                        },
                        {
                          "text": " ",
                          "style": "Plain"
                        },
                        {
                          "text": "&self",
                          "style": "InlineCode"
                        },
                        {
                          "text": " receiver.",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "For more details, visit ",
                  "style": "Plain"
                },
                {
                  "text": "the chapter in ",
                  "style": "Plain",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fbook%2Fch15%2D02%2Dderef"
                },
                {
                  "text": "The Rust Programming Language",
                  "style": "Emphasis",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Fbook%2Fch15%2D02%2Dderef"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "as well as the reference sections on ",
                  "style": "Plain"
                },
                {
                  "text": "the dereference operator",
                  "style": "Plain",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Freference%2Fexpressions%2Foperator%2Dexpr"
                },
                {
                  "text": ",",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "method resolution",
                  "style": "Plain",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Freference%2Fexpressions%2Fmethod%2Dcall%2Dexpr"
                },
                {
                  "text": ", and ",
                  "style": "Plain"
                },
                {
                  "text": "type coercions",
                  "style": "Plain",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Freference%2Ftype%2Dcoercions"
                },
                {
                  "text": ".",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "heading",
              "level": "Title",
              "spans": [
                {
                  "text": "When to implement ",
                  "style": "Plain"
                },
                {
                  "text": "Deref",
                  "style": "InlineCode"
                },
                {
                  "text": " or ",
                  "style": "Plain"
                },
                {
                  "text": "DerefMut",
                  "style": "InlineCode"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The same advice applies to both deref traits. In general, deref traits",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "should",
                  "style": "Strong"
                },
                {
                  "text": " be implemented if:",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "a value of the type transparently behaves like a value of the target",
                          "style": "Plain"
                        },
                        {
                          "text": " ",
                          "style": "Plain"
                        },
                        {
                          "text": "type;",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "the implementation of the deref function is cheap; and",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "users of the type will not be surprised by any deref coercion behavior.",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "In general, deref traits ",
                  "style": "Plain"
                },
                {
                  "text": "should not",
                  "style": "Strong"
                },
                {
                  "text": " be implemented if:",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "the deref implementations could fail unexpectedly; or",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "the type has methods that are likely to collide with methods on the",
                          "style": "Plain"
                        },
                        {
                          "text": " ",
                          "style": "Plain"
                        },
                        {
                          "text": "target type; or",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "paragraph",
                      "spans": [
                        {
                          "text": "committing to deref coercion as part of the public API is not desirable.",
                          "style": "Plain"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Note that there's a large difference between implementing deref traits",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "generically over many target types, and doing so only for specific target",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "types.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Generic implementations, such as for ",
                  "style": "Plain"
                },
                {
                  "text": "Box<T>",
                  "style": "InlineCode",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Falloc%2Fboxed%2Fstruct%2EBox"
                },
                {
                  "text": " (which is generic over",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "every type and dereferences to ",
                  "style": "Plain"
                },
                {
                  "text": "T",
                  "style": "InlineCode"
                },
                {
                  "text": ") should be careful to provide few or no",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "methods, since the target type is unknown and therefore every method could",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "collide with one on the target type, causing confusion for users.",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "impl<T> Box<T>",
                  "style": "InlineCode"
                },
                {
                  "text": " has no methods (though several associated functions),",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "partly for this reason.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Specific implementations, such as for ",
                  "style": "Plain"
                },
                {
                  "text": "String",
                  "style": "InlineCode",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Falloc%2Fstring%2Fstruct%2EString"
                },
                {
                  "text": " (whose ",
                  "style": "Plain"
                },
                {
                  "text": "Deref",
                  "style": "InlineCode"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "implementation has ",
                  "style": "Plain"
                },
                {
                  "text": "Target = str",
                  "style": "InlineCode"
                },
                {
                  "text": ") can have many methods, since avoiding",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "collision is much easier. ",
                  "style": "Plain"
                },
                {
                  "text": "String",
                  "style": "InlineCode"
                },
                {
                  "text": " and ",
                  "style": "Plain"
                },
                {
                  "text": "str",
                  "style": "InlineCode"
                },
                {
                  "text": " both have many methods, and",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "String",
                  "style": "InlineCode"
                },
                {
                  "text": " additionally behaves as if it has every method of ",
                  "style": "Plain"
                },
                {
                  "text": "str",
                  "style": "InlineCode"
                },
                {
                  "text": " because of",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "deref coercion. The implementing type may also be generic while the",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "implementation is still specific in this sense; for example, ",
                  "style": "Plain"
                },
                {
                  "text": "Vec<T>",
                  "style": "InlineCode",
                  "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3A%2E%2F%2E%2E%2Falloc%2Fvec%2Fstruct%2EVec"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "dereferences to ",
                  "style": "Plain"
                },
                {
                  "text": "[T]",
                  "style": "InlineCode"
                },
                {
                  "text": ", so methods of ",
                  "style": "Plain"
                },
                {
                  "text": "T",
                  "style": "InlineCode"
                },
                {
                  "text": " are not applicable.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Consider also that deref coercion means that deref traits are a much larger",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "part of a type's public API than any other trait as it is implicitly called",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "by the compiler. Therefore, it is advisable to consider whether this is",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "something you are comfortable supporting as a public API.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The ",
                  "style": "Plain"
                },
                {
                  "text": "AsRef",
                  "style": "InlineCode",
                  "url": "http://docs.rust-lang.org/nightly/core/convert/trait.AsRef.html"
                },
                {
                  "text": " and ",
                  "style": "Plain"
                },
                {
                  "text": "Borrow",
                  "style": "InlineCode",
                  "url": "http://docs.rust-lang.org/nightly/core/borrow/trait.Borrow.html"
                },
                {
                  "text": " traits have very similar",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "signatures to ",
                  "style": "Plain"
                },
                {
                  "text": "Deref",
                  "style": "InlineCode"
                },
                {
                  "text": ". It may be desirable to implement either or both of",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "these, whether in addition to or rather than deref traits. See their",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "documentation for details.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "heading",
              "level": "Title",
              "spans": [
                {
                  "text": "Fallibility",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "This trait's method should never unexpectedly fail",
                  "style": "Strong"
                },
                {
                  "text": ". Deref coercion means",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "the compiler will often insert calls to ",
                  "style": "Plain"
                },
                {
                  "text": "Deref::deref",
                  "style": "InlineCode"
                },
                {
                  "text": " implicitly. Failure",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "during dereferencing can be extremely confusing when ",
                  "style": "Plain"
                },
                {
                  "text": "Deref",
                  "style": "InlineCode"
                },
                {
                  "text": " is invoked",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "implicitly. In the majority of uses it should be infallible, though it may",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "be acceptable to panic if the type is misused through programmer error, for",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "example.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "However, infallibility is not enforced and therefore not guaranteed.",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "As such, ",
                  "style": "Plain"
                },
                {
                  "text": "unsafe",
                  "style": "InlineCode"
                },
                {
                  "text": " code should not rely on infallibility in general for",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "soundness.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "heading",
              "level": "Title",
              "spans": [
                {
                  "text": "Examples",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "A struct with a single field which is accessible by dereferencing the",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "struct.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "codeBlock",
              "lang": "rust",
              "code": "use std::ops::Deref;\n\nstruct DerefExample<T> {\n    value: T\n}\n\nimpl<T> Deref for DerefExample<T> {\n    type Target = T;\n\n    fn deref(&self) -> &Self::Target {\n        &self.value\n    }\n}\n\nlet x = DerefExample { value: 'a' };\nassert_eq!('a', *x);"
            }
          ],
          "level": "SingleLine"
        }
      ]
    }
  ]
}
