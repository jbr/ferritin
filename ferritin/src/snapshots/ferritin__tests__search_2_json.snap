            {
              "type": "codeBlock",
              "lang": "rust",
              "code": "// `derive` implements Clone for Reading<T> when T is Clone.\n#[derive(Clone)]\nstruct Reading<T> {\n    frequency: T,\n}"
            },
            {
              "type": "heading",
