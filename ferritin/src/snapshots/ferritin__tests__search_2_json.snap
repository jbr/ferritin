            },
            {
              "type": "heading",
              "level": "Title",
              "spans": [
                {
                  "text": "Deref coercion",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "If ",
                  "style": "Plain"
                },
                {
                  "text": "T",
                  "style": "InlineCode"
                },
                {
                  "text": " implements ",
                  "style": "Plain"
                },
                {
                  "text": "Deref<Target = U>",
                  "style": "InlineCode"
                },
