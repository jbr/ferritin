                },
                {
                  "text": "Hash",
                  "style": "InlineCode"
                },
                {
                  "text": " needs to ignore ASCII case, too:",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "codeBlock",
              "lang": "rust",
              "code": "impl Hash for CaseInsensitiveString {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        for c in self.0.as_bytes() {\n            c.to_ascii_lowercase().hash(state)\n        }\n    }\n}"
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Can ",
                  "style": "Plain"
