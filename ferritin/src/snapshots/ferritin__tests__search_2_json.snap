                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "on the identical behavior of these additional trait implementations.",
                  "style": "Plain"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": "These traits will likely appear as additional trait bounds.",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "In particular ",
                  "style": "Plain"
                },
                {
                  "text": "Eq",
                  "style": "InlineCode"
                },
                {
                  "text": ", ",
                  "style": "Plain"
                },
                {
                  "text": "Ord",
                  "style": "InlineCode"
                },
