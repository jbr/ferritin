        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Markdown uses email-style ",
              "style": "Plain"
            },
            {
              "text": ">",
              "style": "InlineCode"
            },
            {
              "text": " characters for blockquoting. If you're",
              "style": "Plain"
