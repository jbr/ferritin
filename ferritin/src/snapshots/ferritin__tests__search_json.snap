        {
          "content": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "alloc::collections::BTreeMap",
                  "style": "Plain",
                  "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": " (Struct) - score: 30.9",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "truncatedBlock",
              "nodes": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "An ordered map based on a ",
                      "style": "Plain"
                    },
                    {
                      "text": "B-Tree",
                      "style": "Plain",
                      "url": "https://en.wikipedia.org/wiki/B-tree"
                    },
                    {
                      "text": ".",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Given a key type with a ",
                      "style": "Plain"
                    },
                    {
                      "text": "total order",
                      "style": "Plain",
                      "url": "https://en.wikipedia.org/wiki/Total_order"
                    },
                    {
                      "text": ", an ordered map stores its entries in key order.",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "That means that keys must be of a type that implements the ",
                      "style": "Plain"
                    },
                    {
                      "text": "Ord",
                      "style": "InlineCode",
                      "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AOrd"
                    },
                    {
                      "text": " trait,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "such that two keys can always be compared to determine their ",
                      "style": "Plain"
                    },
                    {
                      "text": "Ordering",
                      "style": "InlineCode",
                      "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AOrdering"
                    },
                    {
                      "text": ".",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "Examples of keys with a total order are strings with lexicographical order,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "and numbers with their natural order.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Iterators obtained from functions such as ",
                      "style": "Plain"
                    },
                    {
                      "text": "BTreeMap::iter",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.iter"
                    },
                    {
                      "text": ", ",
                      "style": "Plain"
                    },
                    {
                      "text": "BTreeMap::into_iter",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.into_iter"
                    },
                    {
                      "text": ", ",
                      "style": "Plain"
                    },
                    {
                      "text": "BTreeMap::values",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.values"
                    },
                    {
                      "text": ", or",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "BTreeMap::keys",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.keys"
                    },
                    {
                      "text": " produce their items in key order, and take worst-case logarithmic and",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "amortized constant time per item returned.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "It is a logic error for a key to be modified in such a way that the key's ordering relative to",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "any other key, as determined by the ",
                      "style": "Plain"
                    },
                    {
                      "text": "Ord",
                      "style": "InlineCode",
                      "url": "https://doc.rust-lang.org/nightly/core/cmp/index.html?search=core%3A%3Acmp%3A%3AOrd"
                    },
                    {
                      "text": " trait, changes while it is in the map. This is",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "normally only possible through ",
                      "style": "Plain"
                    },
                    {
                      "text": "Cell",
                      "style": "InlineCode",
                      "url": "https://doc.rust-lang.org/nightly/core/cell/index.html?search=core%3A%3Acell%3A%3ACell"
                    },
                    {
                      "text": ", ",
                      "style": "Plain"
                    },
                    {
                      "text": "RefCell",
                      "style": "InlineCode",
                      "url": "https://doc.rust-lang.org/nightly/core/cell/index.html?search=core%3A%3Acell%3A%3ARefCell"
                    },
                    {
                      "text": ", global state, I/O, or unsafe code.",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "The behavior resulting from such a logic error is not specified, but will be encapsulated to the",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "BTreeMap",
                      "style": "InlineCode"
                    },
                    {
                      "text": " that observed the logic error and not result in undefined behavior. This could",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "include panics, incorrect results, aborts, memory leaks, and non-termination.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "level": "Title",
                  "spans": [
                    {
                      "text": "Examples",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "codeBlock",
                  "lang": "rust",
                  "code": "use std::collections::BTreeMap;\n\n// type inference lets us omit an explicit type signature (which\n// would be `BTreeMap<&str, &str>` in this example).\nlet mut movie_reviews = BTreeMap::new();\n\n// review some movies.\nmovie_reviews.insert(\"Office Space\",       \"Deals with real issues in the workplace.\");\nmovie_reviews.insert(\"Pulp Fiction\",       \"Masterpiece.\");\nmovie_reviews.insert(\"The Godfather\",      \"Very enjoyable.\");\nmovie_reviews.insert(\"The Blues Brothers\", \"Eye lyked it a lot.\");\n\n// check for a specific one.\nif !movie_reviews.contains_key(\"Les Misérables\") {\n    println!(\"We've got {} reviews, but Les Misérables ain't one.\",\n             movie_reviews.len());\n}\n\n// oops, this review has a lot of spelling mistakes, let's delete it.\nmovie_reviews.remove(\"The Blues Brothers\");\n\n// look up the values associated with some keys.\nlet to_find = [\"Up!\", \"Office Space\"];\nfor movie in &to_find {\n    match movie_reviews.get(movie) {\n       Some(review) => println!(\"{movie}: {review}\"),\n       None => println!(\"{movie} is unreviewed.\")\n    }\n}\n\n// Look up the value for a key (will panic if the key is not found).\nprintln!(\"Movie review: {}\", movie_reviews[\"Office Space\"]);\n\n// iterate over everything.\nfor (movie, review) in &movie_reviews {\n    println!(\"{movie}: \\\"{review}\\\"\");\n}"
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A ",
                      "style": "Plain"
                    },
                    {
                      "text": "BTreeMap",
                      "style": "InlineCode"
                    },
                    {
                      "text": " with a known list of items can be initialized from an array:",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "codeBlock",
                  "lang": "rust",
                  "code": "use std::collections::BTreeMap;\n\nlet solar_distance = BTreeMap::from([\n    (\"Mercury\", 0.4),\n    (\"Venus\", 0.7),\n    (\"Earth\", 1.0),\n    (\"Mars\", 1.5),\n]);"
                },
                {
                  "type": "heading",
                  "level": "Section",
                  "spans": [
                    {
                      "text": "Entry",
                      "style": "InlineCode"
                    },
                    {
                      "text": " API",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "BTreeMap",
                      "style": "InlineCode"
                    },
                    {
                      "text": " implements an ",
                      "style": "Plain"
                    },
                    {
                      "text": "Entry API",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.entry"
                    },
                    {
                      "text": ", which allows for complex",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "methods of getting, setting, updating and removing keys and their values:",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "codeBlock",
                  "lang": "rust",
                  "code": "use std::collections::BTreeMap;\n\n// type inference lets us omit an explicit type signature (which\n// would be `BTreeMap<&str, u8>` in this example).\nlet mut player_stats = BTreeMap::new();\n\nfn random_stat_buff() -> u8 {\n    // could actually return some random value here - let's just return\n    // some fixed value for now\n    42\n}\n\n// insert a key only if it doesn't already exist\nplayer_stats.entry(\"health\").or_insert(100);\n\n// insert a key using a function that provides a new value only if it\n// doesn't already exist\nplayer_stats.entry(\"defence\").or_insert_with(random_stat_buff);\n\n// update a key, guarding against the key possibly not being set\nlet stat = player_stats.entry(\"attack\").or_insert(100);\n*stat += random_stat_buff();\n\n// modify an entry before an insert with in-place mutation\nplayer_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"
                },
                {
                  "type": "heading",
                  "level": "Title",
                  "spans": [
                    {
                      "text": "Background",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A B-tree is (like) a ",
                      "style": "Plain"
                    },
                    {
                      "text": "binary search tree",
                      "style": "Plain",
                      "url": "https://en.wikipedia.org/wiki/Binary_search_tree"
                    },
                    {
                      "text": ", but adapted to the natural granularity that modern",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "machines like to consume data at. This means that each node contains an entire array of elements,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "instead of just a single element.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "B-Trees represent a fundamental compromise between cache-efficiency and actually minimizing",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "the amount of work performed in a search. In theory, a binary search tree (BST) is the optimal",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "choice for a sorted map, as a perfectly balanced BST performs the theoretical minimum number of",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "comparisons necessary to find an element (log",
                      "style": "Plain"
                    },
                    {
                      "text": "2",
                      "style": "Plain"
                    },
                    {
                      "text": "n). However, in practice the way this",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "is done is ",
                      "style": "Plain"
                    },
                    {
                      "text": "very",
                      "style": "Emphasis"
                    },
                    {
                      "text": " inefficient for modern computer architectures. In particular, every element",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "is stored in its own individually heap-allocated node. This means that every single insertion",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "triggers a heap-allocation, and every comparison is a potential cache-miss due to the indirection.",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "Since both heap-allocations and cache-misses are notably expensive in practice, we are forced to,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "at the very least, reconsider the BST strategy.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A B-Tree instead makes each node contain B-1 to 2B-1 elements in a contiguous array. By doing",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "this, we reduce the number of allocations by a factor of B, and improve cache efficiency in",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "searches. However, this does mean that searches will have to do ",
                      "style": "Plain"
                    },
                    {
                      "text": "more",
                      "style": "Emphasis"
                    },
                    {
                      "text": " comparisons on average.",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "The precise number of comparisons depends on the node search strategy used. For optimal cache",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "efficiency, one could search the nodes linearly. For optimal comparisons, one could search",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "the node using binary search. As a compromise, one could also perform a linear search",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "that initially only checks every i",
                      "style": "Plain"
                    },
                    {
                      "text": "th",
                      "style": "Plain"
                    },
                    {
                      "text": " element for some choice of i.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Currently, our implementation simply performs naive linear search. This provides excellent",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "performance on ",
                      "style": "Plain"
                    },
                    {
                      "text": "small",
                      "style": "Emphasis"
                    },
                    {
                      "text": " nodes of elements which are cheap to compare. However in the future we",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "would like to further explore choosing the optimal search strategy based on the choice of B,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "and possibly other factors. Using linear search, searching for a random element is expected",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "to take B * log(n) comparisons, which is generally worse than a BST. In practice,",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "however, performance is excellent.",
                      "style": "Plain"
                    }
                  ]
                }
              ],
              "level": "SingleLine"
            }
          ]
        },
        {
          "content": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "std::io::LineWriter",
                  "style": "Plain",
                  "url": "http://docs.rust-lang.org/nightly/std/io/buffered/linewriter/struct.LineWriter.html"
                },
                {
                  "text": " ",
                  "style": "Plain"
                },
                {
                  "text": " (Struct) - score: 30.7",
                  "style": "Plain"
                }
              ]
            },
            {
              "type": "truncatedBlock",
              "nodes": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Wraps a writer and buffers output to it, flushing whenever a newline",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "(",
                      "style": "Plain"
                    },
                    {
                      "text": "0x0a",
                      "style": "InlineCode"
                    },
                    {
                      "text": ", ",
                      "style": "Plain"
                    },
                    {
                      "text": "'\\n'",
                      "style": "InlineCode"
                    },
                    {
                      "text": ") is detected.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "The ",
                      "style": "Plain"
                    },
                    {
                      "text": "BufWriter",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/std/io/buffered/bufwriter/struct.BufWriter.html"
                    },
                    {
                      "text": " struct wraps a writer and buffers its output.",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "But it only does this batched write when it goes out of scope, or when the",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "internal buffer is full. Sometimes, you'd prefer to write each line as it's",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "completed, rather than the entire buffer at once. Enter ",
                      "style": "Plain"
                    },
                    {
                      "text": "LineWriter",
                      "style": "InlineCode"
                    },
                    {
                      "text": ". It",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "does exactly that.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Like ",
                      "style": "Plain"
                    },
                    {
                      "text": "BufWriter",
                      "style": "InlineCode",
                      "url": "http://docs.rust-lang.org/nightly/std/io/buffered/bufwriter/struct.BufWriter.html"
                    },
                    {
                      "text": ", a ",
                      "style": "Plain"
                    },
                    {
                      "text": "LineWriter",
                      "style": "InlineCode"
                    },
                    {
                      "text": "’s buffer will also be flushed when the",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "LineWriter",
                      "style": "InlineCode"
                    },
                    {
                      "text": " goes out of scope or when its internal buffer is full.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "If there's still a partial line in the buffer when the ",
                      "style": "Plain"
                    },
                    {
                      "text": "LineWriter",
                      "style": "InlineCode"
                    },
                    {
                      "text": " is",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "dropped, it will flush those contents.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "level": "Title",
                  "spans": [
                    {
                      "text": "Examples",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "We can use ",
                      "style": "Plain"
                    },
                    {
                      "text": "LineWriter",
                      "style": "InlineCode"
                    },
                    {
                      "text": " to write one line at a time, significantly",
                      "style": "Plain"
                    },
                    {
                      "text": " ",
                      "style": "Plain"
                    },
                    {
                      "text": "reducing the number of actual writes to the file.",
                      "style": "Plain"
                    }
                  ]
                },
                {
                  "type": "codeBlock",
                  "lang": "rust",
                  "code": "use std::fs::{self, File};\nuse std::io::prelude::*;\nuse std::io::LineWriter;\n\nfn main() -> std::io::Result<()> {\n    let road_not_taken = b\"I shall be telling this with a sigh\nSomewhere ages and ages hence:\nTwo roads diverged in a wood, and I -\nI took the one less traveled by,\nAnd that has made all the difference.\";\n\n    let file = File::create(\"poem.txt\")?;\n    let mut file = LineWriter::new(file);\n\n    file.write_all(b\"I shall be telling this with a sigh\")?;\n\n    // No bytes are written until a newline is encountered (or\n    // the internal buffer is filled).\n    assert_eq!(fs::read_to_string(\"poem.txt\")?, \"\");\n    file.write_all(b\"\\n\")?;\n    assert_eq!(\n        fs::read_to_string(\"poem.txt\")?,\n        \"I shall be telling this with a sigh\\n\",\n    );\n\n    // Write the rest of the poem.\n    file.write_all(b\"Somewhere ages and ages hence:\nTwo roads diverged in a wood, and I -\nI took the one less traveled by,\nAnd that has made all the difference.\")?;\n\n    // The last line of the poem doesn't end in a newline, so\n    // we have to flush or drop the `LineWriter` to finish\n    // writing.\n    file.flush()?;\n\n    // Confirm the whole poem was written.\n    assert_eq!(fs::read(\"poem.txt\")?, &road_not_taken[..]);\n    Ok(())\n}"
                }
              ],
              "level": "SingleLine"
            }
          ]
        }
      ]
    }
  ]
