              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ownership of ",
                    "style": "Plain"
                  },
                  {
                    "text": "ptr",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is effectively transferred to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " which may then deallocate, reallocate or change the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "contents of memory pointed to by the pointer at will. Ensure",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that nothing else uses the pointer after calling this",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "function.",
                    "style": "Plain"
                  }
