      {
        "path": "Vec::extend_from_within",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.extend_from_within",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Given a range ",
                    "style": "Plain"
                  },
                  {
                    "text": "src",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", clones a slice of elements in that range and appends it to the end.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "src",
                    "style": "InlineCode"
                  },
                  {
                    "text": " must be a range that can form a valid subslice of the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if starting index is greater than the end index, if the index is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "greater than the length of the vector, or if the new capacity exceeds",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "isize::MAX",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "bytes",
                    "style": "Emphasis"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut characters = vec!['a', 'b', 'c', 'd', 'e'];\ncharacters.extend_from_within(2..);\nassert_eq!(characters, ['a', 'b', 'c', 'd', 'e', 'c', 'd', 'e']);\n\nlet mut numbers = vec![0, 1, 2, 3, 4];\nnumbers.extend_from_within(..2);\nassert_eq!(numbers, [0, 1, 2, 3, 4, 0, 1]);\n\nlet mut strings = vec![String::from(\"hello\"), String::from(\"world\"), String::from(\"!\")];\nstrings.extend_from_within(1..=2);\nassert_eq!(strings, [\"hello\", \"world\", \"!\", \"world\", \"!\"]);"
              }
            ],
            "level": "SingleLine"
          }
        ]
