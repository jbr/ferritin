                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "length",
                            "style": "InlineCode"
                          },
                          {
                            "text": " needs to be less than or equal to ",
                            "style": "Plain"
                          },
                          {
                            "text": "capacity",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The first ",
                            "style": "Plain"
                          },
                          {
                            "text": "length",
                            "style": "InlineCode"
                          },
                          {
                            "text": " values must be properly initialized values of type ",
                            "style": "Plain"
                          },
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "capacity",
                            "style": "InlineCode"
                          },
                          {
                            "text": " needs to be the capacity that the pointer was allocated with,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "if the pointer is required to be allocated.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The allocated size in bytes must be no larger than ",
                            "style": "Plain"
                          },
                          {
                            "text": "isize::MAX",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "See the safety documentation of ",
                            "style": "Plain"
                          },
                          {
                            "text": "pointer::offset",
                            "style": "InlineCode",
                            "url": "https://docs.rs/pointer/latest/pointer/index.html?search=pointer%3A%3Aoffset"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "These requirements are always upheld by any ",
                    "style": "Plain"
                  },
                  {
                    "text": "ptr",
                    "style": "InlineCode"
                  },
                  {
                    "text": " that has been allocated",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "via ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Other allocation sources are allowed if the invariants are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "upheld.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Violating these may cause problems like corrupting the allocator's",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "internal data structures. For example it is normally ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Strong"
                  },
                  {
                    "text": " safe",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to build a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<u8>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " from a pointer to a C ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " array with length",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "size_t",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", doing so is only safe if the array was initially allocated by",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "It's also not safe to build one from a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<u16>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and its length, because",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the allocator cares about the alignment, and these two types have different",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "alignments. The buffer was allocated with alignment 2 (for ",
                    "style": "Plain"
                  },
                  {
                    "text": "u16",
                    "style": "InlineCode"
                  },
                  {
                    "text": "), but after",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "turning it into a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<u8>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " it'll be deallocated with alignment 1. To avoid",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "these issues, it is often preferable to do casting/transmuting using",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "slice::from_raw_parts",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/slice/raw/index.html?search=core%3A%3Aslice%3A%3Araw%3A%3Afrom%5Fraw%5Fparts"
                  },
                  {
                    "text": " instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ownership of ",
                    "style": "Plain"
                  },
                  {
                    "text": "ptr",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is effectively transferred to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " which may then deallocate, reallocate or change the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "contents of memory pointed to by the pointer at will. Ensure",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "that nothing else uses the pointer after calling this",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "function.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::ptr;\n\nlet v = vec![1, 2, 3];\n\n// Deconstruct the vector into parts.\nlet (p, len, cap) = v.into_raw_parts();\n\nunsafe {\n    // Overwrite memory with 4, 5, 6\n    for i in 0..len {\n        ptr::write(p.add(i), 4 + i);\n    }\n\n    // Put everything back together into a Vec\n    let rebuilt = Vec::from_raw_parts(p, len, cap);\n    assert_eq!(rebuilt, [4, 5, 6]);\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Using memory that was allocated elsewhere:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::alloc::{alloc, Layout};\n\nfn main() {\n    let layout = Layout::array::<u32>(16).expect(\"overflow cannot happen\");\n\n    let vec = unsafe {\n        let mem = alloc(layout).cast::<u32>();\n        if mem.is_null() {\n            return;\n        }\n\n        mem.write(1_000_000);\n\n        Vec::from_raw_parts(mem, 1, 16)\n    };\n\n    assert_eq!(vec, &[1_000_000]);\n    assert_eq!(vec.capacity(), 16);\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
