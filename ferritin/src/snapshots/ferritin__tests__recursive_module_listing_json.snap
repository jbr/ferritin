      {
        "path": "link_resolution_tests::Tree::lower_bound",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.lower_bound",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Returns a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Cursor",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.Cursor.html"
                  },
                  {
                    "text": " pointing at the gap before the smallest key",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "greater than the given bound.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Passing ",
                    "style": "Plain"
                  },
                  {
                    "text": "Bound::Included(x)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will return a cursor pointing to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "gap before the smallest key greater than or equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "x",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Passing ",
                    "style": "Plain"
                  },
                  {
                    "text": "Bound::Excluded(x)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will return a cursor pointing to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "gap before the smallest key greater than ",
                    "style": "Plain"
                  },
                  {
                    "text": "x",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Passing ",
                    "style": "Plain"
                  },
                  {
                    "text": "Bound::Unbounded",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will return a cursor pointing to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "gap before the smallest key in the map.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(btree_cursors)]\n\nuse std::collections::BTreeMap;\nuse std::ops::Bound;\n\nlet map = BTreeMap::from([\n    (1, \"a\"),\n    (2, \"b\"),\n    (3, \"c\"),\n    (4, \"d\"),\n]);\n\nlet cursor = map.lower_bound(Bound::Included(&2));\nassert_eq!(cursor.peek_prev(), Some((&1, &\"a\")));\nassert_eq!(cursor.peek_next(), Some((&2, &\"b\")));\n\nlet cursor = map.lower_bound(Bound::Excluded(&2));\nassert_eq!(cursor.peek_prev(), Some((&2, &\"b\")));\nassert_eq!(cursor.peek_next(), Some((&3, &\"c\")));\n\nlet cursor = map.lower_bound(Bound::Unbounded);\nassert_eq!(cursor.peek_prev(), None);\nassert_eq!(cursor.peek_next(), Some((&1, &\"a\")));"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::lower_bound_mut",
