              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If a key from ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is already present in ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", then the ",
                    "style": "Plain"
                  },
                  {
                    "text": "conflict",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "closure is used to return a value to ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The ",
                    "style": "Plain"
                  },
                  {
                    "text": "conflict",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "closure takes in a borrow of ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s key, ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s value, and ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s value",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in that order.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "An example of why one might use this method over ",
                    "style": "Plain"
                  },
                  {
                    "text": "append",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.append"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is to combine ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s value with ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": "'s value when their keys conflict.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Similar to ",
                    "style": "Plain"
                  },
                  {
                    "text": "insert",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.insert"
                  },
                  {
                    "text": ", though, the key is not overwritten,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which matters for types that can be ",
                    "style": "Plain"
                  },
                  {
                    "text": "==",
                    "style": "InlineCode"
                  },
                  {
                    "text": " without being identical.",
                    "style": "Plain"
                  }
                ]
              },
