                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This function returns an error if the allocator fails to shrink the allocation,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the vector thereafter is still safe to use, the capacity remains unchanged",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "however. See ",
