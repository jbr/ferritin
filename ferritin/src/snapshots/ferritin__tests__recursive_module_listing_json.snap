      {
        "path": "Vec::dedup_by",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.dedup_by",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Removes all but the first of consecutive elements in the vector satisfying a given equality",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "relation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "same_bucket",
                    "style": "InlineCode"
                  },
                  {
                    "text": " function is passed references to two elements from the vector and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "must determine if the elements compare equal. The elements are passed in opposite order",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "from their order in the slice, so if ",
                    "style": "Plain"
                  },
                  {
                    "text": "same_bucket(a, b)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "true",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "a",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is removed.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the vector is sorted, this removes all duplicates.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec = vec![\"foo\", \"bar\", \"Bar\", \"baz\", \"bar\"];\n\nvec.dedup_by(|a, b| a.eq_ignore_ascii_case(b));\n\nassert_eq!(vec, [\"foo\", \"bar\", \"baz\", \"bar\"]);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "Vec::push_within_capacity",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.push_within_capacity",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Appends an element and returns a reference to it if there is sufficient spare capacity,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "otherwise an error is returned with the element.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unlike ",
                    "style": "Plain"
                  },
                  {
                    "text": "push",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.push"
                  },
                  {
                    "text": " this method will not reallocate when there's insufficient capacity.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The caller should use ",
                    "style": "Plain"
                  },
                  {
                    "text": "reserve",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.reserve"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.try_reserve"
                  },
                  {
                    "text": " to ensure that there is enough capacity.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A manual, panic-free alternative to ",
                    "style": "Plain"
                  },
                  {
                    "text": "FromIterator",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/iter/traits/collect/index.html?search=core%3A%3Aiter%3A%3Atraits%3A%3Acollect%3A%3AFromIterator"
                  },
                  {
                    "text": ":",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_push_within_capacity)]\n\nuse std::collections::TryReserveError;\nfn from_iter_fallible<T>(iter: impl Iterator<Item=T>) -> Result<Vec<T>, TryReserveError> {\n    let mut vec = Vec::new();\n    for value in iter {\n        if let Err(value) = vec.push_within_capacity(value) {\n            vec.try_reserve(1)?;\n            // this cannot fail, the previous line either returned or added at least 1 free slot\n            let _ = vec.push_within_capacity(value);\n        }\n    }\n    Ok(vec)\n}\nassert_eq!(from_iter_fallible(0..100), Ok(Vec::from_iter(0..100)));"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Time complexity",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Takes ",
                    "style": "Plain"
                  },
                  {
                    "text": "O",
                    "style": "Emphasis"
                  },
                  {
                    "text": "(1) time.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
