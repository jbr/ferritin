                    "style": "Plain"
                  },
                  {
                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Does nothing if the capacity is already",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "sufficient.",
                    "style": "Plain"
                  }
