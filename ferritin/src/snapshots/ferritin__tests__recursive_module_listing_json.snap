                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of the vector.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut v = vec![1, 2, 3];\n\nv.clear();\n\nassert!(v.is_empty());"
