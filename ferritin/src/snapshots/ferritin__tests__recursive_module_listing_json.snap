                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Note: the ABI is not stable and ",
                            "style": "Plain"
                          },
                          {
                            "text": "Vec",
                            "style": "InlineCode"
                          },
                          {
                            "text": " makes no guarantees about its memory",
