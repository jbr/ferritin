                "type": "codeBlock",
                "lang": "rust",
                "code": "// `s` is ASCII which represents each `char` as one byte\nlet s = \"hello\";\nassert_eq!(s.len(), 5);\n\n// A `char` array with the same contents would be longer because\n// every `char` is four bytes\nlet s = ['h', 'e', 'l', 'l', 'o'];\nlet size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();\nassert_eq!(size, 20);\n\n// However, for non-ASCII strings, the difference will be smaller\n// and sometimes they are the same\nlet s = \"💖💖💖💖💖\";\nassert_eq!(s.len(), 20);\n\nlet s = ['💖', '💖', '💖', '💖', '💖'];\nlet size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();\nassert_eq!(size, 20);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This raises interesting questions as to how ",
                    "style": "Plain"
                  },
                  {
                    "text": "s[i]",
                    "style": "InlineCode"
                  },
                  {
                    "text": " should work.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "What should ",
                    "style": "Plain"
                  },
                  {
                    "text": "i",
                    "style": "InlineCode"
                  },
                  {
                    "text": " be here? Several options include byte indices and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": " indices but, because of UTF-8 encoding, only byte indices",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "would provide constant time indexing. Getting the ",
                    "style": "Plain"
                  },
                  {
                    "text": "i",
                    "style": "InlineCode"
                  },
                  {
                    "text": "th ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example, is available using ",
                    "style": "Plain"
                  },
                  {
                    "text": "chars",
                    "style": "InlineCode",
