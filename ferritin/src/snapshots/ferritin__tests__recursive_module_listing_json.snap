                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Does nothing if capacity is already sufficient.",
                    "style": "Plain"
                  }
