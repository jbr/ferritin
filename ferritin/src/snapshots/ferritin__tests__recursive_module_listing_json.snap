                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec: Vec<i32> = Vec::with_capacity(10);\nvec.push(42);\nassert!(vec.capacity() >= 10);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A vector with zero-sized elements will always have a capacity of usize::MAX:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#[derive(Clone)]\nstruct ZeroSized;\n\nfn main() {\n    assert_eq!(std::mem::size_of::<ZeroSized>(), 0);\n    let v = vec![ZeroSized; 0];\n    assert_eq!(v.capacity(), usize::MAX);\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
