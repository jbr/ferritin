      {
        "path": "Vec::set_len",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.set_len",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Forces the length of the vector to ",
                    "style": "Plain"
                  },
                  {
                    "text": "new_len",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This is a low-level operation that maintains none of the normal",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "invariants of the type. Normally changing the length of a vector",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is done using one of the safe operations instead, such as",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "truncate",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.truncate"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "resize",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.resize"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "extend",
                    "style": "InlineCode",
                    "url": "https://docs.rs/Extend/latest/Extend/index.html?search=Extend%3A%3Aextend"
                  },
                  {
                    "text": ", or ",
                    "style": "Plain"
                  },
                  {
                    "text": "clear",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.clear"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Safety",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "new_len",
                            "style": "InlineCode"
                          },
                          {
                            "text": " must be less than or equal to ",
                            "style": "Plain"
                          },
                          {
                            "text": "capacity()",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.capacity"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The elements at ",
                            "style": "Plain"
                          },
                          {
                            "text": "old_len..new_len",
                            "style": "InlineCode"
                          },
                          {
                            "text": " must be initialized.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "See ",
                    "style": "Plain"
                  },
                  {
                    "text": "spare_capacity_mut()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.spare_capacity_mut"
                  },
                  {
                    "text": " for an example with safe",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "initialization of capacity elements and use of this method.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "set_len()",
                    "style": "InlineCode"
                  },
                  {
                    "text": " can be useful for situations in which the vector",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is serving as a buffer for other code, particularly over FFI:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "pub fn get_dictionary(&self) -> Option<Vec<u8>> {\n    // Per the FFI method's docs, \"32768 bytes is always enough\".\n    let mut dict = Vec::with_capacity(32_768);\n    let mut dict_length = 0;\n    // SAFETY: When `deflateGetDictionary` returns `Z_OK`, it holds that:\n    // 1. `dict_length` elements were initialized.\n    // 2. `dict_length` <= the capacity (32_768)\n    // which makes `set_len` safe to call.\n    unsafe {\n        // Make the FFI call...\n        let r = deflateGetDictionary(self.strm, dict.as_mut_ptr(), &mut dict_length);\n        if r == Z_OK {\n            // ...and update the length to what was initialized.\n            dict.set_len(dict_length);\n            Some(dict)\n        } else {\n            None\n        }\n    }\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "While the following example is sound, there is a memory leak since",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the inner vectors were not freed prior to the ",
                    "style": "Plain"
                  },
                  {
                    "text": "set_len",
                    "style": "InlineCode"
                  },
                  {
                    "text": " call:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec = vec![vec![1, 0, 0],\n                   vec![0, 1, 0],\n                   vec![0, 0, 1]];\n// SAFETY:\n// 1. `old_len..0` is empty so no elements need to be initialized.\n// 2. `0 <= capacity` always holds whatever `capacity` is.\nunsafe {\n    vec.set_len(0);\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Normally, here, one would use ",
                    "style": "Plain"
                  },
                  {
                    "text": "clear",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.clear"
                  },
                  {
                    "text": " instead to correctly drop",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the contents and thus not leak memory.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
