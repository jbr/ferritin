                    "text": " to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example_func(&*example_string);",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". In this case we are dereferencing a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
