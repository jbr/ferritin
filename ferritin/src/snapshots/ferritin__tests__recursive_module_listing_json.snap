        "path": "link_resolution_tests::Tree::insert",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.insert",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Inserts a key-value pair into the map.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the map did not have this key present, ",
                    "style": "Plain"
                  },
                  {
                    "text": "None",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is returned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the map did have this key present, the value is updated, and the old",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "value is returned. The key is not updated, though; this matters for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "types that can be ",
                    "style": "Plain"
                  },
                  {
                    "text": "==",
                    "style": "InlineCode"
                  },
                  {
                    "text": " without being identical. See the ",
                    "style": "Plain"
                  },
                  {
                    "text": "module-level",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Aindex"
                  },
                  {
                    "text": " ",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Aindex"
                  },
                  {
                    "text": "documentation",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3Aindex"
                  },
                  {
                    "text": " for more.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::BTreeMap;\n\nlet mut map = BTreeMap::new();\nassert_eq!(map.insert(37, \"a\"), None);\nassert_eq!(map.is_empty(), false);\n\nmap.insert(37, \"b\");\nassert_eq!(map.insert(37, \"c\"), Some(\"b\"));\nassert_eq!(map[&37], \"c\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
