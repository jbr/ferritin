      {
        "path": "link_resolution_tests::Tree::split_off",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.split_off",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Splits the collection into two at the given key. Returns everything after the given key,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "including the key. If the key is not present, the split will occur at the nearest",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "greater key, or return an empty map if no such key exists.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine",
            "truncated": true
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::extract_if",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/BTreeMap/fn.extract_if.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Creates an iterator that visits elements (key-value pairs) in the specified range in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ascending key order and uses a closure to determine if an element",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "should be removed.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine",
            "truncated": true
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::extract_if_inner",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.extract_if_inner"
      },
      {
        "path": "link_resolution_tests::Tree::into_keys",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/BTreeMap/fn.into_keys.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Creates a consuming iterator visiting all the keys, in sorted order.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
