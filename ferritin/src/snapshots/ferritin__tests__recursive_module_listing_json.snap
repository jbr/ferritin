      {
        "path": "link_resolution_tests::Tree::range",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.range",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Constructs a double-ended iterator over a sub-range of elements in the map.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The simplest way is to use the range syntax ",
                    "style": "Plain"
                  },
                  {
                    "text": "min..max",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", thus ",
                    "style": "Plain"
                  },
                  {
                    "text": "range(min..max)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "yield elements from min (inclusive) to max (exclusive).",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The range may also be entered as ",
                    "style": "Plain"
                  },
                  {
                    "text": "(Bound<T>, Bound<T>)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", so for example",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "range((Excluded(4), Included(10)))",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will yield a left-exclusive, right-inclusive",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "range from 4 to 10.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if range ",
                    "style": "Plain"
                  },
                  {
                    "text": "start > end",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Panics if range ",
                    "style": "Plain"
                  },
                  {
                    "text": "start == end",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and both bounds are ",
                    "style": "Plain"
                  },
                  {
                    "text": "Excluded",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::BTreeMap;\nuse std::ops::Bound::Included;\n\nlet mut map = BTreeMap::new();\nmap.insert(3, \"a\");\nmap.insert(5, \"b\");\nmap.insert(8, \"c\");\nfor (&key, &value) in map.range((Included(&4), Included(&8))) {\n    println!(\"{key}: {value}\");\n}\nassert_eq!(Some((&5, &\"b\")), map.range(4..).next());"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
