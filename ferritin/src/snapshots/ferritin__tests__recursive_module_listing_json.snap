                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Astr"
                  },
                  {
                    "text": " implements the trait ",
                    "style": "Plain"
                  },
                  {
                    "text": "TraitExample",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and the function",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example_func",
                    "style": "InlineCode"
                  },
                  {
                    "text": " takes anything that implements the trait. In this case Rust",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "would need to make two implicit conversions, which Rust doesn't have the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "means to do. For that reason, the following example will not compile.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "trait TraitExample {}\n\nimpl<'a> TraitExample for &'a str {}\n\nfn example_func<A: TraitExample>(example_arg: A) {}\n\nlet example_string = String::from(\"example_string\");\nexample_func(&example_string);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "There are two options that would work instead. The first would be to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "change the line ",
                    "style": "Plain"
                  },
                  {
                    "text": "example_func(&example_string);",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example_func(example_string.as_str());",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", using the method ",
                    "style": "Plain"
                  },
                  {
                    "text": "as_str()",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.as_str"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to explicitly extract the string slice containing the string. The second",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "way changes ",
                    "style": "Plain"
                  },
                  {
                    "text": "example_func(&example_string);",
                    "style": "InlineCode"
