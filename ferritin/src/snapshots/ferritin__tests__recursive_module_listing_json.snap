        "path": "Vec::try_reserve",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.try_reserve",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tries to reserve capacity for at least ",
                    "style": "Plain"
                  },
                  {
                    "text": "additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " more elements to be inserted",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the given ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The collection may reserve more space to speculatively avoid",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "frequent reallocations. After calling ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", capacity will be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "greater than or equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " if it returns",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok(())",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Does nothing if capacity is already sufficient. This method",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "preserves the contents even if an error occurs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Errors",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the capacity overflows, or the allocator reports a failure, then an error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is returned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::TryReserveError;\n\nfn process_data(data: &[u32]) -> Result<Vec<u32>, TryReserveError> {\n    let mut output = Vec::new();\n\n    // Pre-reserve the memory, exiting if we can't\n    output.try_reserve(data.len())?;\n\n    // Now we know this can't OOM in the middle of our complex work\n    output.extend(data.iter().map(|&val| {\n        val * 2 + 5 // very complicated\n    }));\n\n    Ok(output)\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
