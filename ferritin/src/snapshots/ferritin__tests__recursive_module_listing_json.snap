      {
        "path": "link_resolution_tests::HashSet::is_superset",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/std/collections/hash/set/struct.HashSet.html#method.is_superset",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
