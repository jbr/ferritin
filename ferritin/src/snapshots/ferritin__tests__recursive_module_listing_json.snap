                  },
                  {
                    "text": " is not a public child.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "They should be resolved via the ",
                    "style": "Plain"
                  },
