              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In other words, remove all elements ",
                    "style": "Plain"
                  },
                  {
                    "text": "e",
                    "style": "InlineCode"
                  },
                  {
                    "text": " such that ",
                    "style": "Plain"
                  },
                  {
                    "text": "f(&mut e)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "false",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This method operates in place, visiting each element exactly once in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "original order, and preserves the order of the retained elements.",
                    "style": "Plain"
                  }
                ]
