              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(box_vec_non_null)]\n\nlet v = vec![1, 2, 3];\n\n// Deconstruct the vector into parts.\nlet (p, len, cap) = v.into_parts();\n\nunsafe {\n    // Overwrite memory with 4, 5, 6\n    for i in 0..len {\n        p.add(i).write(4 + i);\n    }\n\n    // Put everything back together into a Vec\n    let rebuilt = Vec::from_parts(p, len, cap);\n    assert_eq!(rebuilt, [4, 5, 6]);\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Using memory that was allocated elsewhere:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(box_vec_non_null)]\n\nuse std::alloc::{alloc, Layout};\nuse std::ptr::NonNull;\n\nfn main() {\n    let layout = Layout::array::<u32>(16).expect(\"overflow cannot happen\");\n\n    let vec = unsafe {\n        let Some(mem) = NonNull::new(alloc(layout).cast::<u32>()) else {\n            return;\n        };\n\n        mem.write(1_000_000);\n\n        Vec::from_parts(mem, 1, 16)\n    };\n\n    assert_eq!(vec, &[1_000_000]);\n    assert_eq!(vec.capacity(), 16);\n}"
              }
