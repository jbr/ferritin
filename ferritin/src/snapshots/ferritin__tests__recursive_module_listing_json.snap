                    "text": " with capacity 4 can be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "visualized as below. The top part is the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " struct, it contains a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pointer to the head of the allocation in the heap, length and capacity.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
