                    "text": "additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " bytes",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "more than the current length. Unlike ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.try_reserve"
                  },
                  {
                    "text": ", this will not",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "deliberately over-allocate to speculatively avoid frequent allocations.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "After calling ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve_exact",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", capacity will be greater than or",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " if it returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok(())",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Does nothing if the capacity is already sufficient.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that the allocator may give the collection more space than it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "requests. Therefore, capacity can not be relied upon to be precisely",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "minimal. Prefer ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.try_reserve"
                  },
                  {
                    "text": " if future insertions are expected.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Errors",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the capacity overflows, or the allocator reports a failure, then an error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is returned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::TryReserveError;\n\nfn process_data(data: &str) -> Result<String, TryReserveError> {\n    let mut output = String::new();\n\n    // Pre-reserve the memory, exiting if we can't\n    output.try_reserve_exact(data.len())?;\n\n    // Now we know this can't OOM in the middle of our complex work\n    output.push_str(data);\n\n    Ok(output)\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
