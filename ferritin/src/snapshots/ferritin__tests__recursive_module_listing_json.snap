              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Representation",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is made up of three components: a pointer to some bytes, a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "length, and a capacity. The pointer points to the internal buffer which ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "uses to store its data. The length is the number of bytes currently stored",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the buffer, and the capacity is the size of the buffer in bytes. As such,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the length will always be less than or equal to the capacity.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This buffer is always stored on the heap.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "You can look at these with the ",
                    "style": "Plain"
                  },
                  {
                    "text": "as_ptr",
                    "style": "InlineCode",
                    "url": "https://docs.rs/str/latest/str/index.html?search=str%3A%3Aas%5Fptr"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "len",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.len"
                  },
                  {
                    "text": ", and ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.capacity"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "methods:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let story = String::from(\"Once upon a time...\");\n\n// Deconstruct the String into parts.\nlet (ptr, len, capacity) = story.into_raw_parts();\n\n// story has nineteen bytes\nassert_eq!(19, len);\n\n// We can re-build a String out of ptr, len, and capacity. This is all\n// unsafe because we are responsible for making sure the components are\n// valid:\nlet s = unsafe { String::from_raw_parts(ptr, len, capacity) } ;\n\nassert_eq!(String::from(\"Once upon a time...\"), s);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If a ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " has enough capacity, adding elements to it will not",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "re-allocate. For example, consider this program:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut s = String::new();\n\nprintln!(\"{}\", s.capacity());\n\nfor _ in 0..5 {\n    s.push_str(\"hello\");\n    println!(\"{}\", s.capacity());\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This will output the following:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "text",
                "code": "0\n8\n16\n16\n32\n32\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "At first, we have no memory allocated at all, but as we append to the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "string, it increases its capacity appropriately. If we instead use the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "with_capacity",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.with_capacity"
                  },
                  {
                    "text": " method to allocate the correct capacity initially:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut s = String::with_capacity(25);\n\nprintln!(\"{}\", s.capacity());\n\nfor _ in 0..5 {\n    s.push_str(\"hello\");\n    println!(\"{}\", s.capacity());\n}"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "We end up with a different output:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "text",
                "code": "25\n25\n25\n25\n25\n25\n"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Here, there's no need to allocate more memory inside the loop.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
