                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.from_raw_parts_in"
                  },
                  {
                    "text": " function, allowing",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the destructor to perform the cleanup.",
                    "style": "Plain"
                  }
