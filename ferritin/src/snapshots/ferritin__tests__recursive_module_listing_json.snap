                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_fallible_shrink)]\n\nlet mut vec = Vec::with_capacity(10);\nvec.extend([1, 2, 3]);\nassert!(vec.capacity() >= 10);\nvec.try_shrink_to_fit().expect(\"why is the test harness failing to shrink to 12 bytes\");\nassert!(vec.capacity() >= 3);"
              }
