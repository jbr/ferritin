      {
        "path": "link_resolution_tests::HashSet::insert",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/std/collections/hash/set/struct.HashSet.html#method.insert",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Adds a value to the set.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Returns whether the value was newly inserted. That is:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If the set did not previously contain this value, ",
                            "style": "Plain"
                          },
                          {
                            "text": "true",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is returned.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If the set already contained this value, ",
                            "style": "Plain"
                          },
                          {
                            "text": "false",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is returned,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "and the set is not modified: original value is not replaced,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "and the value passed as argument is dropped.",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::HashSet;\n\nlet mut set = HashSet::new();\n\nassert_eq!(set.insert(2), true);\nassert_eq!(set.insert(2), false);\nassert_eq!(set.len(), 1);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::HashSet::replace",
