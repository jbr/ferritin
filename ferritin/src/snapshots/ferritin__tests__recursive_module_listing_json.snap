        "path": "Vec::extend_from_slice",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.extend_from_slice",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Clones and appends all elements in a slice to the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Iterates over the slice ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", clones each element, and then appends",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "it to this ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": " slice is traversed in-order.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note that this function is the same as ",
                    "style": "Plain"
                  },
                  {
                    "text": "extend",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.extend"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "except that it also works with slice elements that are Clone but not Copy.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "If Rust gets specialization this function may be deprecated.",
                    "style": "Plain"
                  }
                ]
