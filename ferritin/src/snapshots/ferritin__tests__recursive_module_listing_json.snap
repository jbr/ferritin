                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the map already had this key present, nothing is updated, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "an error containing the occupied entry, key, and the value is returned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
