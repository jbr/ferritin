                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Any decent text editor should make email-style quoting easy. For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "example, with BBEdit, you can make a selection and choose Increase",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Quote Level from the Text menu.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Section",
                "spans": [
                  {
                    "text": "Lists",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Markdown supports ordered (numbered) and unordered (bulleted) lists.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Unordered lists use asterisks, pluses, and hyphens -- interchangably",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "-- as list markers:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Red",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Green",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "Blue",
