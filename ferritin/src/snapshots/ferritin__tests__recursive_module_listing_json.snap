      {
        "path": "link_resolution_tests::Tree::extract_if",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.extract_if",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Creates an iterator that visits elements (key-value pairs) in the specified range in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "ascending key order and uses a closure to determine if an element",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "should be removed.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the closure returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "true",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", the element is removed from the map and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "yielded. If the closure returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "false",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", or panics, the element remains",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the map and will not be yielded.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The iterator also lets you mutate the value of each element in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "closure, regardless of whether you choose to keep or remove it.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the returned ",
                    "style": "Plain"
                  },
                  {
                    "text": "ExtractIf",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is not exhausted, e.g. because it is dropped without iterating",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "or the iteration short-circuits, then the remaining elements will be retained.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Use ",
                    "style": "Plain"
                  },
                  {
                    "text": "extract_if().for_each(drop)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " if you do not need the returned iterator,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "or ",
                    "style": "Plain"
                  },
                  {
                    "text": "retain",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.retain"
                  },
                  {
                    "text": " with a negated predicate if you also do not need to restrict the range.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::BTreeMap;\n\n// Splitting a map into even and odd keys, reusing the original map:\nlet mut map: BTreeMap<i32, i32> = (0..8).map(|x| (x, x)).collect();\nlet evens: BTreeMap<_, _> = map.extract_if(.., |k, _v| k % 2 == 0).collect();\nlet odds = map;\nassert_eq!(evens.keys().copied().collect::<Vec<_>>(), [0, 2, 4, 6]);\nassert_eq!(odds.keys().copied().collect::<Vec<_>>(), [1, 3, 5, 7]);\n\n// Splitting a map into low and high halves, reusing the original map:\nlet mut map: BTreeMap<i32, i32> = (0..8).map(|x| (x, x)).collect();\nlet low: BTreeMap<_, _> = map.extract_if(0..4, |_k, _v| true).collect();\nlet high = map;\nassert_eq!(low.keys().copied().collect::<Vec<_>>(), [0, 1, 2, 3]);\nassert_eq!(high.keys().copied().collect::<Vec<_>>(), [4, 5, 6, 7]);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
