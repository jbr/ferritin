      {
        "path": "link_resolution_tests::nested::Str::retain",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.retain",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Retains only the characters specified by the predicate.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In other words, remove all characters ",
                    "style": "Plain"
                  },
                  {
                    "text": "c",
                    "style": "InlineCode"
                  },
                  {
                    "text": " such that ",
                    "style": "Plain"
                  },
                  {
                    "text": "f(c)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "false",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This method operates in place, visiting each character exactly once in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "original order, and preserves the order of the retained characters.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut s = String::from(\"f_o_ob_ar\");\n\ns.retain(|c| c != '_');\n\nassert_eq!(s, \"foobar\");"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Because the elements are visited exactly once in the original order,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "external state may be used to decide which elements to keep.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut s = String::from(\"abcde\");\nlet keep = [false, true, true, false, true];\nlet mut iter = keep.iter();\ns.retain(|_| *iter.next().unwrap());\nassert_eq!(s, \"bce\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
