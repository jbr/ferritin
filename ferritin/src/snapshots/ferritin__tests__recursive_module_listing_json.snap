              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This method can be preferred over ",
                    "style": "Plain"
                  },
                  {
                    "text": "string = string.replacen(..., 1);",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/alloc/index.html?search=alloc%3A%3A%2E%2F%2E%2E%2Fstd%2Fprimitive%2Estr"
