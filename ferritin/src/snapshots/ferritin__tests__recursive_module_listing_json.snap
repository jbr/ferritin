                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(string_replace_in_place)]\n\nlet mut s = String::from(\"Test Results: ❌❌❌\");\n\n// Replace the leftmost ❌ with a ✅\ns.replace_first('❌', \"✅\");\nassert_eq!(s, \"Test Results: ✅❌❌\");"
