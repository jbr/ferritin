                  },
                  {
                    "text": "true",
                    "style": "InlineCode"
                  },
                  {
                    "text": " if the set is a superset of another,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "i.e., ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": " contains at least all the values in ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::HashSet;\n\nlet sub = HashSet::from([1, 2]);\nlet mut set = HashSet::new();\n\nassert_eq!(set.is_superset(&sub), false);\n\nset.insert(0);\nset.insert(1);\nassert_eq!(set.is_superset(&sub), false);\n\nset.insert(2);\nassert_eq!(set.is_superset(&sub), true);"
              }
            ],
            "level": "SingleLine"
          }
        ]
