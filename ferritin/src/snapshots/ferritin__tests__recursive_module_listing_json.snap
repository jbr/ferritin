      {
        "path": "Vec::retain",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.retain",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Retains only the elements specified by the predicate.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In other words, remove all elements ",
                    "style": "Plain"
                  },
                  {
                    "text": "e",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for which ",
                    "style": "Plain"
                  },
                  {
                    "text": "f(&e)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "false",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "This method operates in place, visiting each element exactly once in the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "original order, and preserves the order of the retained elements.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec = vec![1, 2, 3, 4];\nvec.retain(|&x| x % 2 == 0);\nassert_eq!(vec, [2, 4]);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Because the elements are visited exactly once in the original order,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "external state may be used to decide which elements to keep.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec = vec![1, 2, 3, 4, 5];\nlet keep = [false, true, true, false, true];\nlet mut iter = keep.iter();\nvec.retain(|_| *iter.next().unwrap());\nassert_eq!(vec, [2, 3, 5]);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "Vec::retain_mut",
