      {
        "path": "Vec::remove",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.remove",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Removes and returns the element at position ",
                    "style": "Plain"
                  },
                  {
                    "text": "index",
                    "style": "InlineCode"
                  },
                  {
                    "text": " within the vector,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "shifting all elements after it to the left.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Note: Because this shifts over the remaining elements, it has a",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "worst-case performance of ",
                    "style": "Plain"
                  },
                  {
                    "text": "O",
                    "style": "Emphasis"
                  },
                  {
                    "text": "(",
                    "style": "Plain"
                  },
                  {
                    "text": "n",
                    "style": "Emphasis"
                  },
                  {
                    "text": "). If you don't need the order of elements",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to be preserved, use ",
                    "style": "Plain"
                  },
                  {
                    "text": "swap_remove",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.swap_remove"
                  },
                  {
                    "text": " instead. If you'd like to remove",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
