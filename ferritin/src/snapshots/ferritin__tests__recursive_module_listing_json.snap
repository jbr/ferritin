                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "hash_builder",
                    "style": "InlineCode"
                  },
                  {
                    "text": " passed should implement the ",
                    "style": "Plain"
                  },
                  {
                    "text": "BuildHasher",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/hash/index.html?search=core%3A%3Ahash%3A%3ABuildHasher"
                  },
                  {
                    "text": " trait for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the ",
                    "style": "Plain"
                  },
                  {
                    "text": "HashSet",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to be useful, see its documentation for details.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::alloc::Global;\nuse std::collections::HashSet;\nuse std::hash::RandomState;\n\nlet s = RandomState::new();\nlet set: HashSet<i32> = HashSet::with_capacity_and_hasher_in(10, s, Global);"
