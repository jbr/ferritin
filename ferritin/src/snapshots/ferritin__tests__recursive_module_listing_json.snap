      {
        "path": "Vec::resize_with",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.resize_with",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Resizes the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in-place so that ",
                    "style": "Plain"
                  },
                  {
                    "text": "len",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "new_len",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If ",
                    "style": "Plain"
                  },
                  {
                    "text": "new_len",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is greater than ",
                    "style": "Plain"
                  },
                  {
                    "text": "len",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is extended by the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "difference, with each additional slot filled with the result of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "calling the closure ",
                    "style": "Plain"
                  },
                  {
                    "text": "f",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The return values from ",
                    "style": "Plain"
                  },
                  {
                    "text": "f",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will end up",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " in the order they have been generated.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If ",
                    "style": "Plain"
                  },
                  {
                    "text": "new_len",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is less than ",
                    "style": "Plain"
                  },
                  {
                    "text": "len",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is simply truncated.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This method uses a closure to create new values on every push. If",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "you'd rather ",
                    "style": "Plain"
                  },
                  {
                    "text": "Clone",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/clone/index.html?search=core%3A%3Aclone%3A%3AClone"
                  },
                  {
                    "text": " a given value, use ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec::resize",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.resize"
                  },
                  {
                    "text": ". If you",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "want to use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "Default",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/default/index.html?search=core%3A%3Adefault%3A%3ADefault"
                  },
                  {
                    "text": " trait to generate values, you can",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "pass ",
                    "style": "Plain"
                  },
                  {
                    "text": "Default::default",
                    "style": "InlineCode",
                    "url": "https://docs.rs/Default/latest/Default/index.html?search=Default%3A%3Adefault"
                  },
                  {
                    "text": " as the second argument.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if the new capacity exceeds ",
                    "style": "Plain"
                  },
                  {
                    "text": "isize::MAX",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
