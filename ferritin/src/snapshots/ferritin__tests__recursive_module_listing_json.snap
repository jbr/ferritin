                "code": "let mut vec = vec!['a', 'b', 'c'];\nvec.insert(1, 'd');\nassert_eq!(vec, ['a', 'd', 'b', 'c']);\nvec.insert(4, 'e');\nassert_eq!(vec, ['a', 'd', 'b', 'c', 'e']);"
