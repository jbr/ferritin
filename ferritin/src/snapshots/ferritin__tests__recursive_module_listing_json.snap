                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This does not preserve ordering of the remaining elements, but is ",
                    "style": "Plain"
                  },
                  {
                    "text": "O",
                    "style": "Emphasis"
                  },
                  {
                    "text": "(1).",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "If you need to preserve the element order, use ",
                    "style": "Plain"
                  },
                  {
                    "text": "remove",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.remove"
