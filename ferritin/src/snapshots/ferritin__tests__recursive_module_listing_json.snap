                  },
                  {
                    "text": "):",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "fn takes_str(s: &str) { }\n\nlet s = String::from(\"Hello\");\n\ntakes_str(&s);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This will create a ",
