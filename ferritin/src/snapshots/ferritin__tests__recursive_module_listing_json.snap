                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If ",
                            "style": "Plain"
                          },
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is not a zero-sized type and the capacity is nonzero, ",
                            "style": "Plain"
                          },
                          {
                            "text": "ptr",
                            "style": "InlineCode"
                          },
                          {
                            "text": " must have",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "been allocated using the global allocator, such as via the ",
                            "style": "Plain"
                          },
                          {
                            "text": "alloc::alloc",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/alloc/alloc/fn.alloc.html"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "function. If ",
                            "style": "Plain"
                          },
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": " is a zero-sized type or the capacity is zero, ",
                            "style": "Plain"
                          },
                          {
                            "text": "ptr",
                            "style": "InlineCode"
                          },
                          {
                            "text": " need",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "only be non-null and aligned.",
                            "style": "Plain"
                          }
                        ]
