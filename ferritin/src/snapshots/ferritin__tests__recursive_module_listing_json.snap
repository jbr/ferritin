                  {
                    "text": " into ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", leaving ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
