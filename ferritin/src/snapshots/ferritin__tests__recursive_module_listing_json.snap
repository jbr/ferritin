                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_recycle, transmutability)]\nlet a: Vec<u8> = vec![0; 100];\nlet capacity = a.capacity();\nlet addr = a.as_ptr().addr();\nlet b: Vec<i8> = a.recycle();\nassert_eq!(b.len(), 0);\nassert_eq!(b.capacity(), capacity);\nassert_eq!(b.as_ptr().addr(), addr);"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "Recyclable",
                    "style": "InlineCode"
                  },
                  {
                    "text": " bound prevents this method from being called when ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
                  {
                    "text": "U",
                    "style": "InlineCode"
                  },
                  {
                    "text": " have different sizes; e.g.:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_recycle, transmutability)]\nlet vec: Vec<[u8; 2]> = Vec::new();\nlet _: Vec<[u8; 1]> = vec.recycle();"
              },
              {
                "type": "paragraph",
                "spans": [
