              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec = vec![10, 20, 21, 30, 20];\n\nvec.dedup_by_key(|i| *i / 10);\n\nassert_eq!(vec, [10, 20, 30, 20]);"
