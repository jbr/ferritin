              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::HashSet;\nlet mut set = HashSet::new();\nset.insert(\"a\");\nset.insert(\"b\");\n\n// Will print in an arbitrary order.\nfor x in set.iter() {\n    println!(\"{x}\");\n}"
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Performance",
