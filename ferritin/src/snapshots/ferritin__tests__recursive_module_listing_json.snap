                  },
                  {
                    "text": "via ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T, A>",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Other allocation sources are allowed if the invariants are",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "upheld.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Violating these may cause problems like corrupting the allocator's",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "internal data structures. For example it is ",
                    "style": "Plain"
                  },
                  {
                    "text": "not",
                    "style": "Strong"
                  },
                  {
                    "text": " safe",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to build a ",
                    "style": "Plain"
                  },
