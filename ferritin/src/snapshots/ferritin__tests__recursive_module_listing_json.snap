      {
        "path": "link_resolution_tests::HashSet::with_hasher_in",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/std/collections/hash/set/struct.HashSet.html#method.with_hasher_in",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Creates a new empty hash set which will use the given hasher to hash",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "keys and will allocate memory using the provided allocator.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The hash set is also created with the default initial capacity.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Warning: ",
                    "style": "Plain"
                  },
                  {
                    "text": "hasher",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is normally randomly generated, and",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is designed to allow ",
                    "style": "Plain"
                  },
                  {
                    "text": "HashSet",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s to be resistant to attacks that",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "cause many collisions and very poor performance. Setting it",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "manually using this function can expose a DoS attack vector.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The ",
                    "style": "Plain"
                  },
                  {
                    "text": "hash_builder",
                    "style": "InlineCode"
                  },
                  {
                    "text": " passed should implement the ",
                    "style": "Plain"
                  },
                  {
                    "text": "BuildHasher",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/hash/index.html?search=core%3A%3Ahash%3A%3ABuildHasher"
                  },
                  {
                    "text": " trait for",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the ",
                    "style": "Plain"
                  },
                  {
                    "text": "HashSet",
                    "style": "InlineCode"
                  },
                  {
                    "text": " to be useful, see its documentation for details.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::alloc::Global;\nuse std::collections::HashSet;\nuse std::hash::RandomState;\n\nlet s = RandomState::new();\nlet set: HashSet<i32> = HashSet::with_hasher_in(s, Global);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::HashSet::with_capacity_and_hasher_in",
