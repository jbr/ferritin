      {
        "path": "link_resolution_tests::Tree::range",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/BTreeMap/fn.range.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Constructs a double-ended iterator over a sub-range of elements in the map.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The simplest way is to use the range syntax ",
                    "style": "Plain"
                  },
                  {
                    "text": "min..max",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", thus ",
                    "style": "Plain"
                  },
                  {
                    "text": "range(min..max)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "yield elements from min (inclusive) to max (exclusive).",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The range may also be entered as ",
                    "style": "Plain"
                  },
                  {
                    "text": "(Bound<T>, Bound<T>)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", so for example",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "range((Excluded(4), Included(10)))",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will yield a left-exclusive, right-inclusive",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "range from 4 to 10.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine",
            "truncated": true
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::range_mut",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/BTreeMap/fn.range_mut.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Constructs a mutable double-ended iterator over a sub-range of elements in the map.",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The simplest way is to use the range syntax ",
                    "style": "Plain"
                  },
                  {
                    "text": "min..max",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", thus ",
                    "style": "Plain"
                  },
                  {
                    "text": "range(min..max)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "yield elements from min (inclusive) to max (exclusive).",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The range may also be entered as ",
                    "style": "Plain"
                  },
                  {
                    "text": "(Bound<T>, Bound<T>)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", so for example",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "range((Excluded(4), Included(10)))",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will yield a left-exclusive, right-inclusive",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "range from 4 to 10.",
                    "style": "Plain"
                  }
                ]
              }
            ],
            "level": "SingleLine",
            "truncated": true
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::entry",
        "kind": "function",
        "url": "https://doc.rust-lang.org/nightly/alloc/collections/btree/map/BTreeMap/fn.entry.html",
