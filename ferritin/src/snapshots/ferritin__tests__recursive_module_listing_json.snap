                "type": "paragraph",
                "spans": [
                  {
                    "text": "Basic usage:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_peek_mut)]\nlet mut vec = Vec::new();\nassert!(vec.peek_mut().is_none());\n\nvec.push(1);\nvec.push(5);\nvec.push(2);\nassert_eq!(vec.last(), Some(&2));\nif let Some(mut val) = vec.peek_mut() {\n    *val = 0;\n}\nassert_eq!(vec.last(), Some(&0));"
