      {
        "path": "link_resolution_tests::nested::Str::try_reserve",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.try_reserve",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tries to reserve capacity for at least ",
                    "style": "Plain"
                  },
                  {
                    "text": "additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " bytes more than the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "current length. The allocator may reserve more space to speculatively",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "avoid frequent allocations. After calling ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", capacity will be",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "greater than or equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " if it returns",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok(())",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". Does nothing if capacity is already sufficient. This method",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "preserves the contents even if an error occurs.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Errors",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the capacity overflows, or the allocator reports a failure, then an error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is returned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::TryReserveError;\n\nfn process_data(data: &str) -> Result<String, TryReserveError> {\n    let mut output = String::new();\n\n    // Pre-reserve the memory, exiting if we can't\n    output.try_reserve(data.len())?;\n\n    // Now we know this can't OOM in the middle of our complex work\n    output.push_str(data);\n\n    Ok(output)\n}"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::nested::Str::try_reserve_exact",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.try_reserve_exact",
        "docs": [
