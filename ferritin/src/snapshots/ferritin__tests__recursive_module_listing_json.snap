      {
        "path": "link_resolution_tests::HashSet::reserve",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/std/collections/hash/set/struct.HashSet.html#method.reserve",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Reserves capacity for at least ",
                    "style": "Plain"
                  },
                  {
                    "text": "additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " more elements to be inserted",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the ",
                    "style": "Plain"
                  },
                  {
                    "text": "HashSet",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The collection may reserve more space to speculatively",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "avoid frequent reallocations. After calling ",
                    "style": "Plain"
                  },
                  {
                    "text": "reserve",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity will be greater than or equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Does nothing if capacity is already sufficient.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if the new allocation size overflows ",
                    "style": "Plain"
                  },
                  {
                    "text": "usize",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::HashSet;\nlet mut set: HashSet<i32> = HashSet::new();\nset.reserve(10);\nassert!(set.capacity() >= 10);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::HashSet::try_reserve",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/std/collections/hash/set/struct.HashSet.html#method.try_reserve",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Tries to reserve capacity for at least ",
                    "style": "Plain"
                  },
                  {
                    "text": "additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " more elements to be inserted",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "in the ",
                    "style": "Plain"
                  },
                  {
                    "text": "HashSet",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". The collection may reserve more space to speculatively",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "avoid frequent reallocations. After calling ",
                    "style": "Plain"
                  },
                  {
                    "text": "try_reserve",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity will be greater than or equal to ",
                    "style": "Plain"
                  },
                  {
                    "text": "self.len() + additional",
                    "style": "InlineCode"
                  },
                  {
                    "text": " if",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "it returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "Ok(())",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Does nothing if capacity is already sufficient.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Errors",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the capacity overflows, or the allocator reports a failure, then an error",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is returned.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::HashSet;\nlet mut set: HashSet<i32> = HashSet::new();\nset.try_reserve(10).expect(\"why is the test harness OOMing on a handful of bytes?\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::HashSet::shrink_to_fit",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/std/collections/hash/set/struct.HashSet.html#method.shrink_to_fit",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Shrinks the capacity of the set as much as possible. It will drop",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "down as much as possible while maintaining the internal rules",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and possibly leaving some space in accordance with the resize policy.",
                    "style": "Plain"
                  }
                ]
              },
