                          },
                          {
                            "text": "MaybeUninit",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/mem/maybe_uninit/index.html?search=core%3A%3Amem%3A%3Amaybe%5Funinit%3A%3AMaybeUninit"
