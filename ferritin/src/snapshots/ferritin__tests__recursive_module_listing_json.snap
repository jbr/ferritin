                    "style": "InlineCode"
                  },
                  {
                    "text": " array with length ",
                    "style": "Plain"
                  },
                  {
                    "text": "size_t",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "It's also not safe to build one from a ",
