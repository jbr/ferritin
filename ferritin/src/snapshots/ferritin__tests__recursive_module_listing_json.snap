              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Removes a key from the map, returning the stored key and value if the key",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "was previously in the map.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The key may be any borrowed form of the map's key type, but the ordering",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "on the borrowed form ",
                    "style": "Plain"
                  },
                  {
                    "text": "must",
                    "style": "Emphasis"
                  },
                  {
                    "text": " match the ordering on the key type.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::BTreeMap;\n\nlet mut map = BTreeMap::new();\nmap.insert(1, \"a\");\nassert_eq!(map.remove_entry(&1), Some((1, \"a\")));\nassert_eq!(map.remove_entry(&1), None);"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::retain",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.retain",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Retains only the elements specified by the predicate.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "In other words, remove all pairs ",
                    "style": "Plain"
                  },
                  {
                    "text": "(k, v)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " for which ",
                    "style": "Plain"
                  },
                  {
                    "text": "f(&k, &mut v)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " returns ",
                    "style": "Plain"
                  },
                  {
                    "text": "false",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "The elements are visited in ascending key order.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::BTreeMap;\n\nlet mut map: BTreeMap<i32, i32> = (0..8).map(|x| (x, x*10)).collect();\n// Keep only the elements with even-numbered keys.\nmap.retain(|&k, _| k % 2 == 0);\nassert!(map.into_iter().eq(vec![(0, 0), (2, 20), (4, 40), (6, 60)]));"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::append",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.append",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Moves all elements from ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": " into ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", leaving ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": " empty.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If a key from ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is already present in ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", the respective",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "value from ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
                    "style": "InlineCode"
                  },
                  {
                    "text": " will be overwritten with the respective value from ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Similar to ",
                    "style": "Plain"
                  },
                  {
                    "text": "insert",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.insert"
                  },
                  {
                    "text": ", though, the key is not overwritten,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "which matters for types that can be ",
                    "style": "Plain"
                  },
                  {
                    "text": "==",
                    "style": "InlineCode"
                  },
                  {
                    "text": " without being identical.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::BTreeMap;\n\nlet mut a = BTreeMap::new();\na.insert(1, \"a\");\na.insert(2, \"b\");\na.insert(3, \"c\"); // Note: Key (3) also present in b.\n\nlet mut b = BTreeMap::new();\nb.insert(3, \"d\"); // Note: Key (3) also present in a.\nb.insert(4, \"e\");\nb.insert(5, \"f\");\n\na.append(&mut b);\n\nassert_eq!(a.len(), 5);\nassert_eq!(b.len(), 0);\n\nassert_eq!(a[&1], \"a\");\nassert_eq!(a[&2], \"b\");\nassert_eq!(a[&3], \"d\"); // Note: \"c\" has been overwritten.\nassert_eq!(a[&4], \"e\");\nassert_eq!(a[&5], \"f\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::Tree::merge",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/collections/btree/map/struct.BTreeMap.html#method.merge",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Moves all elements from ",
                    "style": "Plain"
                  },
                  {
                    "text": "other",
                    "style": "InlineCode"
                  },
                  {
                    "text": " into ",
                    "style": "Plain"
                  },
                  {
                    "text": "self",
