      {
        "path": "Vec::split_off",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.split_off",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Splits the collection into two at the given index.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Returns a newly allocated vector containing the elements in the range",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "[at, len)",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". After the call, the original vector will be left containing",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the elements ",
                    "style": "Plain"
                  },
                  {
                    "text": "[0, at)",
                    "style": "InlineCode"
                  },
                  {
                    "text": " with its previous capacity unchanged.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "list",
                "items": [
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If you want to take ownership of the entire contents and capacity of",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "the vector, see ",
                            "style": "Plain"
                          },
                          {
                            "text": "mem::take",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/mem/index.html?search=core%3A%3Amem%3A%3Atake"
                          },
                          {
                            "text": " or ",
                            "style": "Plain"
                          },
                          {
                            "text": "mem::replace",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/core/mem/index.html?search=core%3A%3Amem%3A%3Areplace"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If you don't need the returned vector at all, see ",
                            "style": "Plain"
                          },
                          {
                            "text": "Vec::truncate",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.truncate"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "If you want to take ownership of an arbitrary subslice, or you don't",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "necessarily want to store the removed items in a vector, see ",
                            "style": "Plain"
                          },
                          {
                            "text": "Vec::drain",
                            "style": "InlineCode",
                            "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.drain"
                          },
                          {
                            "text": ".",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if ",
                    "style": "Plain"
                  },
                  {
                    "text": "at > len",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut vec = vec!['a', 'b', 'c'];\nlet vec2 = vec.split_off(1);\nassert_eq!(vec, ['a']);\nassert_eq!(vec2, ['b', 'c']);"
              }
            ],
            "level": "SingleLine"
          }
        ]
