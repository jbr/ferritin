        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Converts this ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " into a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Box",
                    "style": "Plain",
                    "url": "http://docs.rust-lang.org/nightly/alloc/boxed/struct.Box.html"
                  },
                  {
                    "text": "<",
                    "style": "Plain"
                  },
                  {
                    "text": "str",
                    "style": "Plain",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Astr"
                  },
                  {
                    "text": ">",
                    "style": "Plain"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Before doing the conversion, this method discards excess capacity like ",
                    "style": "Plain"
