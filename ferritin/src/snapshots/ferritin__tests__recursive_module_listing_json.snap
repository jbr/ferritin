                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": " needs to have the same alignment as what ",
                            "style": "Plain"
                          },
                          {
                            "text": "ptr",
                            "style": "InlineCode"
                          },
                          {
                            "text": " was allocated with,",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "if the pointer is required to be allocated.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "(",
                            "style": "Plain"
                          },
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": " having a less strict alignment is not sufficient, the alignment really",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "needs to be equal to satisfy the ",
                            "style": "Plain"
                          },
                          {
                            "text": "dealloc",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/alloc/alloc/GlobalAlloc/index.html?search=alloc%3A%3Aalloc%3A%3AGlobalAlloc%3A%3Adealloc"
                          },
                          {
                            "text": " requirement that memory must be",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "allocated and deallocated with the same layout.)",
                            "style": "Plain"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "content": [
                      {
                        "type": "paragraph",
                        "spans": [
                          {
                            "text": "The size of ",
                            "style": "Plain"
                          },
                          {
                            "text": "T",
                            "style": "InlineCode"
                          },
                          {
                            "text": " times the ",
                            "style": "Plain"
                          },
                          {
                            "text": "capacity",
                            "style": "InlineCode"
                          },
                          {
                            "text": " (i.e. the allocated size in bytes), if",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "nonzero, needs to be the same size as the pointer was allocated with.",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "(Because similar to alignment, ",
                            "style": "Plain"
                          },
                          {
                            "text": "dealloc",
                            "style": "InlineCode",
                            "url": "https://doc.rust-lang.org/nightly/alloc/alloc/GlobalAlloc/index.html?search=alloc%3A%3Aalloc%3A%3AGlobalAlloc%3A%3Adealloc"
                          },
                          {
                            "text": " must be called with the same",
                            "style": "Plain"
                          },
                          {
                            "text": " ",
                            "style": "Plain"
                          },
                          {
                            "text": "layout ",
                            "style": "Plain"
                          },
                          {
                            "text": "size",
                            "style": "InlineCode"
                          },
                          {
                            "text": ".)",
                            "style": "Plain"
                          }
                        ]
