              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "use std::collections::HashSet;\nuse std::hash::{BuildHasherDefault, DefaultHasher};\nuse std::sync::Mutex;\n\nconst EMPTY_SET: HashSet<String, BuildHasherDefault<DefaultHasher>> =\n    HashSet::with_hasher(BuildHasherDefault::new());\nstatic SET: Mutex<HashSet<String, BuildHasherDefault<DefaultHasher>>> =\n    Mutex::new(HashSet::with_hasher(BuildHasherDefault::new()));"
              }
            ],
            "level": "SingleLine"
          }
