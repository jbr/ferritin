      {
        "path": "prefix_tests",
        "kind": "module",
        "url": "https://docs.rs/fixture-crate/0.1.0/fixture-crate/prefix_tests/index.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Edge cases for path-prefix resolution in use-item sources and intra-doc links.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Rustdoc emits ",
                    "style": "Plain"
                  },
                  {
                    "text": "Use::source",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and intra-doc link targets verbatim from the Rust",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "source: ",
                    "style": "Plain"
                  },
                  {
                    "text": "crate::",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", ",
                    "style": "Plain"
                  },
                  {
                    "text": "self::",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", and ",
                    "style": "Plain"
                  },
                  {
                    "text": "super::",
                    "style": "InlineCode"
                  },
                  {
                    "text": " prefixes are kept as-written. When",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the corresponding id resolves to an item in the ",
                    "style": "Plain"
                  },
                  {
                    "text": "local",
                    "style": "Emphasis"
                  },
                  {
                    "text": " crate's index (as is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the case for all the ",
                    "style": "Plain"
                  },
                  {
                    "text": "pub use",
                    "style": "InlineCode"
                  },
                  {
                    "text": "s below), the iterator never needs to fall back",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "to resolving the source string. The cross-crate counterparts live in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "tests/test-workspace/crate-b",
                    "style": "InlineCode"
                  },
                  {
                    "text": " — those actually exercise the fallback path.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The intra-doc links in this module's docs and its members' docs exercise the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "same prefix handling on the ",
                    "style": "Plain"
                  },
                  {
                    "text": "extract_link_target",
                    "style": "InlineCode"
                  },
                  {
                    "text": " side (rendered in",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "snapshots).",
                    "style": "Plain"
                  }
                ]
