              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The vector will be able to hold at least ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "InlineCode"
                  },
                  {
                    "text": " elements without",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "reallocating. This method is allowed to allocate for more elements than",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "InlineCode"
                  },
                  {
                    "text": ". If ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is zero, the vector will not allocate.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It is important to note that although the returned vector has the",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "minimum ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "Emphasis"
                  },
                  {
                    "text": " specified, the vector will have a zero ",
                    "style": "Plain"
                  },
                  {
                    "text": "length",
                    "style": "Emphasis"
                  },
                  {
                    "text": ". For",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "an explanation of the difference between length and capacity, see",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Capacity and reallocation",
                    "style": "Emphasis",
                    "url": "#capacity-and-reallocation"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If it is important to know the exact allocated capacity of a ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec",
                    "style": "InlineCode"
                  },
                  {
                    "text": ",",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "always use the ",
                    "style": "Plain"
                  },
                  {
                    "text": "capacity",
                    "style": "InlineCode",
                    "url": "http://docs.rust-lang.org/nightly/alloc/vec/struct.Vec.html#method.capacity"
                  },
                  {
                    "text": " method after construction.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "For ",
                    "style": "Plain"
                  },
                  {
                    "text": "Vec<T, A>",
                    "style": "InlineCode"
                  },
                  {
                    "text": " where ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " is a zero-sized type, there will be no allocation",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "and the capacity will always be ",
                    "style": "Plain"
                  },
                  {
                    "text": "usize::MAX",
                    "style": "InlineCode"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if the new capacity exceeds ",
                    "style": "Plain"
                  },
                  {
                    "text": "isize::MAX",
                    "style": "InlineCode"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "bytes",
                    "style": "Emphasis"
                  },
                  {
                    "text": ".",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(allocator_api)]\n\nuse std::alloc::System;\n\nlet mut vec = Vec::with_capacity_in(10, System);\n\n// The vector contains no items, even though it has capacity for more\nassert_eq!(vec.len(), 0);\nassert!(vec.capacity() >= 10);\n\n// These are all done without reallocating...\nfor i in 0..10 {\n    vec.push(i);\n}\nassert_eq!(vec.len(), 10);\nassert!(vec.capacity() >= 10);\n\n// ...but this may make the vector reallocate\nvec.push(11);\nassert_eq!(vec.len(), 11);\nassert!(vec.capacity() >= 11);\n\n// A vector of a zero-sized type will always over-allocate, since no\n// allocation is necessary\nlet vec_units = Vec::<(), System>::with_capacity_in(10, System);\nassert_eq!(vec_units.capacity(), usize::MAX);"
              }
            ],
            "level": "SingleLine"
          }
        ]
