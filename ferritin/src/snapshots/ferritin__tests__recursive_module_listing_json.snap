      {
        "path": "TestEnum",
        "kind": "enum",
        "url": "https://docs.rs/fixture-crate/0.1.0/fixture-crate/submodule/enum.TestEnum.html",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "An enum for testing",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "This is like ",
                    "style": "Plain"
                  },
                  {
                    "text": "crate::GenericEnum",
                    "style": "InlineCode",
                    "url": "https://docs.rs/fixture-crate/0.1.0/fixture-crate/enum.GenericEnum.html"
                  },
                  {
