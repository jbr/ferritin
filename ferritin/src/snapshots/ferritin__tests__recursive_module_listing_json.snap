                  },
                  {
                    "text": "this method is not yet callable when ",
                    "style": "Plain"
                  },
                  {
                    "text": "T",
                    "style": "InlineCode"
                  },
                  {
                    "text": " or ",
                    "style": "Plain"
                  },
                  {
                    "text": "U",
                    "style": "InlineCode"
                  },
                  {
                    "text": " are slices, trait objects,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "or other exotic types; e.g.:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_recycle, transmutability)]\nlet mut storage: Vec<&[&str]> = Vec::new();\n\nfor input in inputs {\n    let mut buffer: Vec<&str> = storage.recycle();\n    buffer.extend(input.split(\" \"));\n    process(&buffer);\n    storage = buffer.recycle();\n}"
              }
