                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", as the rest of",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the standard library assumes that ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
