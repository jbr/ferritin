      {
        "path": "link_resolution_tests::nested::Str::drain",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.drain",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Removes the specified range from the string in bulk, returning all",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "removed characters as an iterator.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "The returned iterator keeps a mutable borrow on the string to optimize",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "its implementation.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Panics",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Panics if the range has ",
                    "style": "Plain"
                  },
                  {
                    "text": "start_bound > end_bound",
                    "style": "InlineCode"
                  },
                  {
                    "text": ", or, if the range is",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "bounded on either end and does not lie on a ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Achar"
                  },
                  {
                    "text": " boundary.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Leaking",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "If the returned iterator goes out of scope without being dropped (due to",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "core::mem::forget",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/mem/index.html?search=core%3A%3Amem%3A%3Aforget"
                  },
                  {
                    "text": ", for example), the string may still contain a copy",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "of any drained characters, or may have lost characters arbitrarily,",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "including characters outside the range.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "let mut s = String::from(\"α is alpha, β is beta\");\nlet beta_offset = s.find('β').unwrap_or(s.len());\n\n// Remove the range up until the β from the string\nlet t: String = s.drain(..beta_offset).collect();\nassert_eq!(t, \"α is alpha, \");\nassert_eq!(s, \"β is beta\");\n\n// A full range clears the string, like `clear()` does\ns.drain(..);\nassert_eq!(s, \"\");"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::nested::Str::into_chars",
        "kind": "function",
        "url": "http://docs.rust-lang.org/nightly/alloc/string/struct.String.html#method.into_chars",
        "docs": [
          {
            "type": "truncatedBlock",
            "nodes": [
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Converts a ",
                    "style": "Plain"
                  },
                  {
                    "text": "String",
                    "style": "InlineCode"
                  },
                  {
                    "text": " into an iterator over the ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Achar"
                  },
                  {
                    "text": "s of the string.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "As a string consists of valid UTF-8, we can iterate through a string",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "by ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Achar"
                  },
                  {
                    "text": ". This method returns such an iterator.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "It's important to remember that ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Achar"
                  },
                  {
                    "text": " represents a Unicode Scalar",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "Value, and might not match your idea of what a 'character' is. Iteration",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "over grapheme clusters may be what you actually want. That functionality",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "is not provided by Rust's standard library, check crates.io instead.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "heading",
                "level": "Title",
                "spans": [
                  {
                    "text": "Examples",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Basic usage:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(string_into_chars)]\n\nlet word = String::from(\"goodbye\");\n\nlet mut chars = word.into_chars();\n\nassert_eq!(Some('g'), chars.next());\nassert_eq!(Some('o'), chars.next());\nassert_eq!(Some('o'), chars.next());\nassert_eq!(Some('d'), chars.next());\nassert_eq!(Some('b'), chars.next());\nassert_eq!(Some('y'), chars.next());\nassert_eq!(Some('e'), chars.next());\n\nassert_eq!(None, chars.next());"
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "Remember, ",
                    "style": "Plain"
                  },
                  {
                    "text": "char",
                    "style": "InlineCode",
                    "url": "https://doc.rust-lang.org/nightly/core/index.html?search=core%3A%3Achar"
                  },
                  {
                    "text": "s might not match your intuition about characters:",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(string_into_chars)]\n\nlet y = String::from(\"y̆\");\n\nlet mut chars = y.into_chars();\n\nassert_eq!(Some('y'), chars.next()); // not 'y̆'\nassert_eq!(Some('\\u{0306}'), chars.next());\n\nassert_eq!(None, chars.next());"
              }
            ],
            "level": "SingleLine"
          }
        ]
      },
      {
        "path": "link_resolution_tests::nested::Str::replace_range",
