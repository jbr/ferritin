              {
                "type": "codeBlock",
                "lang": "rust",
                "code": "#![feature(vec_recycle, transmutability)]\nlet vec: Vec<[u16; 0]> = Vec::new();\nlet _: Vec<[u8; 0]> = vec.recycle();"
              },
              {
                "type": "paragraph",
                "spans": [
