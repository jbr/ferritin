                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "logically uninitialized, contiguous elements.",
                    "style": "Plain"
                  }
                ]
              },
              {
                "type": "paragraph",
                "spans": [
                  {
                    "text": "A vector containing the elements ",
                    "style": "Plain"
                  },
                  {
                    "text": "'a'",
                    "style": "InlineCode"
                  },
                  {
                    "text": " and ",
                    "style": "Plain"
                  },
