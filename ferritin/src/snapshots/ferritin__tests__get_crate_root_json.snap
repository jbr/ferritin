                    "style": "InlineCode"
                  },
                  {
                    "text": " prefixes are kept as-written. When",
                    "style": "Plain"
                  },
                  {
                    "text": " ",
                    "style": "Plain"
                  },
                  {
                    "text": "the corresponding id resolves to an item in the ",
                    "style": "Plain"
                  },
