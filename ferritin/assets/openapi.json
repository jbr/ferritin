        ]
      },
      "JsonFunction": {
        "description": "A free function body. Mirrors [`JsonMethod`] minus the assoc-item\n`kind`/`visibility` and per-item `docs` — params live inside `signature`, so\na function and a method serialize the same way.",
        "type": "object",
        "properties": {
          "isAsync": {
            "type": "boolean"
          },
          "isConst": {
            "type": "boolean"
          },
          "isUnsafe": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "returns": {
            "description": "Return-type spans (functions with an explicit output).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonSpan"
            }
          },
          "signature": {
            "description": "Full display signature, the same spans the terminal renders.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonSpan"
            }
          }
        },
        "required": [
          "name",
          "signature"
        ]
      },
