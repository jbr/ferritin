          },
          "isWorkspace": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "usedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "JsonEnum": {
        "type": "object",
        "properties": {
          "generics": {
