{
  "openapi": "3.0.3",
  "info": {
    "title": "ferritin",
    "version": "0.13.0",
    "description": "Structured Rust documentation as JSON (the semantic IR)."
  },
  "servers": [
    {
      "url": "/api",
      "description": "JSON API mount point."
    }
  ],
  "paths": {
    "/crates/{crate_name}": {
      "get": {
        "summary": "Structured documentation model for an item path.",
        "parameters": [
          {
            "name": "crate_name",
            "in": "path",
            "required": true,
            "description": "Item path, `::`-joined (e.g. `serde::Deserialize`).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The resolved item model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonItem"
                }
              }
            }
          },
          "404": {
            "description": "No item resolved; \"did you mean\" suggestions returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonNotFound"
                }
              }
            }
          }
        }
      }
    },
    "/search/{crate_name}": {
      "get": {
        "summary": "Search for items within a single crate.",
        "parameters": [
          {
            "name": "crate_name",
            "in": "path",
            "required": true,
            "description": "Crate to search (optionally `name@version`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonSearch"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HeadingLevel": {
        "description": "Heading level for semantic structure",
        "type": "string",
        "enum": [
          "Title",
          "Section"
        ]
      },
      "JsonAssocItem": {
        "description": "A directly-queried trait associated item (type or const). Its own kind is\nserialized as `assocKind` to avoid colliding with the `JsonBody` `kind` tag.",
        "type": "object",
        "properties": {
          "assocKind": {
            "description": "`\"type\"` or `\"const\"`.",
            "type": "string"
          },
          "hasDefault": {
            "description": "For an assoc type: whether it has a default; for an assoc const: whether\nit has a value.",
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "signature": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonSpan"
            }
          }
        },
        "required": [
          "assocKind",
          "name",
          "signature"
        ]
      },
      "JsonBody": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "struct"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonStruct"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "enum"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonEnum"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "trait"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonTrait"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "module"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonModule"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "function"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonFunction"
