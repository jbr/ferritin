            }
          },
          "blanket": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonSpan"
            }
          },
          "docs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonNode"
            }
          },
          "forType": {
            "description": "The implementing type, bounds merged inline (`BufReader<R: Read>`).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonSpan"
            }
          },
          "isSynthetic": {
            "type": "boolean"
          },
          "isUnsafe": {
            "type": "boolean"
          },
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonMethod"
            }
          },
          "providedMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "typeName": {
            "type": "string",
            "nullable": true
          },
          "typeUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "forType"
