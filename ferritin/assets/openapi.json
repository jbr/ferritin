      "JsonNode": {
        "description": "JSON mirror of [`DocumentNode`] — a faithful serialization of the\npresentation IR, used for the header, docs, source, opaque methods, and\nnot-yet-modeled bodies.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "spans": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonSpan"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "paragraph"
                ]
              }
            },
            "required": [
              "type",
              "spans"
            ]
          },
          {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonMetadataField"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "metadata"
                ]
              }
            },
            "required": [
              "type",
              "fields"
            ]
          },
          {
            "type": "object",
            "properties": {
              "level": {
                "$ref": "#/components/schemas/HeadingLevel"
              },
              "spans": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonSpan"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "heading"
                ]
              }
            },
            "required": [
              "type",
              "level",
              "spans"
            ]
          },
          {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonNode"
                }
              },
              "title": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonSpan"
                },
                "nullable": true
              },
              "type": {
                "type": "string",
                "enum": [
                  "section"
                ]
              }
            },
            "required": [
              "type",
              "nodes"
            ]
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonListItem"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "list"
                ]
              }
            },
            "required": [
              "type",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "attrs": {
                "description": "Doctest attributes worth surfacing to a reader — `should_panic` and\n`compile_fail`, positive assertions that the example is a\ncounterexample. Omitted when empty.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lang": {
                "type": "string",
                "nullable": true
              },
              "spans": {
                "description": "Syntax-highlighted spans that tile the source: concatenating their\n`text` reconstructs the raw code (there is no separate `code` field).\nA span without a `class` is unstyled text (punctuation, plain\nidentifiers, or a block whose language has no grammar).",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonCodeSpan"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "codeBlock"
                ]
              }
            },
            "required": [
              "type",
              "spans"
            ]
          },
          {
            "type": "object",
            "properties": {
              "spans": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonSpan"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "generatedCode"
                ]
              }
            },
            "required": [
              "type",
              "spans"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "horizontalRule"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonNode"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "blockQuote"
                ]
              }
            },
            "required": [
              "type",
              "nodes"
            ]
          },
          {
            "type": "object",
            "properties": {
              "header": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonTableCell"
                },
                "nullable": true
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JsonTableCell"
                  }
                }
              },
              "type": {
                "type": "string",
                "enum": [
