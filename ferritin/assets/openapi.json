              "nodes"
            ]
          }
        ]
      },
      "JsonCodeSpan": {
        "description": "A span in a syntax-highlighted code block: a slice of source and its lexical\nclass (`keyword`, `type`, `string`, …). Distinct from [`JsonSpan`], whose\n`style` is a semantic, navigable [`SpanStyle`]; a code-block class is a purely\nlexical highlight the client colors, with no navigation.",
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "JsonConstant": {
        "description": "A constant body: name, type, and optional value expression.",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonSpan"
            }
          },
          "value": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
