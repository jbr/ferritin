                  "constant"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonConstant"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "static"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonStatic"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "macro"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonMacro"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "union"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonUnion"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "description": "A directly-queried trait associated item (type or const).",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "assocItem"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/JsonAssocItem"
              }
            ],
            "required": [
              "kind"
            ]
          },
          {
            "description": "A kind not yet modeled structurally: its lowered presentation nodes.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "presentation"
                ]
              },
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JsonNode"
                }
              }
            },
            "required": [
